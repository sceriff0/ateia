/*
========================================================================================
    MIRAGE WSI Processing Pipeline - Main Configuration
========================================================================================
    Author: mirage team
    Version: 0.1.0
========================================================================================
*/

/*
========================================================================================
    Plugins
========================================================================================
*/

/*
plugins {
    id 'nf-boost'
}
*/

// Include modular configurations
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

// Pipeline metadata
manifest {
    name            = 'mirage'
    description     = 'WSI processing pipeline (preprocessing, registration, segmentation, quantification, GeoJSON export)'
    author          = 'mirage team'
    version         = '0.1.0'
    nextflowVersion = '>=25.04.0'
    mainScript      = 'main.nf'
}


/*
========================================================================================
    Resource Limit Functions
========================================================================================
*/

/*
========================================================================================
    Pipeline Parameters
========================================================================================
*/

params {
    // Input/output
    input              = null
    outdir             = null

    // Container registry (single source of truth for all module images).
    // Images are published to GHCR by .github/workflows/build-images.yml; see
    // containers/README.md. Override container_registry to point at a mirror,
    // and keep container_tag in sync with the pipeline release (manifest.version).
    container_registry = 'ghcr.io/sceriff0/mirage'
    container_tag      = '0.1.0'

    // Workflow control
    start          = 'preprocessing'  // preprocessing | registration | postprocessing
    stop           = null            // null = run to end; or: preprocessing | registration | postprocessing
    dry_run        = false
    debug_channels = false

    // Cluster options
    slurm_partition = null
    slurm_account   = null
    slurm_qos       = null
    gpu_type        = 'nvidia_h200:1'

    // Preprocessing
    preproc_tile_size         = 1950
    preproc_skip_dapi         = true
    preproc_autotune          = false
    preproc_n_iter            = 100
    preproc_pool_workers      = 3
    preproc_overlap           = 0
    preproc_no_darkfield      = false
    preprocess_qc_scale_factor = 0.25
    skip_preprocess_qc         = false

    // Registration (common)
    registration_method  = 'valis'
    allow_auto_reference = false
    padding              = false
    pad_mode             = 'constant'
    skip_registration_qc = false
    qc_scale_factor      = 0.25
    enable_feature_error = false
    feature_detector     = 'superpoint'
    feature_max_dim      = 1024
    feature_n_features   = 5000

    // Registration (VALIS)
    reg_reference_markers      = ['DAPI', 'FITC']
    memory_mode                = 'medium'
    reg_micro_reg_fraction     = 0.125
    reg_max_image_dim          = 4000
    skip_micro_registration    = true
    reg_parallel_warping       = false
    reg_n_workers              = 8
    reg_use_tiled_registration = true
    reg_tile_size              = 2048
    // JVM heap (GiB) for VALIS/Bio-Formats in REGISTER. null = derive from
    // task.memory at runtime (register.nf). Declared so it is not an
    // "undefined parameter" warning / nf-core lint finding.
    reg_jvm_heap_gb            = null

    // Legacy GPU/CPU pairwise registration params moved to legacy/

    // Segmentation
    seg_method             = 'stardist'   // 'stardist' | 'instantseg' | 'cellsam'
    seg_gpu                = true
    seg_pmin               = 1.0
    seg_pmax               = 99.8
    seg_n_tiles_y          = 16
    seg_n_tiles_x          = 16
    seg_expand_distance    = 10
    segmentation_model_dir = null
    segmentation_model     = 'stardist_full_e200_lr00001_aug1_seed10_es50p0.001_rlr0.5p50'

    // Segmentation (InstanSeg backend; only used when seg_method='instantseg')
    seg_instantseg_model      = 'fluorescence_nuclei_and_cells'
    seg_instantseg_target     = 'all_outputs'   // 'all_outputs' | 'cells' | 'nuclei'
    // Tiled inference via eval_medium_image. tile_size is in pixels at the
    // model's working pixel size; batch_size is the number of tiles pushed
    // through the model per forward pass. Bump batch_size on large GPUs
    // (e.g. 16-32 on H200/H100); keep low on small GPUs to avoid OOM.
    seg_instantseg_tile_size  = 512
    seg_instantseg_batch_size = 16
    // Writable host path for InstanSeg's BioImage.IO model cache. Exported as
    // INSTANSEG_BIOIMAGEIO_PATH so the model is not written into the read-only
    // container image. When null, falls back to a per-task work-dir cache
    // (functional but re-downloads per task).
    instanseg_model_dir    = null

    // Segmentation (CellSAM backend; only used when seg_method='cellsam')
    // CellSAM segments the nuclear (DAPI) channel; the whole-cell mask is
    // derived by expanding nuclei labels with seg_expand_distance (shared with
    // StarDist). bbox_threshold is the precision/recall knob; use_wsi enables
    // CellSAM's native tiling (block_size/overlap) for large images.
    seg_cellsam_bbox_threshold = 0.4
    seg_cellsam_use_wsi        = true
    seg_cellsam_block_size     = 400
    seg_cellsam_overlap        = 56
    // Path to pre-downloaded CellSAM weights for offline/container use. When
    // null, weights are auto-downloaded at runtime (requires a valid
    // DEEPCELL_ACCESS_TOKEN in the task environment).
    cellsam_model_path         = null

    // Quantification (per-compartment signal)
    // When true, SEGMENT's nuclear mask is routed into QUANTIFY alongside the
    // whole-cell mask, emitting Nucleus / Cytoplasm / Cell signal per marker into
    // the GeoJSON (cytoplasm = whole-cell − nucleus). Backward-compatible default off.
    quantify_compartments   = false
    // With quantify_compartments, also emit Median and Sum (integrated density)
    // per compartment in addition to Mean. Heavier (per-cell pixel gather for median).
    expanded_quantification = false

    // Postprocessing QC
    skip_postprocessing_qc = false

    // Final QC report
    skip_final_qc_report   = false

    // Image and pyramid output
    pixel_size          = 0.325
    tilex               = 512
    tiley               = 512
    pyramid_resolutions = 8
    pyramid_scale       = 2
    compression         = 'zstd'

    // Pixie clustering params moved to legacy/

    // Pipeline Control
    cleanup_work = true                // Automatically remove work directory after successful completion
    savedir      = null                // Save directory for archiving results

    // Resource Limits
    max_memory       = '700.GB'
    max_cpus         = 128
    max_time         = '240.h'

    // Tracing (optional)
    enable_trace     = true             // Enable detailed execution tracing
    trace_dir        = '.trace'          // Directory for trace outputs (independent of outdir)

}

process {
    stageInMode = 'symlink'  // zero overhead, works cross-filesystem, safe with boost cleanup disabled
    maxForks = 10
}

/*
========================================================================================
    Execution Profiles
========================================================================================
    Container images are declared per-process in modules/local/*.nf
========================================================================================
*/

profiles {
    // Test profile (small dataset validation)
    test {
        params.test = true
        includeConfig 'conf/test.config'
    }

    // Test full profile (complete dataset)
    test_full {
        includeConfig 'conf/test_full.config'
    }

    // Test profile variant that flips the segmentation backend to InstanSeg.
    // Mirrors the `test` profile and overrides `seg_method` afterwards so the
    // default StarDist path remains the CI default.
    instantseg_test {
        params.test = true
        includeConfig 'conf/test.config'
        params.seg_method = 'instantseg'
    }

    // Test profile variant that flips the segmentation backend to CellSAM.
    // Mirrors the `test` profile and overrides `seg_method` afterwards so the
    // default StarDist path remains the CI default.
    cellsam_test {
        params.test = true
        includeConfig 'conf/test.config'
        params.seg_method = 'cellsam'
    }

    // Docker (local development with containers)
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
        conda.enabled          = false
    }

    // Singularity (HPC with containers)
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        conda.enabled          = false
    }

    // Conda
    conda {
        conda.enabled          = true
        docker.enabled         = false
        singularity.enabled    = false
    }

    // SLURM execution
    slurm {
        process.executor = 'slurm'
        process.queue    = params.slurm_partition
        process.clusterOptions = {
            def opts = []
            if (params.slurm_account && params.slurm_account != '') opts << "--account=${params.slurm_account}"
            if (params.slurm_qos && params.slurm_qos != '')         opts << "--qos=${params.slurm_qos}"
            return opts ? opts.join(' ') : null
        }
    }

    // Local development (no SLURM)
    local {
        process.executor = 'local'
        params.max_cpus   = 4
        params.max_memory = '16.GB'
        // Clamp per-process requests to the local machine so heavy production
        // sizing (e.g. CONVERT_IMAGE) does not exceed a workstation's memory.
        process.resourceLimits = [ cpus: 4, memory: '16.GB', time: '72.h' ]
    }

    // IEO HPC site-specific config (gitignored)
    // To use: copy conf/site.config.template to conf/ieo.config
    // then run with: -profile singularity,ieo
    // The include is guarded so config parsing still succeeds where the
    // site file is absent (e.g. CI, fresh clones) — a missing include
    // otherwise breaks parsing for ALL profiles, not just `ieo`.
    ieo {
        if (new File("${projectDir}/conf/ieo.config").exists()) {
            includeConfig "${projectDir}/conf/ieo.config"
        }
    }
}

// Tower/Seqera Platform config moved to site-specific configs (e.g. conf/ieo.config)

/*
========================================================================================
    Execution Tracing (Optional)
========================================================================================
*/

trace {
    enabled   = params.enable_trace
    file      = "${params.trace_dir}/trace.txt"
    fields    = 'task_id,process,tag,name,status,exit,submit,start,complete,duration,realtime,%cpu,cpus,memory,peak_rss,peak_vmem,rchar,wchar'
    overwrite = true
}

report {
    enabled   = params.enable_trace
    file      = "${params.trace_dir}/report.html"
    overwrite = true
}

timeline {
    enabled   = params.enable_trace
    file      = "${params.trace_dir}/timeline.html"
    overwrite = true
}

boost {
    cleanup = false
}

