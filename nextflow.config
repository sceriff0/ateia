/*
========================================================================================
    MIRAGE WSI Processing Pipeline - Main Configuration
========================================================================================
    Author: mirage team
    Version: 1.0.0
========================================================================================
*/


// Plugins. Pinned to an exact version, never a range: a range would let a
// future plugin release change parameter validation under a rerun of an
// already-published analysis. 2.5.1 is the newest nf-schema whose `requires`
// (>=25.04.0) matches this pipeline's own manifest.nextflowVersion; 2.6.0+
// need Nextflow >=25.10.0.
//
// The plugin is downloaded from the Nextflow plugin registry on first use. On
// an air-gapped cluster it must be pre-provisioned — see docs/usage.md,
// "Offline / air-gapped execution".
plugins {
    id 'nf-schema@2.5.1'
}

// Include modular configurations
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

// Pipeline metadata
manifest {
    name            = 'mirage'
    description     = 'WSI processing pipeline (preprocessing, registration, segmentation, quantification, GeoJSON export)'
    author          = 'TODO(author)'   // TODO(author): set real author name(s) before publication
    version         = '1.0.0'
    nextflowVersion = '>=25.04.0'
    mainScript      = 'main.nf'
}


/*
========================================================================================
    Pipeline Parameters
========================================================================================
*/

params {
    // Input/output
    input              = null
    outdir             = null

    // Workflow control
    start          = 'preprocessing'  // preprocessing | registration | segmentation | postprocessing
    stop           = null            // null = run to end; or: preprocessing | registration | segmentation | postprocessing
    dry_run        = false
    debug_channels = false

    // Cluster options
    slurm_partition = null
    slurm_account   = null
    slurm_qos       = null
    gpu_type        = 'nvidia_h200:1'

    // Preprocessing (BaSiC illumination correction)
    // Three knobs, deliberately: an on/off switch, what BaSiC is NOT applied to, and the
    // tile size it fits on. Everything else uses BaSiC's own defaults (darkfield estimation
    // on, no autotune, non-overlapping FOVs) and the process CPU allocation — those were
    // parameters that nothing tuned, so they are gone rather than shipped as dead knobs.
    skip_preprocessing        = false  // true = CONVERT_IMAGE only; no BaSiC correction at all
    preproc_skip_nuclear      = true   // nuclear/fiducial channels (params.nuclear_markers)
                                       // bypass BaSiC — correcting the registration and
                                       // segmentation fiducial changes what both consume
    preproc_tile_size         = 1950   // BaSiC FOV tile size (px)
    preprocess_qc_scale_factor = 0.25
    skip_preprocess_qc         = false

    // Nuclear/fiducial channel — ordered preference of marker names. The first marker
    // present (resolved from channel metadata, never the filename) is moved to channel 0
    // by CONVERT_IMAGE and then drives BOTH cell segmentation and the registration
    // fiducial. Fails fast if none is present (single-channel images excepted).
    nuclear_markers      = ['DAPI', 'CELLTOX']

    // Registration (common)
    registration_method  = 'valis'         // 'valis' | 'tiled' (STARE: fully-parallel, JVM-free, laptop-friendly)
    allow_auto_reference = false
    skip_registration_qc = false
    reg_qc               = 2                // staged registration QC on by default (DAPI overlay +
                                            // segmentation-overlap dice/displacement); 0=none, 1=overlay only
    qc_scale_factor      = 0.25

    // reg_qc=2 cell correspondence. 'lsa' = optimal one-to-one assignment within the match
    // radius (exact, solved per connected component); 'mutual_nn' = the older greedy rule.
    seg_qc_pairing             = 'lsa'
    // Match radius in median nuclear radii, for BOTH pairing methods. 1.5 suits 'lsa', which
    // resolves contention globally; tighten toward 1.0 if you select 'mutual_nn'.
    seg_qc_match_radius_factor = 1.5

    // Registration (tiled / STARE) — only used when registration_method='tiled'
    // Nuclear/fiducial channel index used to estimate the transform. null = RESOLVE it
    // from the slide's channel metadata against params.nuclear_markers (MarkerUtils),
    // the same rule SEGMENT's CellSAM backend uses. A fixed 0 here duplicated an
    // invariant CONVERT_IMAGE already guarantees, and named it after one marker;
    // set an integer only to override the resolved index.
    reg_tiled_nuclear_index    = null
    reg_tiled_tile             = 2048             // tile core size (px); also the mesh grid resolution
    reg_tiled_halo             = 256              // tile read halo (px) for per-tile registration context
    reg_tiled_gate_tre         = 1.0              // refine only tiles whose rigid-stage TRE (px) exceeds this
    reg_tiled_upsample         = 10               // phase-correlation sub-pixel upsample factor (per-tile)
    reg_tiled_out_tile         = 1024             // streaming stitch write-tile size (px) — gigapixel-safe
    reg_tiled_coarse_max_dim   = 4096             // COARSE anchor thumbnail: longest side (px). Cost/accuracy knob:
                                                  // ORB costs ~40 B per source pixel, so this bounds COARSE at ~2 GB
                                                  // regardless of slide size. Lower = cheaper, coarser M0; the residual
                                                  // it leaves must stay well inside reg_tiled_halo. 0 disables decimation.

    // Registration (VALIS)
    memory_mode                = 'high'
    reg_micro_reg_fraction     = 0.125
    reg_max_image_dim          = 4000
    reg_micro_reg              = 2                // micro-registration depth (default MAX): 0=none,
                                                  // 1=micro-rigid only (refines slide.M), 2=+micro
                                                  // non-rigid (register_micro). At >=1 the QC 'rigid'
                                                  // stage means affine ∘ micro-rigid.
    // JVM heap (GiB) for VALIS/Bio-Formats in REGISTER. null = derive from
    // task.memory at runtime (register.nf). Declared so it is not an
    // "undefined parameter" warning / nf-core lint finding.
    reg_jvm_heap_gb            = null

    // Distributed/tiled low-memory registration params archived 2026-07-24
    // (git tag archive/tiled-valis-2026-07-24): reg_distributed_tiling, reg_dist_*,
    // reg_max_non_rigid_dim, reg_warp_tile_*, reg_mem_budget_gb, reg_compare.

    // Segmentation
    // Default is 'instantseg': it is the only backend that runs on a fresh clone.
    // The 'stardist' path needs a trained model supplied via segmentation_model_dir
    // (the shipped segmentation_model name is not a StarDist built-in, so segment.py
    // raises FileNotFoundError without it — see conf/ieo.config). InstanSeg is also
    // Apache-2.0 with unencumbered weights, whereas CellSAM/Cellpose/Mesmer weights
    // are gated or non-commercial.
    seg_method             = 'instantseg' // 'stardist' | 'instantseg' | 'cellsam'
    seg_gpu                = true
    seg_pmin               = 1.0
    seg_pmax               = 99.8
    // StarDist detection probability threshold. null = use the model's built-in
    // default (production). Lower it (e.g. test profile) to detect fainter nuclei.
    seg_prob_thresh        = null
    seg_n_tiles_y          = 16
    seg_n_tiles_x          = 16
    seg_expand_distance    = 10
    segmentation_model_dir = null
    segmentation_model     = 'stardist_full_e200_lr00001_aug1_seed10_es50p0.001_rlr0.5p50'

    // Segmentation (InstanSeg backend; only used when seg_method='instantseg')
    seg_instantseg_model      = 'fluorescence_nuclei_and_cells'
    seg_instantseg_target     = 'all_outputs'   // 'all_outputs' | 'cells' | 'nuclei'
    // Tiled inference via eval_medium_image. tile_size is in pixels at the
    // model's working pixel size; batch_size is the number of tiles pushed
    // through the model per forward pass. Bump batch_size on large GPUs
    // (e.g. 16-32 on H200/H100); keep low on small GPUs to avoid OOM.
    seg_instantseg_tile_size  = 512
    seg_instantseg_batch_size = 16
    // Writable host path for InstanSeg's BioImage.IO model cache. Exported as
    // INSTANSEG_BIOIMAGEIO_PATH so the model is not written into the read-only
    // container image. When null, falls back to a per-task work-dir cache
    // (functional but re-downloads per task).
    instanseg_model_dir    = null

    // Segmentation (CellSAM backend; only used when seg_method='cellsam')
    // CellSAM segments the nuclear (DAPI) channel; the whole-cell mask is
    // derived by expanding nuclei labels with seg_expand_distance (shared with
    // StarDist). bbox_threshold is the precision/recall knob; use_wsi enables
    // CellSAM's native tiling (block_size/overlap) for large images.
    seg_cellsam_bbox_threshold = 0.4
    seg_cellsam_use_wsi        = true
    // block_size 1024 (vs upstream default 400) cuts the tile count ~6x for the
    // same image, so far fewer per-tile model invocations. Stay within CellSAM's
    // recommended [256, 2048] range.
    seg_cellsam_block_size     = 1024
    seg_cellsam_overlap        = 56
    // Path to pre-downloaded CellSAM weights for offline/container use. When
    // null, weights are auto-downloaded at runtime (requires a valid
    // DEEPCELL_ACCESS_TOKEN in the task environment).
    cellsam_model_path         = null

    // Quantification (per-compartment signal)
    // When true, SEGMENT's nuclear mask is routed into QUANTIFY alongside the
    // whole-cell mask, emitting Nucleus / Cytoplasm / Cell signal per marker into
    // the GeoJSON (cytoplasm = whole-cell − nucleus). Default on: the standard
    // output now carries per-compartment measurements and both a cell+nucleus and a
    // whole-cell-only GeoJSON. Set false for a lean whole-cell-only run.
    quantify_compartments   = true
    // Statistic policy is independent of quantify_compartments: MEDIAN is the
    // default per-channel statistic and is ALWAYS computed (per-cell pixel gather).
    // expanded_quantification adds Mean and Sum (integrated density) per compartment
    // on top. Default on so Mean/Sum are available alongside the Median default.
    expanded_quantification = true

    // GeoJSON export (EXTRACT_CELL_PROPERTIES / EXTRACT_NUCLEI_PROPERTIES). The
    // exported polygon is display-only — all quantification is mask-derived — so
    // simplifying it and dropping sub-pixel coordinate precision does not affect
    // analysis.
    simplify_tolerance       = 1.0   // Douglas-Peucker tolerance (px) for contour simplification
    geojson_coord_precision  = 2     // decimal places for GeoJSON coordinates

    // ---- SpatialData (.zarr) export ------------------------------------------------
    // Additive scverse-native output; OME-TIFF + GeoJSON remain the primary artifacts.
    skip_spatialdata_export         = false
    // spatialdata.write() materializes every element, so including the pyramid
    // duplicates the largest artifact the pipeline produces. Off by default; turn on
    // for a self-contained, depositable object.
    spatialdata_include_image       = false
    // Max centroid distance (px) when joining warp_seg_qc's per-cell residuals onto
    // cell_mask. The QC segmentation is a separate native-image StarDist run and shares
    // no label space with cell_mask, so the join is spatial (see export_spatialdata.py).
    spatialdata_residual_join_max_px = 15.0

    // Postprocessing QC
    skip_postprocessing_qc = false

    // Reference-free cell-segmentation quality scoring (CSE, 2D). OPT-IN.
    //
    // Default TRUE (off) on purpose. This scorer is the one QC stage that can
    // fail for reasons unrelated to the data -- it needs the `segeval` image on
    // Docker Hub, and .github/workflows/build-images.yml only pushes on a release
    // or a manual dispatch, never on a push to main. A default-on stage whose
    // container may not exist yet fails every run of a fresh clone. Turn it on
    // for a benchmark cohort with `--skip_seg_quality_eval false`.
    skip_seg_quality_eval = true
    cse_pixel_size_um     = null
    // Bin image+masks so CSE scores at most this many pixels. Full-WSI masks
    // otherwise exhaust CSE's memory/time budget (active-contour + per-pixel
    // reductions), so the process OOMs/times out and its QC-block errorStrategy
    // silently ignores it. Geometry/area metrics are preserved by binning; the
    // composite QualityScore shifts with the factor, so keep it fixed across a
    // cohort for comparability. Set null to disable (score at full resolution).
    cse_max_pixels        = 50000000
    segeval_tag           = 'segeval'   // tag on bolt3x/attend_image_analysis (Docker Hub)

    // Final QC report
    skip_final_qc_report   = false

    // Image and pyramid output
    pixel_size          = 0.325
    tilex               = 512
    pyramid_resolutions = 8
    pyramid_scale       = 2
    compression         = 'zstd'

    // Resource Limits
    max_memory       = '700.GB'
    max_cpus         = 128
    max_time         = '240.h'

    // Tracing (optional)
    enable_trace     = true             // Enable detailed execution tracing
    trace_dir        = '.trace'          // Directory for trace outputs (independent of outdir)

    // Incremental cyclic-IF mode. 'standard' = normal start/stop pipeline;
    // 'add_cycle' = fold a new imaging cycle into a prior completed run.
    mode         = 'standard'
    // For mode='add_cycle': the --outdir of the previously completed run,
    // whose csv/registered.csv and csv/postprocessed.csv provide the reusable
    // reference, segmentation mask, merged quantification table, and pyramid.
    prior_outdir = null
    // Embed the segmentation masks as a SECOND series in the pyramid OME-TIFF
    // (cell_mask + nuclei_mask, uint32, single-res). Written only when this is
    // true AND quantify_compartments AND expanded_quantification. Default off so
    // enabling compartments+expanded does not silently bloat every pyramid with an
    // extra uint32 mask series — masks remain available separately under
    // segmentation/. Set true to embed them. See docs/add_cycle.md.
    embed_masks  = false

}

process {
    stageInMode     = 'symlink'  // zero overhead, works cross-filesystem
    maxForks        = 100
    // Closure (not a plain map): resourceLimits is assigned here, at the TOP
    // of the config, before any profile's `params.max_*` override (e.g.
    // conf/test.config's max_cpus=2) has run. A plain map would eagerly
    // capture params.max_* as they stand at THIS point in the file --
    // nextflow.config's own top-level defaults (128 / 700.GB / 240.h) --
    // silently ignoring any profile override and *raising* CI's resource
    // ceiling instead of enforcing it. Wrapped in a closure, evaluation is
    // deferred to task-submission time, by which point the full profile
    // stack (including test/test_full/local's params.max_* overrides) has
    // already been merged. Verified empirically: see tests/modules/
    // resource_limits.nf.test and task-9-report.md.
    resourceLimits  = { [ cpus: params.max_cpus, memory: params.max_memory, time: params.max_time ] }
}

/*
========================================================================================
    Execution Profiles
========================================================================================
    Container images are declared per-process in modules/local/*.nf
========================================================================================
*/

profiles {
    // Test profile (small dataset validation)
    test {
        includeConfig 'conf/test.config'
    }

    // Test full profile (complete dataset)
    test_full {
        includeConfig 'conf/test_full.config'
    }

    // Test profile variant that flips the segmentation backend to InstanSeg.
    // Mirrors the `test` profile and overrides `seg_method` afterwards so the
    // default StarDist path remains the CI default.
    instantseg_test {
        includeConfig 'conf/test.config'
        params.seg_method = 'instantseg'
    }

    // Test profile variant that flips the segmentation backend to CellSAM.
    // Mirrors the `test` profile and overrides `seg_method` afterwards so the
    // default StarDist path remains the CI default.
    cellsam_test {
        includeConfig 'conf/test.config'
        params.seg_method = 'cellsam'
    }

    // Docker (local development with containers)
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
        conda.enabled          = false
    }

    // Singularity (HPC with containers)
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        conda.enabled          = false
        // Forward DEEPCELL_ACCESS_TOKEN by name (like Docker's `-e VAR`) instead
        // of interpolating its value into containerOptions (conf/modules.config
        // SEGMENT), which would otherwise land in the work dir's .command.run.
        singularity.envWhitelist = 'DEEPCELL_ACCESS_TOKEN'
    }

    // Conda
    conda {
        conda.enabled          = true
        docker.enabled         = false
        singularity.enabled    = false
    }

    // SLURM execution
    slurm {
        process.executor = 'slurm'
        process.queue    = params.slurm_partition
        process.clusterOptions = {
            def opts = []
            if (params.slurm_account && params.slurm_account != '') opts << "--account=${params.slurm_account}"
            if (params.slurm_qos && params.slurm_qos != '')         opts << "--qos=${params.slurm_qos}"
            return opts ? opts.join(' ') : null
        }
        // Clamp every per-process request to the cluster ceiling (max_* params).
        // Without this, hard withName memory floors (e.g. CONVERT_IMAGE, REGISTER)
        // are submitted unclamped — there is no check_max() helper in this repo.
        //
        // NOTE: this is a plain map, not a closure, so it is evaluated NOW --
        // eagerly, at profile-merge time -- and it OVERWRITES (shadows) the
        // top-level closure-based process.resourceLimits set at the top of this
        // file (see the comment there). That closure is what lets a second
        // profile merged later (e.g. `-profile slurm,ieo`) override params.max_*
        // and have resourceLimits pick up the new values lazily; once this line
        // has run, resourceLimits is frozen to whatever params.max_* were at
        // this point, so `-profile slurm,ieo` will NOT pick up ieo's pinned
        // params.max_* here. Left as-is intentionally: today the values
        // coincide and no documented invocation combines `slurm` with another
        // profile that sets max_*, so there is no observed bug -- but `slurm`
        // is the one profile in this file exempt from the closure-based
        // abstraction the rest of the profiles rely on. Fix, if ever needed: make
        // this a closure too, matching the top-level default.
        process.resourceLimits = [ cpus: params.max_cpus, memory: params.max_memory, time: params.max_time ]
    }

    // Local development (no SLURM)
    local {
        process.executor  = 'local'
        // Clamp per-process requests to the local machine so heavy production
        // sizing (e.g. CONVERT_IMAGE) does not exceed a workstation's memory.
        // process.resourceLimits (top-level, nextflow.config) reads these back
        // lazily at task-submission time, so setting the params here is enough
        // -- no need for a duplicate per-profile resourceLimits list.
        params.max_cpus   = 4
        params.max_memory = '16.GB'
        params.max_time   = '72.h'
    }

    // IEO HPC cluster profile — committable, non-secret cluster execution
    // settings ONLY, so `-profile ieo` parses in CI and fresh clones. Do NOT
    // `includeConfig 'conf/ieo.config'` here: that file is gitignored, and the
    // strict Nextflow parser (latest-everything channel) eagerly evaluates
    // profile includes at parse time for ALL profiles — so a missing include
    // breaks every profile (even `-profile test`) in CI and fresh clones.
    // Site-specific paths/secrets (outdir, model dirs, singularity cacheDir and
    // bind mounts, Tower workspace) live in the gitignored overlay and are
    // layered on the command line:
    //   Setup: cp conf/site.config.template conf/ieo.config   (then customise)
    //   Run:   nextflow run . -profile singularity,ieo -c conf/ieo.config ...
    ieo {
        process.executor = 'slurm'
        // Pin the IEO cluster ceiling explicitly, the same way `local` pins
        // its own (:351-353). This happens to equal nextflow.config's
        // top-level default today, but that is a coincidence, not a
        // guarantee: if a future change lowers the global default (e.g. to
        // tighten some other profile's ceiling), IEO must keep its own
        // hardware limit rather than silently inheriting whatever the
        // top-level default becomes. process.resourceLimits (top-level)
        // reads these back lazily at task-submission time.
        params.max_cpus   = 128
        params.max_memory = '700.GB'
        params.max_time   = '240.h'
    }
}

// Tower/Seqera Platform config moved to site-specific configs (e.g. conf/ieo.config)

/*
========================================================================================
    Execution Tracing (Optional)
========================================================================================
*/

trace {
    enabled   = params.enable_trace
    file      = "${params.trace_dir}/trace.txt"
    fields    = 'task_id,process,tag,name,status,exit,submit,start,complete,duration,realtime,%cpu,cpus,memory,peak_rss,peak_vmem,rchar,wchar'
    overwrite = true
}

report {
    enabled   = params.enable_trace
    file      = "${params.trace_dir}/report.html"
    overwrite = true
}

timeline {
    enabled   = params.enable_trace
    file      = "${params.trace_dir}/timeline.html"
    overwrite = true
}

