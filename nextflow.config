/*
========================================================================================
    MIRAGE WSI Processing Pipeline - Main Configuration
========================================================================================
    Author: mirage team
    Version: 0.1.0
========================================================================================
*/


// Include modular configurations
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

// Pipeline metadata
manifest {
    name            = 'mirage'
    description     = 'WSI processing pipeline (preprocessing, registration, segmentation, quantification, GeoJSON export)'
    author          = 'TODO(author)'   // TODO(author): set real author name(s) before publication
    version         = '0.1.0'
    nextflowVersion = '>=25.04.0'
    mainScript      = 'main.nf'
}


/*
========================================================================================
    Pipeline Parameters
========================================================================================
*/

params {
    // Input/output
    input              = null
    outdir             = null

    // Workflow control
    start          = 'preprocessing'  // preprocessing | registration | postprocessing
    stop           = null            // null = run to end; or: preprocessing | registration | postprocessing
    dry_run        = false
    debug_channels = false

    // Cluster options
    slurm_partition = null
    slurm_account   = null
    slurm_qos       = null
    gpu_type        = 'nvidia_h200:1'

    // Preprocessing
    preproc_tile_size         = 1950
    preproc_skip_dapi         = true
    preproc_autotune          = false
    preproc_n_iter            = 100
    preproc_pool_workers      = null   // worker threads for preprocessing; null = use task.cpus
    preproc_overlap           = 0
    preproc_no_darkfield      = false
    preprocess_qc_scale_factor = 0.25
    skip_preprocess_qc         = false

    // Registration (common)
    registration_method  = 'valis'
    allow_auto_reference = false
    padding              = false
    pad_mode             = 'constant'
    skip_registration_qc = false
    reg_qc               = 2                // staged registration QC on by default (DAPI overlay +
                                            // segmentation-overlap dice/displacement); 0=none, 1=overlay only
    qc_scale_factor      = 0.25
    enable_feature_error = false
    feature_detector     = 'superpoint'
    feature_max_dim      = 1024
    feature_n_features   = 5000

    // Registration (VALIS)
    reg_reference_markers      = ['DAPI', 'FITC']
    memory_mode                = 'high'
    reg_micro_reg_fraction     = 0.125
    reg_max_image_dim          = 4000
    reg_micro_reg              = 0                // micro-registration depth: 0=none (default,
                                                  // preserves historical behaviour), 1=micro-rigid
                                                  // only (refines slide.M), 2=+micro non-rigid
                                                  // (register_micro). At >=1 the QC 'rigid' stage
                                                  // means affine ∘ micro-rigid.
    // JVM heap (GiB) for VALIS/Bio-Formats in REGISTER. null = derive from
    // task.memory at runtime (register.nf). Declared so it is not an
    // "undefined parameter" warning / nf-core lint finding.
    reg_jvm_heap_gb            = null

    // Distributed/tiled low-memory registration params archived 2026-07-24
    // (git tag archive/tiled-valis-2026-07-24): reg_distributed_tiling, reg_dist_*,
    // reg_max_non_rigid_dim, reg_warp_tile_*, reg_mem_budget_gb, reg_compare.

    // Segmentation
    seg_method             = 'stardist'   // 'stardist' | 'instantseg' | 'cellsam'
    seg_gpu                = true
    seg_pmin               = 1.0
    seg_pmax               = 99.8
    // StarDist detection probability threshold. null = use the model's built-in
    // default (production). Lower it (e.g. test profile) to detect fainter nuclei.
    seg_prob_thresh        = null
    seg_n_tiles_y          = 16
    seg_n_tiles_x          = 16
    seg_expand_distance    = 10
    segmentation_model_dir = null
    segmentation_model     = 'stardist_full_e200_lr00001_aug1_seed10_es50p0.001_rlr0.5p50'

    // Segmentation (InstanSeg backend; only used when seg_method='instantseg')
    seg_instantseg_model      = 'fluorescence_nuclei_and_cells'
    seg_instantseg_target     = 'all_outputs'   // 'all_outputs' | 'cells' | 'nuclei'
    // Tiled inference via eval_medium_image. tile_size is in pixels at the
    // model's working pixel size; batch_size is the number of tiles pushed
    // through the model per forward pass. Bump batch_size on large GPUs
    // (e.g. 16-32 on H200/H100); keep low on small GPUs to avoid OOM.
    seg_instantseg_tile_size  = 512
    seg_instantseg_batch_size = 16
    // Writable host path for InstanSeg's BioImage.IO model cache. Exported as
    // INSTANSEG_BIOIMAGEIO_PATH so the model is not written into the read-only
    // container image. When null, falls back to a per-task work-dir cache
    // (functional but re-downloads per task).
    instanseg_model_dir    = null

    // Segmentation (CellSAM backend; only used when seg_method='cellsam')
    // CellSAM segments the nuclear (DAPI) channel; the whole-cell mask is
    // derived by expanding nuclei labels with seg_expand_distance (shared with
    // StarDist). bbox_threshold is the precision/recall knob; use_wsi enables
    // CellSAM's native tiling (block_size/overlap) for large images.
    seg_cellsam_bbox_threshold = 0.4
    seg_cellsam_use_wsi        = true
    // block_size 1024 (vs upstream default 400) cuts the tile count ~6x for the
    // same image, so far fewer per-tile model invocations. Stay within CellSAM's
    // recommended [256, 2048] range.
    seg_cellsam_block_size     = 1024
    seg_cellsam_overlap        = 56
    // Path to pre-downloaded CellSAM weights for offline/container use. When
    // null, weights are auto-downloaded at runtime (requires a valid
    // DEEPCELL_ACCESS_TOKEN in the task environment).
    cellsam_model_path         = null

    // Quantification (per-compartment signal)
    // When true, SEGMENT's nuclear mask is routed into QUANTIFY alongside the
    // whole-cell mask, emitting Nucleus / Cytoplasm / Cell signal per marker into
    // the GeoJSON (cytoplasm = whole-cell − nucleus). Default on: the standard
    // output now carries per-compartment measurements and both a cell+nucleus and a
    // whole-cell-only GeoJSON. Set false for a lean whole-cell-only run.
    quantify_compartments   = true
    // Statistic policy is independent of quantify_compartments: MEDIAN is the
    // default per-channel statistic and is ALWAYS computed (per-cell pixel gather).
    // expanded_quantification adds Mean and Sum (integrated density) per compartment
    // on top. Default on so Mean/Sum are available alongside the Median default.
    expanded_quantification = true

    // GeoJSON export (EXTRACT_CELL_PROPERTIES / EXTRACT_NUCLEI_PROPERTIES). The
    // exported polygon is display-only — all quantification is mask-derived — so
    // simplifying it and dropping sub-pixel coordinate precision does not affect
    // analysis.
    simplify_tolerance       = 1.0   // Douglas-Peucker tolerance (px) for contour simplification
    geojson_coord_precision  = 2     // decimal places for GeoJSON coordinates

    // Postprocessing QC
    skip_postprocessing_qc = false

    // Reference-free cell-segmentation quality scoring (CSE, 2D)
    skip_seg_quality_eval = false
    cse_pixel_size_um     = null
    // Bin image+masks so CSE scores at most this many pixels. Full-WSI masks
    // otherwise exhaust CSE's memory/time budget (active-contour + per-pixel
    // reductions), so the process OOMs/times out and its QC-block errorStrategy
    // silently ignores it. Geometry/area metrics are preserved by binning; the
    // composite QualityScore shifts with the factor, so keep it fixed across a
    // cohort for comparability. Set null to disable (score at full resolution).
    cse_max_pixels        = 50000000
    segeval_tag           = 'segeval'   // tag on bolt3x/attend_image_analysis (Docker Hub)

    // Final QC report
    skip_final_qc_report   = false

    // Image and pyramid output
    pixel_size          = 0.325
    tilex               = 512
    pyramid_resolutions = 8
    pyramid_scale       = 2
    compression         = 'zstd'

    // Resource Limits
    max_memory       = '700.GB'
    max_cpus         = 128
    max_time         = '240.h'

    // Tracing (optional)
    enable_trace     = true             // Enable detailed execution tracing
    trace_dir        = '.trace'          // Directory for trace outputs (independent of outdir)

    // Incremental cyclic-IF mode. 'standard' = normal start/stop pipeline;
    // 'add_cycle' = fold a new imaging cycle into a prior completed run.
    mode         = 'standard'
    // For mode='add_cycle': the --outdir of the previously completed run,
    // whose csv/registered.csv and csv/postprocessed.csv provide the reusable
    // reference, segmentation mask, merged quantification table, and pyramid.
    prior_outdir = null
    // Embed the segmentation masks as a SECOND series in the pyramid OME-TIFF
    // (cell_mask + nuclei_mask, uint32, single-res). Written only when this is
    // true AND quantify_compartments AND expanded_quantification. Default off so
    // enabling compartments+expanded does not silently bloat every pyramid with an
    // extra uint32 mask series — masks remain available separately under
    // segmentation/. Set true to embed them. See docs/add_cycle.md.
    embed_masks  = false

}

process {
    stageInMode = 'symlink'  // zero overhead, works cross-filesystem
    maxForks = 100
}

/*
========================================================================================
    Execution Profiles
========================================================================================
    Container images are declared per-process in modules/local/*.nf
========================================================================================
*/

profiles {
    // Test profile (small dataset validation)
    test {
        params.test = true
        includeConfig 'conf/test.config'
    }

    // Test full profile (complete dataset)
    test_full {
        includeConfig 'conf/test_full.config'
    }

    // Test profile variant that flips the segmentation backend to InstanSeg.
    // Mirrors the `test` profile and overrides `seg_method` afterwards so the
    // default StarDist path remains the CI default.
    instantseg_test {
        params.test = true
        includeConfig 'conf/test.config'
        params.seg_method = 'instantseg'
    }

    // Test profile variant that flips the segmentation backend to CellSAM.
    // Mirrors the `test` profile and overrides `seg_method` afterwards so the
    // default StarDist path remains the CI default.
    cellsam_test {
        params.test = true
        includeConfig 'conf/test.config'
        params.seg_method = 'cellsam'
    }

    // Docker (local development with containers)
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
        conda.enabled          = false
    }

    // Singularity (HPC with containers)
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        conda.enabled          = false
    }

    // Conda
    conda {
        conda.enabled          = true
        docker.enabled         = false
        singularity.enabled    = false
    }

    // SLURM execution
    slurm {
        process.executor = 'slurm'
        process.queue    = params.slurm_partition
        process.clusterOptions = {
            def opts = []
            if (params.slurm_account && params.slurm_account != '') opts << "--account=${params.slurm_account}"
            if (params.slurm_qos && params.slurm_qos != '')         opts << "--qos=${params.slurm_qos}"
            return opts ? opts.join(' ') : null
        }
        // Clamp every per-process request to the cluster ceiling (max_* params).
        // Without this, hard withName memory floors (e.g. CONVERT_IMAGE, REGISTER)
        // are submitted unclamped — there is no check_max() helper in this repo.
        process.resourceLimits = [ cpus: params.max_cpus, memory: params.max_memory, time: params.max_time ]
    }

    // Local development (no SLURM)
    local {
        process.executor = 'local'
        params.max_cpus   = 4
        params.max_memory = '16.GB'
        // Clamp per-process requests to the local machine so heavy production
        // sizing (e.g. CONVERT_IMAGE) does not exceed a workstation's memory.
        process.resourceLimits = [ cpus: 4, memory: '16.GB', time: '72.h' ]
    }

    // IEO HPC cluster profile — committable, non-secret cluster execution
    // settings ONLY, so `-profile ieo` parses in CI and fresh clones. Do NOT
    // `includeConfig 'conf/ieo.config'` here: that file is gitignored, and the
    // strict Nextflow parser (latest-everything channel) eagerly evaluates
    // profile includes at parse time for ALL profiles — so a missing include
    // breaks every profile (even `-profile test`) in CI and fresh clones.
    // Site-specific paths/secrets (outdir, model dirs, singularity cacheDir and
    // bind mounts, Tower workspace) live in the gitignored overlay and are
    // layered on the command line:
    //   Setup: cp conf/site.config.template conf/ieo.config   (then customise)
    //   Run:   nextflow run . -profile singularity,ieo -c conf/ieo.config ...
    ieo {
        process.executor       = 'slurm'
        process.resourceLimits = [ cpus: 128, memory: '700.GB', time: '240.h' ]
    }
}

// Tower/Seqera Platform config moved to site-specific configs (e.g. conf/ieo.config)

/*
========================================================================================
    Execution Tracing (Optional)
========================================================================================
*/

trace {
    enabled   = params.enable_trace
    file      = "${params.trace_dir}/trace.txt"
    fields    = 'task_id,process,tag,name,status,exit,submit,start,complete,duration,realtime,%cpu,cpus,memory,peak_rss,peak_vmem,rchar,wchar'
    overwrite = true
}

report {
    enabled   = params.enable_trace
    file      = "${params.trace_dir}/report.html"
    overwrite = true
}

timeline {
    enabled   = params.enable_trace
    file      = "${params.trace_dir}/timeline.html"
    overwrite = true
}

