/*
 * benchmark profile — full tracing + aggressive cluster parallelism for the sweep.
 *
 * Layered by run_sweep.sh as `-c benchmarks/configs/benchmark.config`, so these overrides
 * apply ONLY to sweep runs (production pipeline runs keep the conservative base.config /
 * modules.config throttles). Overrides:
 *   - REGISTER maxForks    10  -> 30    (the heavy stage — see the RAM caveat below)
 *
 * Concurrency (queueSize / maxForks) is NOT set here — it is param-driven now and the
 * submitters pass --max_forks / --queue_size on the CLI. See the block above process{}.
 *
 * !!! PRECEDENCE: the SITE config (conf/ieo.config) is layered AFTER this file, so if it
 *     also sets executor.queueSize / process.maxForks it WINS. If your ieo.config pins
 *     those, raise them there too (or remove them so these values apply).
 *
 * Total cluster load is roughly  SWEEP_CONCURRENCY (heads, submit_sweep.sh)  x  queueSize.
 * Check your site's per-user SLURM job cap (`sacctmgr show assoc user=$USER format=maxsubmit`)
 * before pushing these much higher.
 */
params {
    // Nextflow trace/report/timeline + per-stage input-size aggregation (make_tables reads both).
    // enable_trace gates AGGREGATE_SIZE_LOGS in workflows/mirage.nf, so no separate size-log flag.
    enable_trace = true

    // REQUIRED, not a preference. The pipeline's shipped default is 'final', which publishes
    // only Layout.FINAL_KINDS -- quantification/, geojson/, pyramid/ -- plus the run-level
    // qc/, csv/ and size_logs/. `registered/` is an INTERMEDIATE_KIND, so at 'final' the VALIS
    // registration summaries under <patient>/registered/summary/*.csv are never published.
    //
    // benchmarks/analysis/lib/quality.py:142 globs for exactly that path to build the
    // registration-quality table. At the shipped default it would match nothing and the table
    // would come out EMPTY while the run exited 0 -- the same silent-success failure mode the
    // cleanup_work entry in benchmarks/tests/test_build_run_plan.py's NOT_SWEPT describes.
    //
    // 'none' publishes every kind. Do not "tidy" this to 'final' without first checking what
    // benchmarks/analysis/ reads out of the published tree.
    cleanup_level = 'none'
}

executor {
    // queueSize is NOT set here any more. It is now driven by params.queue_size
    // (nextflow.config assigns `executor.queueSize = params.queue_size`), and the
    // submitters raise it with `--queue_size` on the COMMAND LINE. See the note above
    // process{} for why a -c file cannot do it.
    submitRateLimit = '50/1min'  // stagger submissions so hundreds of jobs don't slam the SLURM controller
    pollInterval    = '15 sec'   // check job status a bit more often when many are in flight
}

/*
    CONCURRENCY IS RAISED ON THE COMMAND LINE, NOT HERE, AND THAT IS NOT A STYLE CHOICE.

    Every per-process cap in conf/modules.config is now `Math.min(<own limit>,
    params.max_forks as int)`. `maxForks` is not a dynamic directive -- Nextflow compares
    it against 0 in TaskProcessor's constructor -- so it CANNOT be deferred into a closure
    and is evaluated EAGERLY when conf/modules.config is parsed. That parse happens inside
    nextflow.config, BEFORE this file is merged with `-c`. So setting `params.max_forks`
    here arrives too late to reach a single clamp, and setting a bare `process.maxForks`
    here does not raise them either: a global default cannot lift a per-process withName
    value that has already resolved to min(own, 100).

    A CLI `--max_forks` IS in scope at that parse, which is why the submitters pass it.
    Both submitters send `--max_forks 200 --queue_size 100`; docs/resources.md documents
    the pair, and they must be raised TOGETHER because the lower of the two binds.
*/
process {

    // REGISTER is the heavy stage: ~300 GB memory and 8 CPUs EACH (conf/modules.config). The
    // production cap of 10 was deliberately conservative. Budget RAM before raising:
    //   concurrent REGISTER jobs  x  300 GB  <=  cluster RAM you'll dedicate to registration.
    // 30 => ~9 TB peak. Set to (RAM budget for REGISTER) / 300 GB for your cluster.
    withName: 'REGISTER' { maxForks = 30 }
}
