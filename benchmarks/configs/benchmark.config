/*
 * benchmark profile — full tracing + aggressive cluster parallelism for the sweep.
 *
 * Layered by run_sweep.sh as `-c benchmarks/configs/benchmark.config`, so these overrides
 * apply ONLY to sweep runs (production pipeline runs keep the conservative base.config /
 * modules.config throttles). Overrides:
 *   - executor.queueSize   20  -> 100   (jobs in flight per Nextflow head)
 *   - process.maxForks     100 -> 200   (global per-process cap, light stages)
 *   - REGISTER maxForks    10  -> 30    (the heavy stage — see the RAM caveat below)
 *
 * !!! PRECEDENCE: the SITE config (conf/ieo.config) is layered AFTER this file, so if it
 *     also sets executor.queueSize / process.maxForks it WINS. If your ieo.config pins
 *     those, raise them there too (or remove them so these values apply).
 *
 * Total cluster load is roughly  SWEEP_CONCURRENCY (heads, submit_sweep.sh)  x  queueSize.
 * Check your site's per-user SLURM job cap (`sacctmgr show assoc user=$USER format=maxsubmit`)
 * before pushing these much higher.
 */
params {
    // Nextflow trace/report/timeline + per-stage input-size aggregation (make_tables reads both).
    // enable_trace gates AGGREGATE_SIZE_LOGS in workflows/mirage.nf, so no separate size-log flag.
    enable_trace = true
}

executor {
    queueSize       = 100        // was 20 (base.config). Max pipeline-process jobs in flight per head.
    submitRateLimit = '50/1min'  // stagger submissions so hundreds of jobs don't slam the SLURM controller
    pollInterval    = '15 sec'   // check job status a bit more often when many are in flight
}

process {
    maxForks = 200               // global per-process cap (was 100, nextflow.config). Light stages only —
                                 // GPU stages (SEGMENT with seg_gpu=true) are still bounded by available GPUs.

    // REGISTER is the heavy stage: ~300 GB memory and 8 CPUs EACH (conf/modules.config). The
    // production cap of 10 was deliberately conservative. Budget RAM before raising:
    //   concurrent REGISTER jobs  x  300 GB  <=  cluster RAM you'll dedicate to registration.
    // 30 => ~9 TB peak. Set to (RAM budget for REGISTER) / 300 GB for your cluster.
    withName: 'REGISTER' { maxForks = 30 }
}
