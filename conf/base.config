/*
========================================================================================
    Base Process Configuration
========================================================================================
    Default settings for SLURM execution
========================================================================================
*/

process {
    // Error handling strategy - retry on resource exhaustion, finish on other errors
    errorStrategy = {
        task.exitStatus in [
            104,  // Connection reset
            134,  // SIGABRT (abort signal)
            135,  // SIGBUS
            137,  // SIGKILL (out of memory)
            139,  // SIGSEGV (segmentation fault)
            140,  // SIGTERM
            143   // SIGTERM (job killed)
        ] ? 'retry' : 'finish'
    }
    maxRetries = 3
    maxErrors  = '-1'

    // Default resource requirements
    cpus   = { 1    * task.attempt }
    memory = { 6.GB * task.attempt }
    time   = { 4.h  * task.attempt }


    // SLURM defaults (can be overridden by profile or params)
    queue          = null
    clusterOptions = null
}

/*
========================================================================================
    Executor Configuration
========================================================================================
*/

executor {
    // Max concurrent jobs, GLOBALLY, across every process.
    //
    // This is the binding constraint, not `process.maxForks` (nextflow.config:266, = 100):
    // the executor's queueSize caps total concurrency, so a per-process maxForks above it can
    // never be reached and raising maxForks alone changes nothing. Tune this number, or tune
    // both; tuning maxForks by itself is a no-op. 20 is deliberately conservative for a shared
    // scheduler -- raise it in a site profile (conf/site.config.template), not here.
    queueSize       = 20
    exitReadTimeout = '1 day'    // Timeout for SLURM job status polling
}

/*
========================================================================================
    Notes
========================================================================================

    SLURM Error Codes Handled:
    - 143: SIGTERM (job killed)
    - 137: SIGKILL (out of memory)
    - 104: Connection reset
    - 134: SIGABRT (abort)
    - 139: SIGSEGV (segmentation fault)

    These errors trigger automatic retry (up to maxRetries=3)
========================================================================================
*/
