/*
========================================================================================
    Base Process Configuration
========================================================================================
    Default settings for SLURM execution
========================================================================================
*/

process {
    // Error handling strategy - retry on resource exhaustion, finish on other errors
    errorStrategy = {
        task.exitStatus in [
            104,  // Connection reset
            134,  // SIGABRT (abort signal)
            135,  // SIGBUS
            137,  // SIGKILL (out of memory)
            139,  // SIGSEGV (segmentation fault)
            140,  // SIGTERM
            143   // SIGTERM (job killed)
        ] ? 'retry' : 'finish'
    }
    maxRetries = 3
    maxErrors  = '-1'

    // Default resource requirements
    cpus   = { 1    * task.attempt }
    memory = { 6.GB * task.attempt }
    time   = { 4.h  * task.attempt }


    // SLURM defaults (can be overridden by profile or params)
    queue          = null
    clusterOptions = null
}

/*
========================================================================================
    Executor Configuration
========================================================================================
*/

executor {
    // Max concurrent jobs, GLOBALLY, across every process, is `params.queue_size` --
    // and it is NOT set here. It is set in nextflow.config's own `executor { }` block,
    // because this file is included BEFORE that file's params block exists and a
    // `params.queue_size` reference from here is silently parsed as a nested scope,
    // dropping the setting altogether. The full measurement is in the comment above that
    // block; do not "tidy" the assignment back into this file.
    //
    // queue_size is the binding constraint, not `process.maxForks` (= `params.max_forks`,
    // default 100): the executor's queueSize caps total concurrency, so a per-process
    // maxForks above it can never be reached and raising max_forks alone changes nothing.
    // Tune both, or tune queue_size. Its default of 20 is deliberately conservative for a
    // shared scheduler -- raise it with `--queue_size`, or in a site profile
    // (conf/site.config.template), not by editing this file.
    exitReadTimeout = '1 day'    // Timeout for SLURM job status polling
}

/*
========================================================================================
    Notes
========================================================================================

    SLURM Error Codes Handled:
    - 143: SIGTERM (job killed)
    - 137: SIGKILL (out of memory)
    - 104: Connection reset
    - 134: SIGABRT (abort)
    - 139: SIGSEGV (segmentation fault)

    These errors trigger automatic retry (up to maxRetries=3)
========================================================================================
*/
