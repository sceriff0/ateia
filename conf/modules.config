/*
========================================================================================
    Process-specific Resource Configuration
========================================================================================
    Resource allocation for each process.
    Error strategy and maxRetries are inherited from conf/base.config.
========================================================================================
*/

process {

    /*
    ================================================================================
        Default Publishing Settings
    ================================================================================
    */

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: 'copy',
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    /*
    ================================================================================
        Resource Labels (used by processes)
    ================================================================================
    */

    withLabel: 'process_single' {
        cpus   = { 1                   }
        memory = { 12.GB * task.attempt }
        time   = { 8.h  * task.attempt }
    }

    withLabel: 'process_low' {
        cpus   = { 2                     }
        memory = { 32.GB * task.attempt  }
        time   = { 2.h   * task.attempt  }
    }

    withLabel: 'process_medium' {
        cpus   = { 4                               }
        memory = { 100.GB + 100.GB * task.attempt  }
        time   = { 4.h   * task.attempt            }
    }

    withLabel: 'process_high' {
        cpus   = { 8                               }
        memory = { 200.GB + 100.GB * task.attempt  }
        time   = { 12.h  * task.attempt            }
    }

    withLabel: 'process_long' {
        time   = { 48.h  * task.attempt }
    }

    withLabel: 'process_high_memory' {
        memory = { 400.GB * task.attempt }
    }

    withLabel: 'gpu' {
        clusterOptions = '--gres=gpu:1'
        // Bind the host NVIDIA stack into the container. Docker and Singularity
        // use different flags (--gpus all vs --nv); without the right one,
        // torch.cuda.is_available() is False and GPU work silently runs on CPU.
        containerOptions = { workflow.containerEngine == 'docker' ? '--gpus all' : '--nv' }
    }

    withLabel: 'error_ignore' {
        errorStrategy = 'ignore'
    }

    withLabel: 'error_retry' {
        errorStrategy = 'retry'
        maxRetries    = 3
    }

    /*
    ================================================================================
        Pipeline Info
    ================================================================================
    */

    /*
    ================================================================================
        Pipeline Processes
    ================================================================================
    */

    withName: 'CONVERT_IMAGE' {
        cpus   = 1
        memory = {
            def file_gb = (image_file.size() >> 30) ?: 1
            (file_gb < 4 ? 0.GB : file_gb < 12 ? 24.GB : file_gb < 24 ? 48.GB : 64.GB) + 24.GB * task.attempt
        }
        time   = { 2.h  * task.attempt }
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/converted" },
            mode: 'copy',
            pattern: "*.ome.tif",
            overwrite: true
        ]
    }

    withName: 'PREPROCESS' {
        cpus   = { params.preproc_pool_workers ?: 4 }
        memory = { (ome_tiff.size() >> 30 ?: 1) * 7.GB * task.attempt + 8.GB }
        time   = { 3.h * task.attempt }
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/preprocessed" },
            mode: 'copy',
            pattern: "*_corrected.ome.tif",
            overwrite: true
        ]
    }

    withName: 'GENERATE_PREPROCESS_QC' {
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/qc/preprocess" },
            mode: 'copy',
            pattern: "qc/*.png"
        ]
    }

    withName: 'GENERATE_POSTPROCESSING_QC' {
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/qc/postprocessing" },
            mode: 'copy',
            pattern: "qc/*.png"
        ]
    }

    withName: 'GENERATE_QC_REPORT' {
        publishDir = [
            path: { "${params.outdir}/qc" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MAX_DIM' {
        cpus   = 1
        memory = { 2.GB   }
        time   = { 10.min }
    }

    withName: 'REGISTER' {
        cpus   = 8
        memory = {
            300.GB * task.attempt
        }
        time   = { 24.h * task.attempt }
        // Retry on exit 1 (e.g. VALIS tile read failures, JVM OOM) in addition to base signals
        errorStrategy = {
            task.exitStatus in [1, 104, 134, 135, 137, 139, 140, 143] ? 'retry' : 'finish'
        }

        publishDir = [
            [
                path: { "${params.outdir}/${meta.patient_id}/registered" },
                mode: 'copy',
                pattern: "registered_slides/*_registered.ome.tiff",
                overwrite: true
            ],
            [
                path: { "${params.outdir}/${meta.patient_id}/registered/summary" },
                mode: 'copy',
                pattern: "preprocessed/data/*.csv",
                overwrite: true
            ]
        ]
        maxForks = 5
    }

    // Distributed (process-level) tiled non-rigid registration (opt-in, spec §6.6)
    withName: 'REG_PREP' {
        cpus   = 8
        memory = { 64.GB * task.attempt }   // rigid + processed-2-D only; no DeepFlow (low RAM)
        time   = { 12.h * task.attempt }
        publishDir = [ enabled: false ]     // prep/ is an intermediate handoff
    }

    withName: 'REG_TILE' {
        cpus   = 1
        memory = { 4.GB * task.attempt }     // JVM-free per-tile DeepFlow — the cheap-node swarm
        time   = { 2.h * task.attempt }
        maxForks = 50
        publishDir = [ enabled: false ]      // tiles are intermediate
    }

    withName: 'REG_FINALIZE' {
        cpus   = 4
        memory = { 64.GB * task.attempt }    // stitch + streaming full-res warp (bounded RAM)
        time   = { 12.h * task.attempt }
        errorStrategy = {
            task.exitStatus in [1, 104, 134, 135, 137, 139, 140, 143] ? 'retry' : 'finish'
        }
        publishDir = [
            path: { "${params.outdir}/${patient_id}/registered" },
            mode: 'copy',
            pattern: "registered_slides/*_registered.ome.tiff",
            overwrite: true
        ]
        maxForks = 5
    }

    // Default distributed non-rigid path (reg_dist_force_tiling=false): REG_NONRIGID (whole-image,
    // JVM-free) -> REG_FINALIZE_FIELD. Micro wave adds REG_MICRO_PREP -> REG_FINALIZE_MICRO. These
    // finalizers produce the published registered slides, so they need the SAME publishDir/errorStrategy
    // as REG_FINALIZE — otherwise they fall through to the global default publishDir and land in
    // ${outdir}/reg_finalize_field/ (wrong dir, all patients collide, mismatches the checkpoint CSV).
    withName: 'REG_FINALIZE_FIELD|REG_FINALIZE_MICRO' {
        cpus   = 4
        memory = { 64.GB * task.attempt }
        time   = { 12.h * task.attempt }
        errorStrategy = {
            task.exitStatus in [1, 104, 134, 135, 137, 139, 140, 143] ? 'retry' : 'finish'
        }
        publishDir = [
            path: { "${params.outdir}/${patient_id}/registered" },
            mode: 'copy',
            pattern: "registered_slides/*_registered.ome.tiff",
            overwrite: true
        ]
        maxForks = 5
    }

    // Intermediate distributed stages (JVM-free non-rigid + micro prep) — nothing to publish.
    withName: 'REG_NONRIGID|REG_MICRO_PREP' {
        publishDir = [ enabled: false ]
    }

    withName: 'REG_WARP_REF' {
        cpus   = 2
        memory = { 32.GB * task.attempt }
        time   = { 6.h * task.attempt }
        publishDir = [
            path: { "${params.outdir}/${patient_id}/registered" },
            mode: 'copy',
            pattern: "registered_slides/*_registered.ome.tiff",
            overwrite: true
        ]
    }

    // Legacy registration methods (GPU, CPU, tiled) moved to legacy/ directory

    withName: 'GENERATE_REGISTRATION_QC' {
        cpus   = 1
        memory = {
            def input_gb = ((registered.size() + reference.size()) >> 30) ?: 1
            (input_gb < 20 ? 100.GB : input_gb < 50 ? 200.GB : 300.GB) * task.attempt
        }
        publishDir = [
            [
                path: { "${params.outdir}/${meta.patient_id}/qc/registration" },
                mode: 'copy',
                pattern: "qc/*_QC_RGB.{png,tif}"
            ],
            [
                path: { "${params.outdir}/${meta.patient_id}/qc/registration" },
                mode: 'copy',
                pattern: "qc/*_QC_RGB_fullres.tif"
            ]
        ]
    }

    withName: 'MERGE_AND_PYRAMID' {
        cpus   = 2
        memory = {
            def total_gb = ((split_channels.collect { it.size() }.sum() + seg_mask.size()) >> 30) ?: 1
            (total_gb < 20 ? 200.GB : 300.GB) * task.attempt
        }
        time   = { 8.h * task.attempt }

        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/pyramid" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SEGMENT' {
        // 8 CPUs so a CPU path (or CPU-bound pre/post steps like label expansion
        // and Dask tiling) is tolerable; GPU inference is unaffected by this.
        cpus   = 8
        memory = {
            def file_gb = (merged_file.size() >> 30) ?: 1
            (file_gb < 10 ? 32.GB : file_gb < 30 ? 64.GB : 128.GB) * task.attempt
        }
        time   = { 4.h * task.attempt }
        clusterOptions   = { params.seg_gpu ? "--gres=gpu:${params.gpu_type}" : '' }
        // Singularity needs --nv to bind the host NVIDIA driver stack into the
        // container; without it torch.cuda.is_available() is False even when
        // SLURM has granted the GPU via --gres.
        //
        // For the CellSAM backend, also forward DEEPCELL_ACCESS_TOKEN from the
        // launch environment so cellsam_pipeline can auto-download weights when
        // --cellsam_model_path is unset. Docker forwards by name (-e VAR, value
        // stays out of .command.*); Singularity injects it via --env. Only added
        // when the backend is CellSAM and the token is actually set.
        containerOptions = {
            def opts = []
            // Docker and Singularity bind GPUs with different flags. --nv is
            // Singularity-only; Docker needs --gpus all, else the GPU is never
            // mounted and CellSAM silently falls back to CPU (4+ day WSI runs).
            if (params.seg_gpu) opts << (workflow.containerEngine == 'docker' ? '--gpus all' : '--nv')
            if (params.seg_method == 'cellsam' && System.getenv('DEEPCELL_ACCESS_TOKEN')) {
                opts << (workflow.containerEngine == 'docker'
                    ? '-e DEEPCELL_ACCESS_TOKEN'
                    : "--env DEEPCELL_ACCESS_TOKEN=${System.getenv('DEEPCELL_ACCESS_TOKEN')}")
            }
            opts.join(' ')
        }
        // Publish masks where the postprocessing checkpoint CSV records them
        // (postprocess.nf builds ${outdir}/<patient_id>/segmentation/<mask>).
        // Without this explicit rule the default selector would publish to
        // ${outdir}/segment/, so the checkpoint path would point at files that
        // are not there (breaking --start postprocessing resume and lookups).
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/segmentation" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SPLIT_CHANNELS' {
        cpus   = 1
        memory = {
            def file_gb = (registered_image.size() >> 30) ?: 1
            (file_gb < 5 ? 32.GB : file_gb < 15 ? 64.GB : 128.GB) * task.attempt
        }
        time   = { 2.h * task.attempt }
    }

    withName: 'EXTRACT_CELL_PROPERTIES' {
        cpus   = 1
        memory = { 64.GB * task.attempt }
        time   = { 12.h * task.attempt }
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/cell_properties" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'EXTRACT_NUCLEI_PROPERTIES' {
        cpus   = 1
        memory = { 64.GB * task.attempt }
        time   = { 12.h * task.attempt }
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/cell_properties/nuclei" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'QUANTIFY' {
        cpus   = 1
        memory = { 128.GB * task.attempt }
        time   = { 12.h * task.attempt }
        maxForks = 20
        // --expanded adds Median + Sum per compartment (only meaningful with
        // params.quantify_compartments, which routes the nuclear mask in).
        ext.args = { params.expanded_quantification ? '--expanded' : '' }
    }

    withName: 'EXPORT_GEOJSON' {
        cpus   = 1
        memory = { 32.GB * task.attempt }
        time   = { 2.h * task.attempt }
        ext.args = { "--pixel_size ${params.pixel_size ?: 0.325}" }
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/geojson" },
            mode: 'copy',
            overwrite: true
        ]
    }

    /*
    ================================================================================
        Pixie Clustering Processes
    ================================================================================
    */

    // Pixie clustering moved to legacy/ directory

    withName: 'MERGE_QUANT_CSVS' {
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/quantification" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'ESTIMATE_FEATURE_DISTANCES' {
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/feature_distances" },
            mode: 'copy',
            pattern: "*.{json,png}"
        ]
    }

    withName: 'AGGREGATE_SIZE_LOGS' {
        publishDir = [
            path: { "${params.outdir}/size_logs" },
            mode: 'copy'
        ]
    }

}
