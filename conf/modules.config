/*
========================================================================================
    Process-specific Resource Configuration
========================================================================================
    Direct SLURM resource allocation for each process
========================================================================================
*/

process {

    /*
    ================================================================================
        Default Publishing Settings
    ================================================================================
    */

    publishDir = [
        path: { "./results/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: 'copy',
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    /*
    ================================================================================
        Resource Labels (used by processes)
    ================================================================================
    */

    withLabel: 'process_single' {
        cpus   = { check_max( 1                  , 'cpus'   ) }
        memory = { check_max( 12.GB * task.attempt, 'memory' ) }
        time   = { check_max( 8.h  * task.attempt, 'time'   ) }
        errorStrategy = { task.exitStatus in [1, 11, 137, 139, 140] ? 'retry' : 'finish' }
        maxRetries = 3
    }

    withLabel: 'process_low' {
        cpus   =  2
        memory = { check_max( 12.GB * task.attempt, 'memory' ) }
        time   = { check_max( 2.h   * task.attempt, 'time'   ) }
        errorStrategy = { task.exitStatus in [1, 137, 139, 140] ? 'retry' : 'finish' }
        maxRetries = 3
    }

    withLabel: 'process_medium' {
        cpus   = 4
        memory = { check_max( 100.GB + 100.GB * task.attempt, 'memory' ) }
        time   = { check_max( 4.h   * task.attempt, 'time'   ) }
        errorStrategy = { task.exitStatus in [1, 137, 139, 140] ? 'retry' : 'finish' }
        maxRetries = 3
    }

    withLabel: 'process_high' {
        cpus   = 8
        memory = { check_max( 200.GB + 100.GB * task.attempt, 'memory' ) }
        time   = { check_max( 12.h  * task.attempt, 'time'   ) }
        errorStrategy = { task.exitStatus in [1, 137, 139, 140] ? 'retry' : 'finish' }
        maxRetries = 3
    }

    withLabel: 'process_long' {
        time   = { check_max( 48.h  * task.attempt, 'time'   ) }
    }

    withLabel: 'process_high_memory' {
        memory = { check_max( 400.GB * task.attempt, 'memory' ) }
    }

    withLabel: 'gpu' {
        clusterOptions = '--gres=gpu:1'
        containerOptions = '--nv'  // Enable NVIDIA GPU support in Singularity
    }

    withLabel: 'error_ignore' {
        errorStrategy = 'ignore'
    }

    withLabel: 'error_retry' {
        errorStrategy = 'retry'
        maxRetries    = 3
    }

    /*
    ================================================================================
        Pipeline Processes
    ================================================================================
    */

    withName: 'CONVERT_IMAGE' {
        // Dynamic resource allocation — single-threaded tool
        cpus   = 1
        memory = { check_max( 16.GB * task.attempt, 'memory' ) }
        time   = { check_max( 2.h  * task.attempt, 'time'   ) }
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/converted" },
            mode: 'copy',
            pattern: "*.ome.tif",
            overwrite: true
        ]

        errorStrategy = { task.exitStatus in [1, 134, 137, 104, 140, 143] ? 'retry' : 'finish' }
        maxRetries    = 3
    }

    withName: 'PREPROCESS' {
        cpus   = { params.preproc_pool_workers ?: 4 }
        memory = { check_max( 32.GB * task.attempt, 'memory' ) }
        time   = { check_max( 3.h * task.attempt, 'time' ) }
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/preprocessed" },
            mode: 'copy',
            pattern: "*_corrected.ome.tif",
            overwrite: true
        ]

        errorStrategy = { task.exitStatus in [1, 134, 137, 104, 140, 143] ? 'retry' : 'finish' }
        maxRetries    = 3
    }

    withName: 'GENERATE_PREPROCESS_QC' {
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/qc/preprocess" },
            mode: 'copy',
            pattern: "qc/*.png"
        ]
    }

    withName: 'MAX_DIM' {
        cpus   = 1
        memory = '2.GB'
        time   = '10.m'
    }

    withName: 'REGISTER' {
        cpus   = 8
        memory = { check_max( 400.GB  + 100.GB * task.attempt, 'memory' ) }
        time   = { check_max( 48.h * task.attempt, 'time' ) }

        // Smart retry strategy:
        // - Exit 1: General failure (e.g., JVM killed, registration error) -> retry without micro-reg
        // - Exit 137: OOM (SIGKILL) -> retry with more memory AND without micro-reg
        // - Exit 134: SIGABRT -> retry
        // - Exit 104: Connection reset -> retry
        // On retry (attempt 2+), register.nf automatically skips micro-registration
        errorStrategy = { task.exitStatus in [1, 134, 137, 104, 140] ? 'retry' : 'finish' }
        maxRetries    = 3

        publishDir = [
            [
                path: { "${params.outdir}/${meta.patient_id}/registered" },
                mode: 'copy',
                pattern: "registered_slides/*_registered.ome.tiff",
                overwrite: true
            ],
            [
                path: { "${params.outdir}/${meta.patient_id}/registered/summary" },
                mode: 'copy',
                pattern: "preprocessed/data/*.csv",
                overwrite: true
            ]
        ]
        
    }
    withName: 'GPU_REGISTER' {
        cpus   = { check_max( 2 * task.attempt, 'cpus' ) }
        memory = { check_max( 256.GB * task.attempt, 'memory' ) }
        time   = { check_max( 4.h * task.attempt, 'time' ) }
        errorStrategy = { task.exitStatus in [137, 139, 140, 143] ? 'retry' : 'finish' }
        maxRetries    = 3

        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/registered" },
            mode: 'copy',
            pattern: "*_registered.ome.tiff",
            overwrite: true
        ]
    }

    withName: 'CPU_REGISTER' {
        cpus   = { check_max( 16, 'cpus' ) }
        memory = { check_max( 128.GB * task.attempt, 'memory' ) }
        time   = { check_max( 8.h * task.attempt, 'time' ) }
        errorStrategy = { task.exitStatus in [137, 104] ? 'retry' : 'finish' }
        maxRetries    = 2

        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/registered" },
            mode: 'copy',
            pattern: "*_registered.ome.tiff",
            overwrite: true
        ]
    }

    /*
    ================================================================================
        CPU Tiled Registration Processes (memory-efficient two-pass approach)
    ================================================================================
    */

    withName: 'COMPUTE_TILE_PLAN' {
        cpus   = 1
        memory = { check_max( 2.GB * task.attempt, 'memory' ) }
        time   = { check_max( 10.min * task.attempt, 'time' ) }
    }

    withName: 'AFFINE_TILE' {
        cpus   = 1
        memory = { check_max( 20.GB * task.attempt, 'memory' ) }
        time   = { check_max( 20.min * task.attempt, 'time' ) }

        errorStrategy = { task.exitStatus in [137, 139, 140] ? 'retry' : 'finish' }
        maxRetries    = 2
    }

    withName: 'STITCH_AFFINE' {
        cpus   = 1
        memory = { check_max( 32.GB * task.attempt, 'memory' ) }
        time   = { check_max( 1.h * task.attempt, 'time' ) }
    }

    withName: 'DIFFEO_TILE' {
        cpus   = 1
        memory = { check_max( 8.GB * task.attempt, 'memory' ) }
        time   = { check_max( 40.min * task.attempt, 'time' ) }

        errorStrategy = { task.exitStatus in [135, 137, 139, 140] ? 'retry' : 'finish' }
        maxRetries    = 2

        maxForks = 1000
    }

    withName: 'STITCH_DIFFEO' {
        cpus   = 1
        memory = { check_max( 32.GB * task.attempt, 'memory' ) }
        time   = { check_max( 1.h * task.attempt, 'time' ) }

        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/registered" },
            mode: "copy",
            pattern: "*_registered.ome.tiff",
            overwrite: true
        ]
    }

    withName: /PUBLISH_REFERENCE.*/ {
        cpus   = 1
        memory = '2.GB'
        time   = '10.min'

        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/registered" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'GENERATE_REGISTRATION_QC' {
        cpus   = 1
        memory = { check_max( 64.GB * task.attempt, 'memory' ) }
        publishDir = [
            [
                path: { "${params.outdir}/${meta.patient_id}/qc/registration" },
                mode: 'copy',
                pattern: "qc/*_QC_RGB.{png,tif}"
            ],
            [
                path: { "${params.outdir}/${meta.patient_id}/qc/registration" },
                mode: 'copy',
                pattern: "qc/*_QC_RGB_fullres.tif"
            ]
        ]

        errorStrategy = { task.exitStatus in [135, 137, 139, 140] ? 'retry' : 'finish' }
        maxRetries    = 2

    }

    withName: 'MERGE_AND_PYRAMID' {
        cpus   = 2
        memory = { check_max( 128.GB * task.attempt, 'memory' ) }
        time   = { check_max( 8.h * task.attempt, 'time' ) }
        maxRetries = 2

        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/pyramid" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SEGMENT' {
        cpus   = 2
        memory = { check_max( 64.GB * task.attempt, 'memory' ) }
        time   = '4.h'
        // Retry on OOM errors - n_tiles will double on each attempt
        errorStrategy = { task.exitStatus in [1, 137, 139, 140] ? 'retry' : 'finish' }
        maxRetries = 3
        // Automatically adds GPU based on params.seg_gpu
        clusterOptions = { params.seg_gpu ? '--gres=gpu:nvidia_h200:1' : '' }
    }

    withName: 'SPLIT_CHANNELS' {
        cpus   = 1
        memory = { check_max( 24.GB * task.attempt, 'memory' ) }
        time   = { check_max( 2.h * task.attempt, 'time' ) }
    }

    withName: 'QUANTIFY' {
        cpus   = 1
        memory = { check_max( 16.GB * task.attempt, 'memory' ) }
        time   = '12.h'
    }

    withName: 'PHENOTYPE' {
        cpus   = 1
        memory = { check_max( 8.GB * task.attempt, 'memory' ) }
        time   = '2.h'
        errorStrategy = { task.exitStatus == 137 ? 'retry' : 'finish' }
        maxRetries    = 2
    }

    /*
    ================================================================================
        Pixie Clustering Processes
    ================================================================================
    */

    withName: 'PIXIE_PIXEL_CLUSTER' {
        cpus   = 4
        memory = { check_max( 128.GB * task.attempt, 'memory' ) }
        time   = { check_max( 10.h * task.attempt, 'time' ) }
        errorStrategy = { task.exitStatus in [137, 139, 140] ? 'retry' : 'finish' }
        maxRetries    = 2
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/pixie/pixel_clustering" },
            mode: 'copy'
        ]
    }

    withName: 'PIXIE_CELL_CLUSTER' {
        cpus   = 4
        memory = { check_max( 64.GB * task.attempt, 'memory' ) }
        time   = { check_max( 10.h * task.attempt, 'time' ) }
        errorStrategy = { task.exitStatus in [137, 139, 140] ? 'retry' : 'finish' }
        maxRetries    = 2
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/pixie/cell_clustering" },
            mode: 'copy'
        ]
    }

    withName: 'CREATE_PYRAMID' {
        cpus   = 2
        memory = { check_max( 128.GB * task.attempt, 'memory' ) }
        time   = { check_max( 4.h * task.attempt, 'time' ) }
    }

    withName: 'MERGE_QUANT_CSVS' {
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/quantification" },
            mode: "copy",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'ESTIMATE_FEATURE_DISTANCES' {
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/${params.registration_method}/feature_distances" },
            mode: "copy",
            pattern: "*.{json,png}"
        ]
    }

    withName: 'AGGREGATE_SIZE_LOGS' {
        publishDir = [
            path: { "${params.trace_dir}" },
            mode: "copy"
        ]
    }

}
