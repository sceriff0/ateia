/*
========================================================================================
    Process-specific Resource Configuration
========================================================================================
    Resource allocation for each process.
    Error strategy and maxRetries are inherited from conf/base.config.
========================================================================================
*/

process {

    /*
    ================================================================================
        Default Publishing Settings
    ================================================================================
    */

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: { params.publish_dir_mode },
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    /*
    ================================================================================
        Resource Labels (used by processes)
    ================================================================================
    */

    withLabel: 'process_single' {
        cpus   = { ResourceUtils.check_max( 1                  , 'cpus'  , params ) }
        memory = { ResourceUtils.check_max( 12.GB * task.attempt, 'memory', params ) }
        time   = { ResourceUtils.check_max( 8.h  * task.attempt, 'time'  , params ) }
    }

    withLabel: 'process_low' {
        cpus   = { ResourceUtils.check_max( 2                    , 'cpus'  , params ) }
        memory = { ResourceUtils.check_max( 12.GB * task.attempt , 'memory', params ) }
        time   = { ResourceUtils.check_max( 2.h   * task.attempt , 'time'  , params ) }
    }

    withLabel: 'process_medium' {
        cpus   = { ResourceUtils.check_max( 4                              , 'cpus'  , params ) }
        memory = { ResourceUtils.check_max( 100.GB + 100.GB * task.attempt , 'memory', params ) }
        time   = { ResourceUtils.check_max( 4.h   * task.attempt           , 'time'  , params ) }
    }

    withLabel: 'process_high' {
        cpus   = { ResourceUtils.check_max( 8                              , 'cpus'  , params ) }
        memory = { ResourceUtils.check_max( 200.GB + 100.GB * task.attempt , 'memory', params ) }
        time   = { ResourceUtils.check_max( 12.h  * task.attempt           , 'time'  , params ) }
    }

    withLabel: 'process_long' {
        time   = { ResourceUtils.check_max( 48.h  * task.attempt, 'time'  , params ) }
    }

    withLabel: 'process_high_memory' {
        memory = { ResourceUtils.check_max( 400.GB * task.attempt, 'memory', params ) }
    }

    withLabel: 'gpu' {
        clusterOptions = '--gres=gpu:1'
        containerOptions = '--nv'  // Enable NVIDIA GPU support in Singularity
    }

    withLabel: 'error_ignore' {
        errorStrategy = 'ignore'
    }

    withLabel: 'error_retry' {
        errorStrategy = 'retry'
        maxRetries    = 3
    }

    /*
    ================================================================================
        Pipeline Info
    ================================================================================
    */

    /*
    ================================================================================
        Pipeline Processes
    ================================================================================
    */

    withName: 'CONVERT_IMAGE' {
        cpus   = 1
        memory = {
            def file_gb = (image_file.size() >> 30) ?: 1
            ResourceUtils.check_max( (file_gb < 4 ? 0.GB : file_gb < 12 ? 24.GB : file_gb < 24 ? 48.GB : 64.GB) + 24.GB * task.attempt, 'memory', params )
        }
        time   = { ResourceUtils.check_max( 2.h  * task.attempt, 'time'  , params ) }
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/converted" },
            mode: { params.publish_dir_mode },
            pattern: "*.ome.tif",
            overwrite: true
        ]
    }

    withName: 'PREPROCESS' {
        cpus   = { params.preproc_pool_workers ?: 4 }
        memory = { ResourceUtils.check_max( (ome_tiff.size() >> 30 ?: 1) * 7.GB * task.attempt + 8.GB, 'memory', params ) }
        time   = { ResourceUtils.check_max( 3.h * task.attempt, 'time', params ) }
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/preprocessed" },
            mode: { params.publish_dir_mode },
            pattern: "*_corrected.ome.tif",
            overwrite: true
        ]
    }

    withName: 'GENERATE_PREPROCESS_QC' {
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/qc/preprocess" },
            mode: { params.publish_dir_mode },
            pattern: "qc/*.png"
        ]
    }

    withName: 'GENERATE_POSTPROCESSING_QC' {
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/qc/postprocessing" },
            mode: { params.publish_dir_mode },
            pattern: "qc/*.png"
        ]
    }

    withName: 'GENERATE_QC_REPORT' {
        publishDir = [
            path: { "${params.outdir}/qc" },
            mode: 'copy'
        ]
    }

    withName: 'MAX_DIM' {
        cpus   = 1
        memory = { ResourceUtils.check_max( 2.GB  , 'memory', params ) }
        time   = { ResourceUtils.check_max( 10.min, 'time'  , params ) }
    }

    withName: 'REGISTER' {
        cpus   = 8
        memory = {
            ResourceUtils.check_max( 300.GB * task.attempt, 'memory', params )
        }
        time   = { ResourceUtils.check_max( 24.h * task.attempt, 'time', params ) }

        publishDir = [
            [
                path: { "${params.outdir}/${meta.patient_id}/registered" },
                mode: { params.publish_dir_mode },
                pattern: "registered_slides/*_registered.ome.tiff",
                overwrite: true
            ],
            [
                path: { "${params.outdir}/${meta.patient_id}/registered/summary" },
                mode: { params.publish_dir_mode },
                pattern: "preprocessed/data/*.csv",
                overwrite: true
            ]
        ]
        maxForks = 5
    }

    // Legacy registration methods (GPU, CPU, tiled) moved to legacy/ directory

    withName: /PUBLISH_REFERENCE.*/ {
        cpus   = 1
        memory = { ResourceUtils.check_max( 2.GB  , 'memory', params ) }
        time   = { ResourceUtils.check_max( 10.min, 'time'  , params ) }

        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/registered" },
            mode: { params.publish_dir_mode },
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'GENERATE_REGISTRATION_QC' {
        cpus   = 1
        memory = {
            def input_gb = ((registered.size() + reference.size()) >> 30) ?: 1
            ResourceUtils.check_max( (input_gb < 20 ? 64.GB : input_gb < 50 ? 128.GB : 256.GB) * task.attempt, 'memory', params )
        }
        publishDir = [
            [
                path: { "${params.outdir}/${meta.patient_id}/qc/registration" },
                mode: { params.publish_dir_mode },
                pattern: "qc/*_QC_RGB.{png,tif}"
            ],
            [
                path: { "${params.outdir}/${meta.patient_id}/qc/registration" },
                mode: { params.publish_dir_mode },
                pattern: "qc/*_QC_RGB_fullres.tif"
            ]
        ]
    }

    withName: 'MERGE_AND_PYRAMID' {
        cpus   = 2
        memory = {
            def total_gb = ((split_channels.collect { it.size() }.sum() + seg_mask.size()) >> 30) ?: 1
            ResourceUtils.check_max( (total_gb < 20 ? 200.GB : 300.GB) * task.attempt, 'memory', params )
        }
        time   = { ResourceUtils.check_max( 8.h * task.attempt, 'time', params ) }

        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/pyramid" },
            mode: { params.publish_dir_mode },
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SEGMENT' {
        cpus   = 2
        memory = {
            def file_gb = (merged_file.size() >> 30) ?: 1
            ResourceUtils.check_max( (file_gb < 10 ? 32.GB : file_gb < 30 ? 64.GB : 128.GB) * task.attempt, 'memory', params )
        }
        time   = { ResourceUtils.check_max( 4.h * task.attempt, 'time', params ) }
        clusterOptions = { params.seg_gpu ? "--gres=gpu:${params.gpu_type}" : '' }
    }

    withName: 'SPLIT_CHANNELS' {
        cpus   = 1
        memory = {
            def file_gb = (registered_image.size() >> 30) ?: 1
            ResourceUtils.check_max( (file_gb < 5 ? 32.GB : file_gb < 15 ? 64.GB : 128.GB) * task.attempt, 'memory', params )
        }
        time   = { ResourceUtils.check_max( 2.h * task.attempt, 'time', params ) }
    }

    withName: 'EXTRACT_CELL_PROPERTIES' {
        cpus   = 1
        memory = { ResourceUtils.check_max( 64.GB * task.attempt, 'memory', params ) }
        time   = { ResourceUtils.check_max( 12.h * task.attempt, 'time', params ) }
        ext.args = { "--min_area ${params.quant_min_area}" }

        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/cell_properties" },
            mode: { params.publish_dir_mode },
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'QUANTIFY' {
        cpus   = 1
        memory = { ResourceUtils.check_max( 128.GB * task.attempt, 'memory', params ) }
        time   = { ResourceUtils.check_max( 12.h * task.attempt, 'time', params ) }
        maxForks = 20
        ext.args = { "--min_area ${params.quant_min_area}" }
    }

    withName: 'EXPORT_GEOJSON' {
        cpus   = 1
        memory = { ResourceUtils.check_max( 16.GB * task.attempt, 'memory', params ) }
        time   = { ResourceUtils.check_max( 2.h * task.attempt, 'time', params ) }
        ext.args = { "--pixel_size ${params.pixel_size ?: 0.325}" }
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/geojson" },
            mode: { params.publish_dir_mode },
            overwrite: true
        ]
    }

    /*
    ================================================================================
        Pixie Clustering Processes
    ================================================================================
    */

    // Pixie clustering moved to legacy/ directory

    withName: 'CREATE_PYRAMID' {
        cpus   = 2
        memory = { ResourceUtils.check_max( 128.GB * task.attempt, 'memory', params ) }
        time   = { ResourceUtils.check_max( 4.h * task.attempt, 'time', params ) }
    }

    withName: 'MERGE_QUANT_CSVS' {
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/quantification" },
            mode: { params.publish_dir_mode },
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'ESTIMATE_FEATURE_DISTANCES' {
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/feature_distances" },
            mode: { params.publish_dir_mode },
            pattern: "*.{json,png}"
        ]
    }

    withName: 'AGGREGATE_SIZE_LOGS' {
        publishDir = [
            path: { "${params.outdir}/size_logs" },
            mode: { params.publish_dir_mode }
        ]
    }

}
