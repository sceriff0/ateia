/*
========================================================================================
    Process-specific Resource Configuration
========================================================================================
    Resource allocation for each process.
    Error strategy and maxRetries are inherited from conf/base.config.
========================================================================================
*/

process {

    /*
    ================================================================================
        Default Publishing Settings
    ================================================================================
    */

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: 'copy',
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    /*
    ================================================================================
        Resource Labels (used by processes)
    ================================================================================
    */

    withLabel: 'process_single' {
        cpus   = { 1                   }
        memory = { 12.GB * task.attempt }
        time   = { 8.h  * task.attempt }
    }

    withLabel: 'process_low' {
        cpus   = { 2                     }
        memory = { 32.GB * task.attempt  }
        time   = { 2.h   * task.attempt  }
    }

    withLabel: 'process_medium' {
        cpus   = { 4                               }
        memory = { 100.GB + 100.GB * task.attempt  }
        time   = { 4.h   * task.attempt            }
    }

    withLabel: 'process_high' {
        cpus   = { 8                               }
        memory = { 200.GB + 100.GB * task.attempt  }
        time   = { 12.h  * task.attempt            }
    }

    /*
    ================================================================================
        Pipeline Info
    ================================================================================
    */

    /*
    ================================================================================
        QC is non-gating: a broken QC step must never stop the run
    ================================================================================
        QC outputs are informational (visual anchors, seg-quality metrics, the
        HTML report) and are aggregated downstream purely via collect()/collectFile()/
        combine()/join(), none of which require a fixed item count — so a missing QC
        output is simply absent and never deadlocks the DAG. Policy for every QC
        process: retry transient/resource failures (same signal set as base.config,
        so an OOM still climbs its memory ramp) up to maxRetries, then fall back to
        'ignore' instead of 'finish'; any non-transient failure is ignored at once.

        maxRetries is pinned here (not inherited) so the closure's retry cutoff stays
        in lockstep with the budget on every profile — a dynamic strategy that returns
        'retry' after the budget is exhausted is treated as fatal, which is exactly
        what we must avoid. This withName selector overrides the global process-level
        errorStrategy/maxRetries set in base.config and the test configs.
    */
    withName: 'GENERATE_PREPROCESS_QC|GENERATE_REGISTRATION_QC|GENERATE_POSTPROCESSING_QC|GENERATE_QC_REPORT|SEG_QC_GEOJSON|WARP_SEG_QC|WARP_SEG_QC_TILED' {
        maxRetries    = 3
        // 130..145 is the whole "killed by a signal" range (nf-core's convention), not a
        // hand-picked subset. The observed WARP_SEG_QC kill was 140 = 128+12 = SIGUSR2 —
        // SLURM's pre-walltime warning, NOT the SIGTERM the old comment claimed. Anything
        // outside the enumerated set used to be ignored on attempt 1, so a SIGXCPU (152 is
        // out of range, but 138/141/142 are not) threw away the whole retry budget.
        errorStrategy = { task.exitStatus in ((130..145) + 104) && task.attempt <= 3 ? 'retry' : 'ignore' }
    }

    /*
    ================================================================================
        Pipeline Processes
    ================================================================================
    */

    withName: 'CONVERT_IMAGE' {
        cpus   = 1
        memory = {
            def file_gb = (image_file.size() >> 30) ?: 1
            (file_gb < 4 ? 0.GB : file_gb < 12 ? 24.GB : file_gb < 24 ? 48.GB : 64.GB) + 24.GB * task.attempt
        }
        time   = { 2.h  * task.attempt }
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/converted" },
            mode: 'copy',
            pattern: "*.ome.tif",
            overwrite: true
        ]
    }

    withName: 'PREPROCESS' {
        cpus   = { params.preproc_pool_workers ?: 4 }
        memory = { (ome_tiff.size() >> 30 ?: 1) * 7.GB * task.attempt + 8.GB }
        time   = { 3.h * task.attempt }
        ext.args = ''
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/preprocessed" },
            mode: 'copy',
            pattern: "*_corrected.ome.tif",
            overwrite: true
        ]
    }

    withName: 'GENERATE_PREPROCESS_QC' {
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/qc/preprocess" },
            mode: 'copy',
            pattern: "qc/*.png"
        ]
    }

    withName: 'GENERATE_POSTPROCESSING_QC' {
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/qc/postprocessing" },
            mode: 'copy',
            pattern: "qc/*.png"
        ]
    }

    withName: 'GENERATE_QC_REPORT' {
        publishDir = [
            path: { "${params.outdir}/qc" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'REGISTER' {
        cpus   = 8
        memory = {
            300.GB * task.attempt
        }
        time   = { 24.h * task.attempt }
        // Retry on exit 1 (e.g. VALIS tile read failures, JVM OOM) in addition to base signals
        errorStrategy = {
            task.exitStatus in [1, 104, 134, 135, 137, 139, 140, 143] ? 'retry' : 'finish'
        }

        publishDir = [
            [
                path: { "${params.outdir}/${meta.patient_id}/registered" },
                mode: 'copy',
                pattern: "registered_slides/*_registered.ome.tiff",
                overwrite: true
            ],
            [
                path: { "${params.outdir}/${meta.patient_id}/registered/summary" },
                mode: 'copy',
                pattern: "preprocessed/data/*.csv",
                overwrite: true
            ]
        ]
        maxForks = 10
    }

    // Distributed/tiled registration process configs (REG_PREP, REG_TILE, REG_NONRIGID,
    // REG_MICRO_PREP, REG_COMPOSE_*, REG_GRID, REG_WARP_TILE, REG_ASSEMBLE, COMPARE_REGISTRATION)
    // were archived on 2026-07-24 (git tag archive/tiled-valis-2026-07-24).

    // TILED_REGISTER (STARE) — the new fully-parallel, JVM-free method (registration_method='tiled').
    withName: 'TILED_REGISTER' {
        // JVM-free and tile-streamed, so a few GB suffices even for large slides — far below the
        // VALIS process_medium default. Kept low so laptop / low-end nodes can run it.
        memory = { 8.GB * task.attempt }
        publishDir = [
            [
                path: { "${params.outdir}/${meta.patient_id}/registered" },
                mode: 'copy',
                pattern: "registered/*_registered.ome.tiff",
                overwrite: true
            ],
            [
                path: { "${params.outdir}/${meta.patient_id}/registered/manifest" },
                mode: 'copy',
                pattern: "*_manifest.json",
                overwrite: true
            ],
            [
                path: { "${params.outdir}/${meta.patient_id}/qc/registration" },
                mode: 'copy',
                pattern: "*_tre.json",
                overwrite: true
            ]
        ]
        maxForks = 10
    }

    // TILED fan-out processes (reg_tiled_fanout=true) — all JVM-free and per-tile/per-slide light.
    withName: 'TILED_COARSE|TILED_REG_TILE' {
        memory = { 8.GB * task.attempt }
        maxForks = 20
    }
    withName: 'TILED_SOLVE' {
        memory = { 4.GB * task.attempt }   // kilobytes of control points — a tiny reduction
        publishDir = [
            [
                path: { "${params.outdir}/${meta.patient_id}/registered/manifest" },
                mode: 'copy',
                pattern: "*_manifest.json",
                overwrite: true
            ],
            [
                path: { "${params.outdir}/${meta.patient_id}/qc/registration" },
                mode: 'copy',
                pattern: "*_tre.json",
                overwrite: true
            ]
        ]
    }
    withName: 'TILED_STITCH' {
        memory = { 8.GB * task.attempt }   // row-strip warp: peak memory is one strip
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/registered" },
            mode: 'copy',
            pattern: "registered/*_registered.ome.tiff",
            overwrite: true
        ]
        maxForks = 10
    }

    withName: 'GENERATE_REGISTRATION_QC' {
        cpus   = 1
        memory = {
            def input_gb = ((registered.size() + reference.size()) >> 30) ?: 1
            (input_gb < 20 ? 100.GB : input_gb < 50 ? 200.GB : 300.GB) * task.attempt
        }
        publishDir = [
            [
                path: { "${params.outdir}/${meta.patient_id}/qc/registration" },
                mode: 'copy',
                pattern: "qc/*_QC_RGB.{png,tif}"
            ],
            [
                path: { "${params.outdir}/${meta.patient_id}/qc/registration" },
                mode: 'copy',
                pattern: "qc/*_QC_RGB_fullres.tif"
            ]
        ]
    }

    // reg_qc=2 GeoJSON path: native-slide StarDist segmentation -> cell GeoJSON.
    withName: 'SEG_QC_GEOJSON' {
        cpus   = 8
        memory = {
            def file_gb = (image.size() >> 30) ?: 1
            (file_gb < 10 ? 32.GB : file_gb < 30 ? 64.GB : 128.GB) * task.attempt
        }
        time   = { 4.h * task.attempt }
        clusterOptions = { params.seg_gpu ? "--gres=gpu:${params.gpu_type}" : '' }
        // Singularity needs --nv (Docker --gpus all) to expose the GPU to StarDist.
        containerOptions = {
            params.seg_gpu ? (workflow.containerEngine == 'docker' ? '--gpus all' : '--nv') : ''
        }
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/qc/registration/geojson" },
            mode: 'copy',
            pattern: "*.geojson"
        ]
    }

    // reg_qc=2 GeoJSON path: warp cell polygons through each registration stage and score the
    // same, fixed cell pairs at every one.
    //
    // Exit-140 history, and why it is over. This task used to rasterize both slides' polygons
    // onto a shared whole-slide label grid (10^9-10^10 px), so peak RAM was linear in slide
    // area: 19 GB for a 60k x 40k slide, in two uint32 images. Three attempts to buy out of
    // that (16 GB/2 h, then 32 GB/6 h, then 128 GB + a --max-raster-px cap) all treated the
    // symptom; a resource ramp can only postpone a cost that scales with the input.
    //
    // The staged design removed the cause. Correspondence is fixed at the rigid stage, so IoU
    // is computed per pair inside each pair's own bounding-box window — peak RAM is ONE
    // NUCLEUS, a few thousand pixels, no matter how large the slide. Nothing in this process
    // scales with slide area any more. What remains is fixed overhead: the BioFormats JVM heap
    // (8 GB, pinned below), the valis import (~2 GB), and the flattened vertex arrays for the
    // two native GeoJSONs plus one stage (~1.5 GB at 10^6 cells x 50 vertices). 32 GB is
    // therefore generous rather than tight, and the ramp exists only for pathological inputs.
    //
    // Runtime is now the binding constraint, not memory: scoring is a Python loop over pairs
    // (~150 µs each), so 10^6 cells x 4 stages is on the order of 10 minutes.
    withName: 'WARP_SEG_QC' {
        cpus   = 2
        memory = { 32.GB * (2 ** (task.attempt - 1)) }   // 32 / 64 / 128 / 256
        time   = { 3.h * task.attempt }                   // 3 / 6 / 9 / 12 h
        // --jvm-heap-gb is explicit: WARP_SEG_QC stages no TIFFs, so the auto-sizer in
        // valis_config.init_jvm always fell through to its 8 GB floor. Pinning it makes the
        // reservation a decision instead of an accident of the input-directory scan.
        ext.args = '--jvm-heap-gb 8'
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/qc/registration" },
            mode: 'copy',
            pattern: "*_seg_qc.json"
        ]
    }

    // Tiled (STARE) reg_qc=2 seg-QC — JVM-free, so no BioFormats heap and a low memory ceiling.
    withName: 'WARP_SEG_QC_TILED' {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = { 2.h * task.attempt }
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/qc/registration" },
            mode: 'copy',
            pattern: "*_seg_qc.json"
        ]
    }

    // NOTE: mode=add_cycle reuses EXPORT_GEOJSON / MERGE_AND_PYRAMID / MERGE_QUANT_CSVS
    // publishDir rules below. Run add_cycle with a fresh --outdir; combined outputs
    // (all cycles) are written there, leaving the prior run's outdir intact as the
    // --prior_outdir checkpoint source.
    withName: 'MERGE_AND_PYRAMID' {
        cpus   = 2
        memory = {
            def mask_bytes = mask_files ? mask_files.collect { it.size() }.sum() : 0
            def total_gb = ((split_channels.collect { it.size() }.sum() + mask_bytes) >> 30) ?: 1
            (total_gb < 20 ? 200.GB : 300.GB) * task.attempt
        }
        time   = { 8.h * task.attempt }

        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/pyramid" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SEGMENT' {
        // 8 CPUs so a CPU path (or CPU-bound pre/post steps like label expansion
        // and Dask tiling) is tolerable; GPU inference is unaffected by this.
        cpus   = 8
        memory = {
            def file_gb = (merged_file.size() >> 30) ?: 1
            (file_gb < 10 ? 32.GB : file_gb < 30 ? 64.GB : 128.GB) * task.attempt
        }
        time   = { 4.h * task.attempt }
        clusterOptions   = { params.seg_gpu ? "--gres=gpu:${params.gpu_type}" : '' }
        // Singularity needs --nv to bind the host NVIDIA driver stack into the
        // container; without it torch.cuda.is_available() is False even when
        // SLURM has granted the GPU via --gres.
        //
        // For the CellSAM backend, also forward DEEPCELL_ACCESS_TOKEN from the
        // launch environment so cellsam_pipeline can auto-download weights when
        // --cellsam_model_path is unset. Both engines forward by NAME only --
        // the value itself is never interpolated into containerOptions, so it
        // never lands in the work dir's .command.run (group-readable on a
        // typical shared HPC filesystem, and retained across -resume).
        // Docker: '-e VAR' reads the value from the launching shell's
        // environment at run time. Singularity: singularity.envWhitelist
        // (nextflow.config, 'singularity' profile) does the equivalent --
        // contributes nothing here. Only added when the backend is CellSAM
        // and the token is actually set.
        containerOptions = {
            def opts = []
            // Docker and Singularity bind GPUs with different flags. --nv is
            // Singularity-only; Docker needs --gpus all, else the GPU is never
            // mounted and CellSAM silently falls back to CPU (4+ day WSI runs).
            if (params.seg_gpu) opts << (workflow.containerEngine == 'docker' ? '--gpus all' : '--nv')
            if (params.seg_method == 'cellsam' && workflow.containerEngine == 'docker' && System.getenv('DEEPCELL_ACCESS_TOKEN')) {
                opts << '-e DEEPCELL_ACCESS_TOKEN'
            }
            opts.join(' ')
        }
        // Publish masks where the postprocessing checkpoint CSV records them
        // (postprocess.nf builds ${outdir}/<patient_id>/segmentation/<mask>).
        // Without this explicit rule the default selector would publish to
        // ${outdir}/segment/, so the checkpoint path would point at files that
        // are not there (breaking --start postprocessing resume and lookups).
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/segmentation" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SPLIT_CHANNELS' {
        cpus   = 1
        memory = {
            def file_gb = (registered_image.size() >> 30) ?: 1
            (file_gb < 5 ? 32.GB : file_gb < 15 ? 64.GB : 128.GB) * task.attempt
        }
        time   = { 2.h * task.attempt }
    }

    withName: 'EXTRACT_CELL_PROPERTIES' {
        cpus   = 1
        memory = { 64.GB * task.attempt }
        time   = { 12.h * task.attempt }
        // Slimmer GeoJSON defaults (smaller file = faster QuPath import). The exported
        // polygon is display-only — all quantification is mask-derived — so simplifying
        // it and dropping sub-pixel coordinate precision does not affect analysis.
        ext.args = { "--simplify_tolerance ${params.simplify_tolerance} --coord_precision ${params.geojson_coord_precision}" }
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/cell_properties" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'EXTRACT_NUCLEI_PROPERTIES' {
        cpus   = 1
        memory = { 64.GB * task.attempt }
        time   = { 12.h * task.attempt }
        // Same slimmer contour settings for the nucleus polygons.
        ext.args = { "--simplify_tolerance ${params.simplify_tolerance} --coord_precision ${params.geojson_coord_precision}" }
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/cell_properties/nuclei" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'QUANTIFY' {
        cpus   = 1
        memory = { 128.GB * task.attempt }
        time   = { 12.h * task.attempt }
        // Median is always computed (the default statistic). --expanded adds Mean +
        // Sum per compartment on top; independent of quantify_compartments (which
        // only controls whether the nuclear mask is routed in for Nucleus/Cytoplasm).
        ext.args = { params.expanded_quantification ? '--expanded' : '' }
    }

    withName: 'EXPORT_GEOJSON' {
        cpus   = 1
        memory = { 32.GB * task.attempt }
        time   = { 2.h * task.attempt }
        ext.args = { "--pixel_size ${params.pixel_size}" }
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/geojson" },
            mode: 'copy',
            overwrite: true
        ]
    }

    withName: 'EXPORT_SPATIALDATA' {
        // The .zarr is a directory and the process already emits it under
        // `spatialdata/`, so publish at the patient root — otherwise the path
        // double-nests to <patient>/spatialdata/spatialdata/<id>.zarr.
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}" },
            mode: 'copy',
            pattern: "spatialdata/**"
        ]
        time   = { 4.h * task.attempt }
    }

    /*
    ================================================================================
        Pixie Clustering Processes
    ================================================================================
    */

    withName: 'MERGE_QUANT_CSVS' {
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/quantification" },
            mode: 'copy',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    /*
        NOTE: this is the one publishDir override in this file WITHOUT the
        `saveAs: { filename -> filename.equals('versions.yml') ? null : filename }`
        clause that the default block (:18-22) and every other override carry, so
        `<outdir>/size_logs/versions.yml` is genuinely published. Its only content is
        the emitting process's fully-qualified name, which means this block is what
        makes AGGREGATE_SIZE_LOGS' position in the workflow graph USER-VISIBLE: when
        the call moved into subworkflows/local/final_qc.nf, the published key changed
        from "MIRAGE:AGGREGATE_SIZE_LOGS" to "MIRAGE:FINAL_QC:AGGREGATE_SIZE_LOGS".
        Left as-is deliberately: adding the saveAs would align this block with the
        convention but would DELETE a file that ships today, and removing a published
        artifact is a bigger behaviour change than the diagnostic string inside it.
    */
    withName: 'AGGREGATE_SIZE_LOGS' {
        publishDir = [
            path: { "${params.outdir}/size_logs" },
            mode: 'copy'
        ]
    }

    withName: 'COMPILE_PANEL' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 30.min * task.attempt }
        ext.args = { "--alpha-target ${params.pheno_alpha} --min-calibration ${params.pheno_min_cal} --max-enumerate ${params.pheno_max_enumerate}" }
        publishDir = [
            path: { "${params.outdir}/phenotyping" },
            mode: 'copy',
            pattern: "{model_config.json,spec_report.html}"
        ]
    }

    withName: 'PHENOTYPE' {
        cpus   = 4
        memory = { 32.GB * task.attempt }
        time   = { 4.h * task.attempt }
        ext.args = { "--alpha-target ${params.pheno_alpha} --min-calibration ${params.pheno_min_cal}" }
        publishDir = [
            path: { "${params.outdir}/${meta.patient_id}/phenotyping" },
            mode: 'copy',
            pattern: "{phenotypes.csv,constraint_audit.csv,phenotype_qc.json}"
        ]
    }

}
