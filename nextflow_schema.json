{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "MIRAGE WSI Processing Pipeline Parameters",
    "description": "Schema synchronized with nextflow.config canonical params surface.",
    "type": "object",
    "$defs": {
        "input_output_options": {
            "title": "Input/output options",
            "type": "object",
            "required": [
                "start",
                "input",
                "outdir"
            ],
            "properties": {
                "input": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Path to input samplesheet or directory.",
                    "default": null
                },
                "outdir": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Output directory for pipeline results.",
                    "default": null
                },
                "start": {
                    "type": "string",
                    "description": "Pipeline step to start from.",
                    "default": "preprocessing",
                    "enum": [
                        "preprocessing",
                        "registration",
                        "segmentation",
                        "postprocessing"
                    ]
                },
                "stop": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Pipeline step to stop after. If null, runs to the end.",
                    "default": null,
                    "enum": [
                        "preprocessing",
                        "registration",
                        "segmentation",
                        "postprocessing",
                        null
                    ]
                },
                "mode": {
                    "type": "string",
                    "description": "Execution mode. 'standard' runs the linear start/stop step flow; 'add_cycle' rejects --start/--stop (it runs a fixed path from the new-cycle samplesheet through export) to fold a new imaging cycle into a completed patient run (requires --prior_outdir).",
                    "default": "standard",
                    "enum": [
                        "standard",
                        "add_cycle"
                    ]
                },
                "prior_outdir": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "For mode='add_cycle': the --outdir of the previously completed run, containing csv/registered.csv and csv/postprocessed.csv checkpoints to reuse.",
                    "default": null
                }
            }
        },
        "preprocessing_options": {
            "title": "Preprocessing options",
            "type": "object",
            "properties": {
                "skip_preprocessing": {
                    "type": "boolean",
                    "description": "Skip BaSiC illumination correction entirely. Images are still converted to standardised OME-TIFF; the preprocessed checkpoint then records the converted image.",
                    "default": false
                },
                "preproc_skip_nuclear": {
                    "type": "boolean",
                    "description": "Skip BaSiC correction on the nuclear/fiducial channels named by nuclear_markers. Those channels drive registration and segmentation, so correcting them changes what both consume.",
                    "default": true
                },
                "preproc_tile_size": {
                    "type": "integer",
                    "description": "BaSiC FOV tile size in pixels.",
                    "default": 1950,
                    "minimum": 1
                },
                "preprocess_qc_scale_factor": {
                    "type": "number",
                    "description": "Scale factor for preprocessing QC images.",
                    "default": 0.25
                },
                "skip_preprocess_qc": {
                    "type": "boolean",
                    "description": "Skip preprocessing quality control image generation.",
                    "default": false
                },
                "pixel_size": {
                    "type": "number",
                    "description": "Pixel size in micrometers.",
                    "default": 0.325
                }
            }
        },
        "registration_options": {
            "title": "Registration options",
            "type": "object",
            "properties": {
                "registration_method": {
                    "type": "string",
                    "description": "Registration backend: 'valis' (VALIS graph-based whole-slide) or 'tiled' (STARE: JVM-free, internally tiled, fully parallel). See lib/ParamUtils.groovy.",
                    "default": "valis",
                    "enum": [
                        "valis",
                        "tiled"
                    ]
                },
                "nuclear_markers": {
                    "type": ["array", "string"],
                    "description": "Ordered preference of nuclear/fiducial marker names; the first present (resolved from channel metadata, never the filename) is moved to channel 0 and drives both cell segmentation and the registration fiducial. Accepts a list (config/params file) or a comma- or space-separated string, which is the only shape Nextflow can produce for `--nuclear_markers CELLTOX` on the command line; MarkerUtils.markerList normalises both.",
                    "default": [
                        "DAPI",
                        "CELLTOX"
                    ]
                },
                "skip_registration_qc": {
                    "type": "boolean",
                    "description": "Skip registration quality control (legacy; equivalent to reg_qc=0).",
                    "default": false
                },
                "reg_qc": {
                    "type": "integer",
                    "description": "Registration QC depth: 0=none, 1=DAPI overlay only, 2=DAPI overlay + segmentation-overlap metric (Dice/IoU/instance-F1).",
                    "default": 2,
                    "enum": [
                        0,
                        1,
                        2
                    ]
                },
                "qc_scale_factor": {
                    "type": "number",
                    "description": "Scale factor for registration QC images.",
                    "default": 0.25
                },
                "reg_micro_reg_fraction": {
                    "type": "number",
                    "description": "Fraction for micro registration.",
                    "default": 0.125
                },
                "reg_max_image_dim": {
                    "type": "integer",
                    "description": "Maximum image dimension for registration.",
                    "default": 4000
                },
                "memory_mode": {
                    "type": "string",
                    "description": "Memory mode for registration.",
                    "default": "high",
                    "enum": [
                        "low",
                        "medium",
                        "high"
                    ]
                },
                "reg_micro_reg": {
                    "type": "integer",
                    "description": "Micro-registration depth (nested, default MAX): 0=none, 1=micro-rigid only (refines slide.M), 2=+micro non-rigid (register_micro).",
                    "default": 2,
                    "enum": [
                        0,
                        1,
                        2
                    ]
                },
                "allow_auto_reference": {
                    "type": "boolean",
                    "description": "Allow automatic reference selection: when a patient has no is_reference=true row, promote its FIRST samplesheet row. Applies at --start preprocessing ONLY -- at a later entry point the samplesheet is a checkpoint CSV this pipeline wrote, which already names the reference, and inferring one there would silently register against a different slide than the run that produced the checkpoint.",
                    "default": false
                },
                "reg_jvm_heap_gb": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "description": "JVM heap (GiB) for VALIS/Bio-Formats in REGISTER. null = derive from task.memory at runtime.",
                    "default": null
                },
                "reg_tiled_nuclear_index": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "description": "STARE (registration_method=tiled) only: nuclear/fiducial channel index used to estimate the transform. null = resolve from channel metadata against nuclear_markers.",
                    "default": null,
                    "minimum": 0
                },
                "reg_tiled_tile": {
                    "type": "integer",
                    "description": "STARE only: tile core size (px); also the mesh-grid resolution.",
                    "default": 2048,
                    "minimum": 16
                },
                "reg_tiled_halo": {
                    "type": "integer",
                    "description": "STARE only: per-tile read halo (px) for registration context.",
                    "default": 256,
                    "minimum": 0
                },
                "reg_tiled_gate_tre": {
                    "type": "number",
                    "description": "STARE only: refine only tiles whose rigid-stage TRE (px) exceeds this.",
                    "default": 1.0,
                    "minimum": 0
                },
                "reg_tiled_upsample": {
                    "type": "integer",
                    "description": "STARE only: phase-correlation sub-pixel upsample factor (per tile).",
                    "default": 10,
                    "minimum": 1
                },
                "reg_tiled_out_tile": {
                    "type": "integer",
                    "description": "STARE only: streaming stitch write-tile size (px), gigapixel-safe.",
                    "default": 1024,
                    "minimum": 16,
                    "multipleOf": 16
                },
                "reg_tiled_coarse_max_dim": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "STARE only: longest side (px) of the thumbnail the coarse anchor (M0) is estimated on. Bounds COARSE memory independently of slide size; 0 disables decimation.",
                    "default": 4096
                }
            }
        },
        "segmentation_options": {
            "title": "Segmentation options",
            "type": "object",
            "properties": {
                "seg_gpu": {
                    "type": "boolean",
                    "description": "Use GPU for segmentation.",
                    "default": true
                },
                "seg_pmin": {
                    "type": "number",
                    "description": "Minimum percentile for segmentation normalization.",
                    "default": 1.0
                },
                "seg_pmax": {
                    "type": "number",
                    "description": "Maximum percentile for segmentation normalization.",
                    "default": 99.8
                },
                "seg_n_tiles_y": {
                    "type": "integer",
                    "description": "Number of tiles in Y direction for segmentation.",
                    "default": 16
                },
                "seg_n_tiles_x": {
                    "type": "integer",
                    "description": "Number of tiles in X direction for segmentation.",
                    "default": 16
                },
                "seg_expand_distance": {
                    "type": "integer",
                    "description": "Expansion distance for segmentation labels.",
                    "default": 10
                },
                "segmentation_model": {
                    "type": "string",
                    "description": "Name of the segmentation model.",
                    "default": "stardist_full_e200_lr00001_aug1_seed10_es50p0.001_rlr0.5p50"
                },
                "segmentation_model_dir": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Directory containing segmentation models.",
                    "default": null
                },
                "seg_method": {
                    "type": "string",
                    "description": "Segmentation backend to use. 'instantseg' (default) runs without extra assets; 'stardist' requires a trained model via segmentation_model_dir unless segmentation_model names a StarDist built-in.",
                    "default": "instantseg",
                    "enum": [
                        "stardist",
                        "instantseg",
                        "cellsam"
                    ]
                },
                "seg_prob_thresh": {
                    "type": [
                        "number",
                        "null"
                    ],
                    "description": "StarDist detection probability threshold. null = use the model's built-in default.",
                    "default": null
                },
                "seg_instantseg_model": {
                    "type": "string",
                    "description": "InstanSeg model name (only used when seg_method='instantseg').",
                    "default": "fluorescence_nuclei_and_cells"
                },
                "seg_instantseg_target": {
                    "type": "string",
                    "description": "InstanSeg output target.",
                    "default": "all_outputs",
                    "enum": [
                        "all_outputs",
                        "cells",
                        "nuclei"
                    ]
                },
                "seg_instantseg_tile_size": {
                    "type": "integer",
                    "description": "Tile size (px) for InstanSeg tiled inference.",
                    "default": 512
                },
                "seg_instantseg_batch_size": {
                    "type": "integer",
                    "description": "Number of tiles per InstanSeg forward pass.",
                    "default": 16
                },
                "instanseg_model_dir": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Writable host path for InstanSeg's BioImage.IO model cache. null = per-task work-dir cache.",
                    "default": null
                },
                "seg_cellsam_bbox_threshold": {
                    "type": "number",
                    "description": "CellSAM bounding-box confidence threshold (precision/recall knob).",
                    "default": 0.4
                },
                "seg_cellsam_use_wsi": {
                    "type": "boolean",
                    "description": "Enable CellSAM native tiling (block_size/overlap) for large images.",
                    "default": true
                },
                "seg_cellsam_block_size": {
                    "type": "integer",
                    "description": "CellSAM tiling block size (px).",
                    "default": 1024
                },
                "seg_cellsam_overlap": {
                    "type": "integer",
                    "description": "CellSAM tiling overlap (px).",
                    "default": 56
                },
                "cellsam_model_path": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Path to pre-downloaded CellSAM weights for offline/container use. null = auto-download at runtime.",
                    "default": null
                }
            }
        },
        "quantification_options": {
            "title": "Quantification options",
            "type": "object",
            "properties": {
                "quantify_compartments": {
                    "type": "boolean",
                    "description": "Quantify signal per compartment (Nucleus / Cytoplasm / Cell) by routing the nuclear mask into QUANTIFY alongside the whole-cell mask, and emit both segmentations into the GeoJSON. Cytoplasm = whole-cell minus nucleus.",
                    "default": true
                },
                "expanded_quantification": {
                    "type": "boolean",
                    "description": "With quantify_compartments, also emit Mean and Sum (integrated density) per compartment; per-compartment Median is always emitted. Requires quantify_compartments.",
                    "default": true
                },
                "simplify_tolerance": {
                    "type": "number",
                    "description": "Douglas-Peucker simplification tolerance (px) applied to exported GeoJSON cell/nucleus polygons. The exported polygon is display-only (quantification is mask-derived), so simplifying it does not affect analysis.",
                    "default": 1.0
                },
                "geojson_coord_precision": {
                    "type": "integer",
                    "description": "Decimal places retained for GeoJSON polygon coordinates on export.",
                    "default": 2
                },
                "skip_postprocessing_qc": {
                    "type": "boolean",
                    "description": "Skip postprocessing quality control (segmentation overlay, cell stats, intensity distributions).",
                    "default": false
                },
                "skip_final_qc_report": {
                    "type": "boolean",
                    "description": "Skip generation of the final aggregated HTML QC report.",
                    "default": false
                },
                "skip_spatialdata_export": {
                    "type": "boolean",
                    "description": "Skip the SpatialData (.zarr) export.",
                    "help_text": "The scverse-native store is additive; the pyramidal OME-TIFF and QuPath GeoJSON remain the primary outputs.",
                    "default": false
                },
                "spatialdata_include_image": {
                    "type": "boolean",
                    "description": "Write the merged pyramid into the SpatialData store.",
                    "help_text": "spatialdata.write() materializes every element, so this duplicates the largest artifact the pipeline produces. Off by default; turn on for a self-contained, depositable object.",
                    "default": false
                },
                "spatialdata_residual_join_max_px": {
                    "type": "number",
                    "description": "Max centroid distance (px) when joining registration QC residuals onto cell_mask.",
                    "help_text": "The reg-QC segmentation is a separate native-image run and shares no label space with cell_mask, so the join is spatial.",
                    "default": 15.0,
                    "minimum": 0
                }
            }
        },
        "output_options": {
            "title": "Output options",
            "type": "object",
            "properties": {
                "tilex": {
                    "type": "integer",
                    "description": "Tile size (px, square) for OME-TIFF output.",
                    "default": 512
                },
                "pyramid_resolutions": {
                    "type": "integer",
                    "description": "Number of pyramid resolution levels for OME-TIFF output.",
                    "default": 8
                },
                "pyramid_scale": {
                    "type": "integer",
                    "description": "Scale factor between pyramid levels.",
                    "default": 2
                },
                "compression": {
                    "type": "string",
                    "description": "Compression algorithm for OME-TIFF output.",
                    "default": "zstd",
                    "enum": [
                        "lzw",
                        "zlib",
                        "jpeg",
                        "zstd",
                        "none"
                    ]
                },
                "embed_masks": {
                    "type": "boolean",
                    "description": "When true and quantify_compartments + expanded_quantification are also enabled, embed the cell + nuclei segmentation masks as a second, single-resolution uint32 OME series (Image:1) inside the pyramid OME-TIFF. Required on a prior run for that run's outputs to be extendable via mode='add_cycle'.",
                    "default": false
                }
            }
        },
        "pipeline_control": {
            "title": "Pipeline control",
            "type": "object",
            "properties": {
                "dry_run": {
                    "type": "boolean",
                    "description": "Run pipeline in dry-run mode without executing processes.",
                    "default": false
                },
                "debug_channels": {
                    "type": "boolean",
                    "description": "Enable debug output for channels.",
                    "default": false
                },
                "enable_trace": {
                    "type": "boolean",
                    "description": "Enable detailed execution tracing.",
                    "default": true
                },
                "trace_dir": {
                    "type": "string",
                    "description": "Directory for trace outputs.",
                    "default": ".trace"
                }
            }
        },
        "cluster_options": {
            "title": "Cluster options",
            "type": "object",
            "properties": {
                "slurm_partition": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "SLURM partition to submit jobs to.",
                    "default": null
                },
                "slurm_account": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "SLURM account for job submission.",
                    "default": null
                },
                "slurm_qos": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "SLURM quality of service.",
                    "default": null
                },
                "gpu_type": {
                    "type": "string",
                    "description": "GPU type specification for SLURM.",
                    "default": "nvidia_h200:1"
                }
            }
        },
        "resource_limits": {
            "title": "Resource limits",
            "type": "object",
            "properties": {
                "max_memory": {
                    "type": "string",
                    "description": "Maximum memory limit.",
                    "default": "700.GB"
                },
                "max_cpus": {
                    "type": "integer",
                    "description": "Maximum CPU limit.",
                    "default": 128
                },
                "max_time": {
                    "type": "string",
                    "description": "Maximum time limit.",
                    "default": "240.h"
                }
            }
        }
    },
    "allOf": [
        {
            "$ref": "#/$defs/input_output_options"
        },
        {
            "$ref": "#/$defs/preprocessing_options"
        },
        {
            "$ref": "#/$defs/registration_options"
        },
        {
            "$ref": "#/$defs/segmentation_options"
        },
        {
            "$ref": "#/$defs/quantification_options"
        },
        {
            "$ref": "#/$defs/output_options"
        },
        {
            "$ref": "#/$defs/pipeline_control"
        },
        {
            "$ref": "#/$defs/cluster_options"
        },
        {
            "$ref": "#/$defs/resource_limits"
        }
    ],
    "additionalProperties": true
}
