{
    "$schema": "http://json-schema.org/draft-07/schema",
    "title": "MIRAGE WSI Processing Pipeline Parameters",
    "description": "Schema synchronized with nextflow.config canonical params surface.",
    "type": "object",
    "definitions": {
        "input_output_options": {
            "title": "Input/output options",
            "type": "object",
            "required": [
                "start",
                "input",
                "outdir"
            ],
            "properties": {
                "input": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Path to input samplesheet or directory.",
                    "default": null
                },
                "outdir": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Output directory for pipeline results.",
                    "default": null
                },
                "start": {
                    "type": "string",
                    "description": "Pipeline step to start from.",
                    "default": "preprocessing",
                    "enum": [
                        "preprocessing",
                        "registration",
                        "postprocessing"
                    ]
                },
                "stop": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Pipeline step to stop after. If null, runs to the end.",
                    "default": null,
                    "enum": [
                        "preprocessing",
                        "registration",
                        "postprocessing",
                        null
                    ]
                },
                "mode": {
                    "type": "string",
                    "description": "Execution mode. 'standard' runs the linear start/stop step flow; 'add_cycle' bypasses it to fold a new imaging cycle into a completed patient run (requires --prior_outdir).",
                    "default": "standard",
                    "enum": [
                        "standard",
                        "add_cycle"
                    ]
                },
                "prior_outdir": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "For mode='add_cycle': the --outdir of the previously completed run, containing csv/registered.csv and csv/postprocessed.csv checkpoints to reuse.",
                    "default": null
                }
            }
        },
        "preprocessing_options": {
            "title": "Preprocessing options",
            "type": "object",
            "properties": {
                "preproc_tile_size": {
                    "type": "integer",
                    "description": "Tile size for preprocessing.",
                    "default": 1950
                },
                "preproc_skip_dapi": {
                    "type": "boolean",
                    "description": "Skip DAPI channel during preprocessing.",
                    "default": true
                },
                "preproc_autotune": {
                    "type": "boolean",
                    "description": "Enable autotune for preprocessing.",
                    "default": false
                },
                "preproc_n_iter": {
                    "type": "integer",
                    "description": "Number of iterations for preprocessing.",
                    "default": 100
                },
                "preproc_pool_workers": {
                    "type": ["integer", "null"],
                    "description": "Worker threads for preprocessing parallelism. null = use task.cpus.",
                    "default": null
                },
                "preproc_overlap": {
                    "type": "integer",
                    "description": "Tile overlap for preprocessing.",
                    "default": 0
                },
                "preproc_no_darkfield": {
                    "type": "boolean",
                    "description": "Disable darkfield correction in preprocessing.",
                    "default": false
                },
                "preprocess_qc_scale_factor": {
                    "type": "number",
                    "description": "Scale factor for preprocessing QC images.",
                    "default": 0.25
                },
                "skip_preprocess_qc": {
                    "type": "boolean",
                    "description": "Skip preprocessing quality control image generation.",
                    "default": false
                },
                "pixel_size": {
                    "type": "number",
                    "description": "Pixel size in micrometers.",
                    "default": 0.325
                }
            }
        },
        "registration_options": {
            "title": "Registration options",
            "type": "object",
            "properties": {
                "registration_method": {
                    "type": "string",
                    "description": "Registration method to use. Only 'valis' is currently supported by the runtime validator (see lib/ParamUtils.groovy).",
                    "default": "valis",
                    "enum": [
                        "valis"
                    ]
                },
                "padding": {
                    "type": "boolean",
                    "description": "Enable padding during registration.",
                    "default": false
                },
                "pad_mode": {
                    "type": "string",
                    "description": "Padding mode for registration.",
                    "default": "constant",
                    "enum": [
                        "constant",
                        "edge",
                        "reflect",
                        "symmetric"
                    ]
                },
                "skip_registration_qc": {
                    "type": "boolean",
                    "description": "Skip registration quality control (legacy; equivalent to reg_qc=0).",
                    "default": false
                },
                "reg_qc": {
                    "type": "integer",
                    "description": "Registration QC depth: 0=none, 1=DAPI overlay only, 2=DAPI overlay + segmentation-overlap metric (Dice/IoU/instance-F1).",
                    "default": 2,
                    "enum": [ 0, 1, 2 ]
                },
                "qc_scale_factor": {
                    "type": "number",
                    "description": "Scale factor for registration QC images.",
                    "default": 0.25
                },
                "enable_feature_error": {
                    "type": "boolean",
                    "description": "Enable feature error detection during registration.",
                    "default": false
                },
                "feature_detector": {
                    "type": "string",
                    "description": "Feature detector algorithm for registration.",
                    "default": "superpoint",
                    "enum": [
                        "superpoint",
                        "disk",
                        "dedode",
                        "brisk",
                        "vgg"
                    ]
                },
                "feature_max_dim": {
                    "type": "integer",
                    "description": "Maximum image dimension for feature detection.",
                    "default": 1024
                },
                "feature_n_features": {
                    "type": "integer",
                    "description": "Number of features to detect.",
                    "default": 5000
                },
                "reg_reference_markers": {
                    "type": "array",
                    "description": "Reference markers for registration.",
                    "default": [
                        "DAPI",
                        "FITC"
                    ]
                },
                "reg_micro_reg_fraction": {
                    "type": "number",
                    "description": "Fraction for micro registration.",
                    "default": 0.125
                },
                "reg_max_image_dim": {
                    "type": "integer",
                    "description": "Maximum image dimension for registration.",
                    "default": 4000
                },
                "memory_mode": {
                    "type": "string",
                    "description": "Memory mode for registration.",
                    "default": "high",
                    "enum": [
                        "low",
                        "medium",
                        "high"
                    ]
                },
                "skip_micro_registration": {
                    "type": "boolean",
                    "description": "Skip micro registration step.",
                    "default": true
                },
                "allow_auto_reference": {
                    "type": "boolean",
                    "description": "Allow automatic reference selection.",
                    "default": false
                },
                "reg_jvm_heap_gb": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "description": "JVM heap (GiB) for VALIS/Bio-Formats in REGISTER. null = derive from task.memory at runtime.",
                    "default": null
                }
            }
        },
        "segmentation_options": {
            "title": "Segmentation options",
            "type": "object",
            "properties": {
                "seg_gpu": {
                    "type": "boolean",
                    "description": "Use GPU for segmentation.",
                    "default": true
                },
                "seg_pmin": {
                    "type": "number",
                    "description": "Minimum percentile for segmentation normalization.",
                    "default": 1.0
                },
                "seg_pmax": {
                    "type": "number",
                    "description": "Maximum percentile for segmentation normalization.",
                    "default": 99.8
                },
                "seg_n_tiles_y": {
                    "type": "integer",
                    "description": "Number of tiles in Y direction for segmentation.",
                    "default": 16
                },
                "seg_n_tiles_x": {
                    "type": "integer",
                    "description": "Number of tiles in X direction for segmentation.",
                    "default": 16
                },
                "seg_expand_distance": {
                    "type": "integer",
                    "description": "Expansion distance for segmentation labels.",
                    "default": 10
                },
                "segmentation_model": {
                    "type": "string",
                    "description": "Name of the segmentation model.",
                    "default": "stardist_full_e200_lr00001_aug1_seed10_es50p0.001_rlr0.5p50"
                },
                "segmentation_model_dir": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Directory containing segmentation models.",
                    "default": null
                },
                "seg_method": {
                    "type": "string",
                    "description": "Segmentation backend to use.",
                    "default": "stardist",
                    "enum": [
                        "stardist",
                        "instantseg",
                        "cellsam"
                    ]
                },
                "seg_prob_thresh": {
                    "type": [
                        "number",
                        "null"
                    ],
                    "description": "StarDist detection probability threshold. null = use the model's built-in default.",
                    "default": null
                },
                "seg_instantseg_model": {
                    "type": "string",
                    "description": "InstanSeg model name (only used when seg_method='instantseg').",
                    "default": "fluorescence_nuclei_and_cells"
                },
                "seg_instantseg_target": {
                    "type": "string",
                    "description": "InstanSeg output target.",
                    "default": "all_outputs",
                    "enum": [
                        "all_outputs",
                        "cells",
                        "nuclei"
                    ]
                },
                "seg_instantseg_tile_size": {
                    "type": "integer",
                    "description": "Tile size (px) for InstanSeg tiled inference.",
                    "default": 512
                },
                "seg_instantseg_batch_size": {
                    "type": "integer",
                    "description": "Number of tiles per InstanSeg forward pass.",
                    "default": 16
                },
                "instanseg_model_dir": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Writable host path for InstanSeg's BioImage.IO model cache. null = per-task work-dir cache.",
                    "default": null
                },
                "seg_cellsam_bbox_threshold": {
                    "type": "number",
                    "description": "CellSAM bounding-box confidence threshold (precision/recall knob).",
                    "default": 0.4
                },
                "seg_cellsam_use_wsi": {
                    "type": "boolean",
                    "description": "Enable CellSAM native tiling (block_size/overlap) for large images.",
                    "default": true
                },
                "seg_cellsam_block_size": {
                    "type": "integer",
                    "description": "CellSAM tiling block size (px).",
                    "default": 1024
                },
                "seg_cellsam_overlap": {
                    "type": "integer",
                    "description": "CellSAM tiling overlap (px).",
                    "default": 56
                },
                "cellsam_model_path": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Path to pre-downloaded CellSAM weights for offline/container use. null = auto-download at runtime.",
                    "default": null
                }
            }
        },
        "quantification_options": {
            "title": "Quantification options",
            "type": "object",
            "properties": {
                "quantify_compartments": {
                    "type": "boolean",
                    "description": "Quantify signal per compartment (Nucleus / Cytoplasm / Cell) by routing the nuclear mask into QUANTIFY alongside the whole-cell mask, and emit both segmentations into the GeoJSON. Cytoplasm = whole-cell minus nucleus.",
                    "default": false
                },
                "expanded_quantification": {
                    "type": "boolean",
                    "description": "With quantify_compartments, also compute Median and Sum (integrated density) per compartment in addition to Mean. Requires quantify_compartments.",
                    "default": false
                },
                "simplify_tolerance": {
                    "type": "number",
                    "description": "Douglas-Peucker simplification tolerance (px) applied to exported GeoJSON cell/nucleus polygons. The exported polygon is display-only (quantification is mask-derived), so simplifying it does not affect analysis.",
                    "default": 1.0
                },
                "geojson_coord_precision": {
                    "type": "integer",
                    "description": "Decimal places retained for GeoJSON polygon coordinates on export.",
                    "default": 2
                },
                "skip_postprocessing_qc": {
                    "type": "boolean",
                    "description": "Skip postprocessing quality control (segmentation overlay, cell stats, intensity distributions).",
                    "default": false
                },
                "skip_seg_quality_eval": {
                    "type": "boolean",
                    "description": "Skip reference-free cell-segmentation quality scoring (CellSegmentationEvaluator, 2D).",
                    "default": false
                },
                "cse_pixel_size_um": {
                    "type": "number",
                    "description": "Pixel size in micrometers passed to the CellSegmentationEvaluator. null = infer from image metadata.",
                    "default": null
                },
                "cse_max_pixels": {
                    "type": "integer",
                    "description": "Bin image+masks so CSE scores at most this many pixels, capping its memory/time on full-WSI masks (the pixel size is scaled to match, preserving geometry/area metrics). null = score at full resolution. Keep fixed across a cohort: the composite QualityScore shifts with the binning factor.",
                    "default": 50000000
                },
                "segeval_tag": {
                    "type": "string",
                    "description": "Container tag for the segmentation quality evaluator (segeval) image on bolt3x/attend_image_analysis (Docker Hub).",
                    "default": "segeval"
                },
                "skip_final_qc_report": {
                    "type": "boolean",
                    "description": "Skip generation of the final aggregated HTML QC report.",
                    "default": false
                }
            }
        },
        "output_options": {
            "title": "Output options",
            "type": "object",
            "properties": {
                "tilex": {
                    "type": "integer",
                    "description": "Tile size (px, square) for OME-TIFF output.",
                    "default": 512
                },
                "pyramid_resolutions": {
                    "type": "integer",
                    "description": "Number of pyramid resolution levels for OME-TIFF output.",
                    "default": 8
                },
                "pyramid_scale": {
                    "type": "integer",
                    "description": "Scale factor between pyramid levels.",
                    "default": 2
                },
                "compression": {
                    "type": "string",
                    "description": "Compression algorithm for OME-TIFF output.",
                    "default": "zstd",
                    "enum": [
                        "lzw",
                        "zlib",
                        "jpeg",
                        "zstd",
                        "none"
                    ]
                },
                "embed_masks": {
                    "type": "boolean",
                    "description": "When true and quantify_compartments + expanded_quantification are also enabled, embed the cell + nuclei segmentation masks as a second, single-resolution uint32 OME series (Image:1) inside the pyramid OME-TIFF. Required on a prior run for that run's outputs to be extendable via mode='add_cycle'.",
                    "default": true
                }
            }
        },
        "pipeline_control": {
            "title": "Pipeline control",
            "type": "object",
            "properties": {
                "dry_run": {
                    "type": "boolean",
                    "description": "Run pipeline in dry-run mode without executing processes.",
                    "default": false
                },
                "debug_channels": {
                    "type": "boolean",
                    "description": "Enable debug output for channels.",
                    "default": false
                },
                "enable_trace": {
                    "type": "boolean",
                    "description": "Enable detailed execution tracing.",
                    "default": true
                },
                "trace_dir": {
                    "type": "string",
                    "description": "Directory for trace outputs.",
                    "default": ".trace"
                }
            }
        },
        "cluster_options": {
            "title": "Cluster options",
            "type": "object",
            "properties": {
                "slurm_partition": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "SLURM partition to submit jobs to.",
                    "default": null
                },
                "slurm_account": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "SLURM account for job submission.",
                    "default": null
                },
                "slurm_qos": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "SLURM quality of service.",
                    "default": null
                },
                "gpu_type": {
                    "type": "string",
                    "description": "GPU type specification for SLURM.",
                    "default": "nvidia_h200:1"
                }
            }
        },
        "resource_limits": {
            "title": "Resource limits",
            "type": "object",
            "properties": {
                "max_memory": {
                    "type": "string",
                    "description": "Maximum memory limit.",
                    "default": "700.GB"
                },
                "max_cpus": {
                    "type": "integer",
                    "description": "Maximum CPU limit.",
                    "default": 128
                },
                "max_time": {
                    "type": "string",
                    "description": "Maximum time limit.",
                    "default": "240.h"
                }
            }
        }
    },
    "allOf": [
        {
            "$ref": "#/definitions/input_output_options"
        },
        {
            "$ref": "#/definitions/preprocessing_options"
        },
        {
            "$ref": "#/definitions/registration_options"
        },
        {
            "$ref": "#/definitions/segmentation_options"
        },
        {
            "$ref": "#/definitions/quantification_options"
        },
        {
            "$ref": "#/definitions/output_options"
        },
        {
            "$ref": "#/definitions/pipeline_control"
        },
        {
            "$ref": "#/definitions/cluster_options"
        },
        {
            "$ref": "#/definitions/resource_limits"
        }
    ],
    "additionalProperties": true
}
