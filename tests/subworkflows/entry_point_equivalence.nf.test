/*
 * THE permanent, CI-collected guard for the defect Task 4.3 closed: a
 * checkpoint-entered meta (READ_SEGMENTED_CHECKPOINT -> Meta.fromCheckpointRow /
 * CsvUtils.metaContextFromCheckpoint) must carry keep_channels/channels_count, not
 * just patient_id/id/is_reference/channels.
 *
 * Before Task 4.3, READ_SEGMENTED_CHECKPOINT built meta by hand --
 * [patient_id, id: patient_id, is_reference, channels] -- with keep_channels and
 * channels_count both absent. Downstream, SPLIT_CHANNELS fell back to the FULL
 * declared channel list (an extra DAPI plane) because meta.keep_channels didn't
 * exist, and QUANTIFY ran twice. The manual work-dir diff that caught this (and
 * the manual full-run-vs---start-postprocessing diff that proved the fix) ran
 * ONCE and is recorded in a report -- it does not run again on the next change to
 * Meta.fromCheckpointRow or CsvUtils.metaContextFromCheckpoint. This file is what
 * runs again, every time, under CI's blocking `nf-test test --tag stub` gate.
 *
 * ONE nextflow_workflow block, deliberately: nf-test 0.9.5 in this environment
 * only executes the LAST such block when a single .nf.test file contains more
 * than one (confirmed empirically against tests/subworkflows/local/segmentation.nf.test,
 * which has two -- a scratch first block with a deliberately-false assertion never
 * ran and the file still reported SUCCESS). A second block here would silently
 * make one of the two assertions below never execute.
 */

nextflow_workflow {

    name "A checkpoint-entered meta carries the same keys as a samplesheet meta"
    script "subworkflows/local/segmentation.nf"
    workflow "READ_SEGMENTED_CHECKPOINT"

    tag "subworkflows"
    tag "segmentation"
    tag "stub"

    test("Checkpoint meta carries keep_channels/channels_count, matching the samplesheet path") {

        options "-stub"

        when {
            params {
                outdir = "$outputDir"
            }
            workflow {
                """
                input[0] = "${projectDir}/tests/testdata/segmented.csv"
                input[1] = ParamUtils.compartmentMode(params)
                """
            }
        }

        then {
            assert workflow.success

            def metas = workflow.out.samples.collect { it[0] }
            assert metas.size() == 2 : "expected reference + one moving slide, got: ${metas}"

            // The regression this guards: BOTH keys must be present on EVERY
            // checkpoint-entered meta, not merely on the reference row.
            metas.each { meta ->
                assert meta.containsKey('keep_channels') : "keep_channels missing: ${meta}"
                assert meta.containsKey('channels_count') : "channels_count missing: ${meta}"
            }

            def refMeta = metas.find { it.is_reference }
            def movMeta = metas.find { !it.is_reference }
            assert refMeta != null && movMeta != null

            // tests/testdata/segmented.csv declares the SAME two rows as
            // test_input.csv (P001 ref DAPI|PANCK|SMA, P001 mov1 DAPI|CD3|CD8) --
            // see the generator's comment. Claim-once-per-patient (reference
            // first): the reference claims all three of its own channels; the
            // moving slide's declared DAPI is already claimed, so it keeps only
            // CD3 and CD8.
            assert refMeta.keep_channels == ['DAPI', 'PANCK', 'SMA']
            assert movMeta.keep_channels == ['CD3', 'CD8']

            // channels_count is the PER-PATIENT total (3 + 2 = 5), identical on
            // every row of the patient -- and identical to what INPUT_CHECK's
            // CsvUtils.countChannelsPerPatient computes for the SAME declared
            // channels on the samplesheet path: tests/subworkflows/local/
            // input_check.nf.test asserts `counts[0].channels.P001 == 5` against
            // test_input.csv's identical two rows. Hard-coded here (not called
            // via CsvUtils) because the nf-test assertion context has no lib/ on
            // its classpath -- see tests/layout.nf.test's header comment -- so 5
            // is this file's independently-verified cross-check, not a value
            // invented in isolation.
            assert refMeta.channels_count == 5
            assert movMeta.channels_count == 5
        }
    }
}
