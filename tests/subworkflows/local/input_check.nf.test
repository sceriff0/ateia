/*
 * INPUT_CHECK — samplesheet in, sample channel out, with the per-patient counts
 * injected into every meta. The injection is what lets the downstream sized
 * groupTuples stream; a silently-missing count degrades those to "wait for
 * everything", and a silently-WRONG one drops or duplicates patients (see
 * tests/main.nf.test's MERGE_QUANT_CSVS count assertions). Neither shows up as a
 * failed run, so it is pinned here directly.
 */
nextflow_workflow {

    name "Test INPUT_CHECK subworkflow"
    script "subworkflows/local/input_check.nf"
    workflow "INPUT_CHECK"

    test("injects images_count and channels_count into every meta") {
        tag "stub"

        when {
            workflow {
                """
                input[0] = "$projectDir/tests/testdata/test_input.csv"
                input[1] = 'path_to_file'
                """
            }
            params {
                outdir = "$outputDir"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // test_input.csv: P001 with 2 images (one reference DAPI|PANCK|SMA,
                // one moving DAPI|CD3|CD8).
                { assert workflow.out.samples.size() == 2 },
                { assert workflow.out.samples.every { it[0].images_count == 2 } },
                // Markers reaching QUANTIFY: DAPI+PANCK+SMA from the reference (which
                // keeps its nuclear channel) + CD3+CD8 from the moving slide = 5.
                { assert workflow.out.samples.every { it[0].channels_count == 5 } },
                // Per-image unique id, prefixed with patient_id so a patient's images
                // cannot produce identically named outputs.
                { assert workflow.out.samples.every { it[0].id.startsWith('P001') } },
                { assert workflow.out.samples.collect { it[0].id }.unique().size() == 2 }
            )
        }
    }

    test("emits the same counts it injected, for the QC report manifest") {
        tag "stub"

        when {
            workflow {
                """
                input[0] = "$projectDir/tests/testdata/test_input.csv"
                input[1] = 'path_to_file'
                """
            }
            params {
                outdir = "$outputDir"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // One count per run: FINAL_QC's manifest is built from THIS emit, so it
                // cannot disagree with what the groupings were sized by.
                { assert workflow.out.counts.size() == 1 },
                { assert workflow.out.counts[0].patients == [P001: 2] },
                { assert workflow.out.counts[0].channels == [P001: 5] }
            )
        }
    }

    test("reads the column belonging to the entry step") {
        tag "stub"

        when {
            workflow {
                """
                // A registration checkpoint sheet: the image lives in
                // preprocessed_image, not path_to_file.
                input[0] = "$projectDir/tests/testdata/valid_checkpoint_registration.csv"
                input[1] = 'preprocessed_image'
                """
            }
            params {
                outdir = "$outputDir"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.samples.size() == 2 },
                { assert workflow.out.samples.every { it[0].images_count == 2 } },
                { assert workflow.out.samples.every { it[1].toString().endsWith('.ome.tiff') } }
            )
        }
    }

    test("declared_channels (manifest) and channels_count (groupKey) agree under the claim-once rule") {
        tag "stub"

        when {
            workflow {
                """
                // invalid_no_ref.csv: two non-reference rows, each declaring DAPI
                // (P001,...,false,DAPI|CD3|CD8 / P001,...,false,DAPI|VIMENTIN|CD45).
                // auto_reference=false mirrors mode=add_cycle: INPUT_CHECK is always
                // called with autoReference=false there, since the reference is the
                // prior run's and never a row in this sheet.
                input[0] = "$projectDir/tests/testdata/invalid_no_ref.csv"
                input[1] = 'path_to_file'
                """
            }
            params {
                outdir = "$outputDir"
            }
        }

        then {
            // CORRECTED (Task 4.4, fix round 1): this test's title and expectation used
            // to pin a nuclear-marker-drop rule ("DAPI is dropped from BOTH rows, neither
            // is a reference" -> 4) that commit 571976e (":recycle: Derive
            // countChannelsPerPatient from the keep-set resolver") deliberately removed.
            // Evidence:
            //   - 571976e's diff deletes the `MarkerUtils.splitOutputChannels(...)` call
            //     from countChannelsPerPatient, and its own commit message states the
            //     intended new behaviour verbatim: "A patient with reference
            //     DAPI|KI67|CD20 and cycles CELLTOX|CD8 and CELLTOX|FOXP3 now counts 6,
            //     not 5: the old rule dropped CELLTOX from both non-reference slides...
            //     even though the reference never carried it."
            //   - lib/MarkerUtils.groovy's header confirms it "does NOT decide which
            //     channels a slide emits -- that is CsvUtils.resolveKeptChannelsPerSlide."
            //   - lib/CsvUtils.groovy's resolveKeptChannelsPerSlide docstring: "NUCLEAR-
            //     NESS PLAYS NO PART IN THE DROP DECISION, deliberately."
            // Under that rule, EVERY marker name is claimed exactly once per patient
            // regardless of which row declares it or whether any row is a reference --
            // which makes channels_count (the sum of claim-once per-slide keeps) and
            // declared_channels (the plain per-patient union of declared names) the SAME
            // number for any samplesheet: both equal the patient's total distinct
            // upper-cased channel-name count. They can no longer "provably differ"; this
            // test now pins that they agree, using the same fixture that used to show
            // them apart.
            assertAll(
                { assert workflow.success },
                // Declared union for the manifest: DAPI+CD3+CD8+VIMENTIN+CD45 = 5.
                { assert workflow.out.counts[0].declared_channels.P001 == 5 },
                // channels_count/the groupKey: under claim-once, the first row's DAPI is
                // claimed (nothing has claimed it yet -- no row is a reference here), the
                // second row's DAPI is already claimed and contributes nothing new.
                // CD3+CD8 (row 1) + VIMENTIN+CD45 (row 2) + DAPI (claimed once) = 5.
                { assert workflow.out.counts[0].channels.P001 == 5 },
                { assert workflow.out.samples.every { it[0].channels_count == 5 } }
            )
        }
    }

    test("cycle1/slide.ome.tiff and cycle2/slide.ome.tiff get distinct meta.id") {
        tag "stub"

        // duplicate_basename.csv: the ORDINARY cyclic-IF layout -- one directory per
        // cycle, both cycles sharing the basename "slide.ome.tiff". file(...).simpleName
        // ("slide") collided for both rows, so both recorded the same path in
        // preprocessed.csv and the run aborted AFTER the corrupt manifest was written.
        when {
            workflow {
                """
                input[0] = "$projectDir/tests/testdata/duplicate_basename.csv"
                input[1] = 'path_to_file'
                """
            }
            params {
                outdir = "$outputDir"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.samples.size() == 2 },
                { assert workflow.out.samples.collect { it[0].id }.unique().size() == 2 },
                // Disambiguated with the row's samplesheet-order index, not left as the
                // bare colliding stem.
                { assert workflow.out.samples.collect { it[0].id }.toSorted() ==
                        ['P001_slide_000', 'P001_slide_001'] }
            )
        }
    }

    test("a sheet marking NO reference gets nothing promoted in its place") {
        tag "stub"

        // Replaces a case that asserted the opposite. `--allow_auto_reference` used to
        // promote a patient's FIRST samplesheet row when no row declared itself. That rule
        // is gone: the reference is the slide every other slide is warped onto, and picking
        // it from row order made two sheets differing only in row order produce two
        // different alignments, with nothing recording that a choice had been made.
        //
        // THE COUNT IS THE WRONG THING TO ASSERT, which is worth stating because the test
        // this replaces asserted exactly that. channels_count is still 5, unchanged by the
        // removal, because the KEEP-SET rule is independent of the reference rule: DAPI
        // goes to the first slide that claims it (claim-once), reference or not, so mov1
        // keeps [DAPI, CD3, CD8] either way. The observable that actually moved is
        // meta.is_reference -- with promotion gone, NO row carries it.
        //
        // INPUT_CHECK does not raise here; refusing a referenceless sheet is
        // CsvUtils.validateInputSemantics' job, upstream in workflows/mirage.nf, which has
        // the better message. Registration would then fail on the missing reference.
        when {
            workflow {
                """
                input[0] = "$projectDir/tests/testdata/invalid_no_ref.csv"
                input[1] = 'path_to_file'
                """
            }
            params {
                outdir = "$outputDir"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.samples.size() == 2 },
                // NOTHING was promoted: neither row became the reference.
                { assert workflow.out.samples.every { !it[0].is_reference } },
                // Unchanged by the removal -- see the note above.
                { assert workflow.out.counts[0].channels.P001 == 5 }
            )
        }
    }

    test("two rows sharing the identical raw path cell get distinct id and keep-set") {
        tag "stub"

        // duplicate_raw_path.csv: BOTH rows declare the exact same path_to_file
        // string (not just the same basename -- duplicate_basename.csv above covers
        // that case). This is Task 4.4's fix-round-1 regression, exercised through
        // the REAL production chain: Nextflow's own splitCsv -> the `.map` closure
        // in subworkflows/local/input_check.nf that pops CsvUtils.rowIndexPerPatient's
        // per-key index list -> Meta.fromSamplesheetRow -> the keep-set lookup. No
        // hand-supplied row indices anywhere in this test.
        //
        // Before the fix: rowIndexPerPatient keyed a SCALAR by "patientId::rawImage",
        // so the second row's index silently overwrote the first's and BOTH rows read
        // back index 1 -- Meta.fromSamplesheetRow assigned them the SAME meta.id, and
        // the reference row's real keep-set ([DAPI, CD3]) was silently displaced by
        // the second row's ([]) under that shared id: both rows read back
        // keep_channels == [], and channels_count collapsed from 2 to 0.
        when {
            workflow {
                """
                input[0] = "$projectDir/tests/testdata/duplicate_raw_path.csv"
                input[1] = 'path_to_file'
                """
            }
            params {
                outdir = "$outputDir"
            }
        }

        then {
            // NOT asserting on is_reference here: resolveReferenceRows/the
            // is_reference re-resolution in this workflow's own `.map` both compare
            // by RAW CELL (documented assumption: unique per row within a patient),
            // which this fixture deliberately violates the same way it violates
            // rowIndexPerPatient's -- so BOTH rows resolve is_reference=true here.
            // That is a separate, pre-existing, documented limitation, not what this
            // test is pinning; it is the keep-set/id disambiguation this task fixes.
            assertAll(
                { assert workflow.success },
                { assert workflow.out.samples.size() == 2 },
                // Distinct ids despite the identical raw cell -- rowIndexPerPatient's
                // list-per-key design, popped by the `.map` closure, must still
                // disambiguate them.
                { assert workflow.out.samples.collect { it[0].id }.unique().size() == 2 },
                // One row keeps its own [DAPI, CD3] -- not [], and not swapped with
                // the other row's entry. Sorted by size (not by is_reference, per the
                // note above) so this doesn't depend on emission order.
                { assert workflow.out.samples.collect { it[0].keep_channels }.sort { it.size() } ==
                        [[], ['DAPI', 'CD3']] },
                // Patient total: DAPI+CD3 from one row, nothing new from the
                // duplicate. The collapse bug summed this to 0.
                { assert workflow.out.counts[0].channels.P001 == 2 },
                { assert workflow.out.samples.every { it[0].channels_count == 2 } }
            )
        }
    }

}
