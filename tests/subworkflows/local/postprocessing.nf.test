nextflow_workflow {

    name "Test POSTPROCESSING subworkflow"
    script "subworkflows/local/postprocess.nf"
    workflow "POSTPROCESSING"

    tag "subworkflow"
    tag "postprocessing"

    // POSTPROCESSING no longer runs SEGMENT / EXTRACT_CELL_PROPERTIES /
    // EXTRACT_NUCLEI_PROPERTIES itself (Task 1, arch-B-split: they moved to
    // subworkflows/local/segmentation.nf, its own resumable step). Its take: went
    // 3 inputs -> 9 -> 4: the six segmentation artifacts it used to take
    // positionally (ch_registered, ch_cell_mask, ch_nuclei_mask, ch_contours,
    // ch_nucleus_contours, ch_morphology) are ONE PatientArtifacts.channels record
    // now, so input[0] below names each fixture instead of relying on six
    // assignments landing in the right slots. input[1]/input[2] are still
    // ch_reg_qc / ch_reg_residuals, and input[3] is
    // ParamUtils.compartmentMode(params) -- Task 4's seam for
    // --quantify_compartments / --quantify_statistics / --embed_masks, resolved
    // once by workflows/mirage.nf in production and threaded down the same way here.
    //
    // input[3] stays a live ParamUtils.compartmentMode(params) call rather than a
    // literal map on purpose: none of the 7 tests below overrides
    // --quantify_compartments / --quantify_statistics / --embed_masks, so there
    // is no "off" case here that a literal map would exercise any differently.
    //
    // RUNS LOCALLY, contrary to an older note here: it is nf-test.config's default
    // `test,docker` profile that hangs pulling amd64 images under qemu, not nf-test
    // itself. `nf-test test --tag stub --profile test` runs CI's whole blocking gate
    // in about 16 minutes, and is the only local check that catches an nf-test file
    // missing its `stub` tag.

    test("Should run full postprocessing - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                seg_gpu = false
                pixel_size = 0.325
                pyramid_resolutions = 8
                pyramid_scale = 2
                tilex = 512
                compression = 'zstd'
            }
            workflow {
                """
                input[0] = PatientArtifacts.channels(
                    'nf-test', PatientArtifacts.SEGMENTATION_FIELDS, [
                        samples         : Channel.fromList([
                            [[patient_id: 'P001', is_reference: true, channels: ['DAPI', 'PANCK', 'SMA'], channels_count: 3],
                            file('$projectDir/tests/testdata/P001_ref.ome.tiff')],
                            [[patient_id: 'P001', is_reference: false, channels: ['DAPI', 'PANCK', 'SMA'], channels_count: 3],
                            file('$projectDir/tests/testdata/P001_mov1.ome.tiff')]
                            ]),
                        cell_mask       : Channel.fromList([
                            [[patient_id: 'P001', id: 'P001', is_reference: true],
                            file('$projectDir/tests/testdata/P001_cell_mask.tif')]
                            ]),
                        nuclei_mask     : Channel.fromList([
                            [[patient_id: 'P001', id: 'P001', is_reference: true],
                            file('$projectDir/tests/testdata/P001_nuclei_mask.tif')]
                            ]),
                        contours        : Channel.fromList([
                            ['P001', file('$projectDir/tests/testdata/sample_contours.json')]
                            ]),
                        nucleus_contours: Channel.fromList([
                            ['P001', file('$projectDir/tests/testdata/sample_contours.json')]
                            ]),
                        morphology      : Channel.fromList([
                            [[patient_id: 'P001', id: 'P001', is_reference: true],
                            file('$projectDir/tests/testdata/sample_morphology.csv')]
                            ]),
                    ])
                // Non-empty ch_reg_qc / ch_reg_residuals, shaped like
                // REGISTRATION.out.seg_qc / .out.seg_residuals ([meta, file] tuples
                // from WARP_SEG_QC), to exercise the EXPORT_SPATIALDATA fold-in path
                // in postprocess.nf (the normal full-pipeline path, not the
                // --start postprocessing shortcut covered by the other tests below).
                //
                // images_count is REQUIRED here, not decoration: postprocess.nf sizes
                // its per-patient QC gather `images_count - 1` (one artifact per MOVING
                // slide), and lib/PatientGroup.groovy ABORTS when that cannot be
                // derived. These metas descend from INPUT_CHECK in the real pipeline,
                // which injects the count into every meta it produces, so a meta
                // without it is not a leaner fixture -- it is a meta the pipeline
                // cannot produce. Before the size was mandatory this fixture silently
                // exercised an UNSIZED groupTuple, i.e. the full-run barrier, while
                // appearing to test the streaming gather.
                input[1] = Channel.fromList([
                    [[patient_id: 'P001', images_count: 2], file('$projectDir/tests/testdata/sample_reg_qc.json')]
                ])
                input[2] = Channel.fromList([
                    [[patient_id: 'P001', images_count: 2], file('$projectDir/tests/testdata/sample_reg_residuals.csv')]
                ])
                input[3] = ParamUtils.compartmentMode(params)
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.checkpoint_csv }
            )
        }
    }

    test("Should quantify multiple registered slides against pre-made masks - stub") {
        // Renamed from "Should segment reference images only": POSTPROCESSING no
        // longer runs SEGMENT (moved to segmentation.nf), so this no longer segments
        // anything. What it actually exercises: multiple registered slides
        // (reference + 2 moving) quantified against masks supplied directly, with no
        // registration QC -- the --start postprocessing shortcut shape.

        tag "stub"
        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                seg_gpu = false
                pixel_size = 0.325
                pyramid_resolutions = 8
                pyramid_scale = 2
                tilex = 512
                compression = 'zstd'
            }
            workflow {
                """
                input[0] = PatientArtifacts.channels(
                    'nf-test', PatientArtifacts.SEGMENTATION_FIELDS, [
                        samples         : Channel.fromList([
                            [[patient_id: 'P001', is_reference: true, channels: ['DAPI', 'PANCK', 'SMA'], channels_count: 3],
                            file('$projectDir/tests/testdata/P001_ref.ome.tiff')],
                            [[patient_id: 'P001', is_reference: false, channels: ['DAPI', 'PANCK', 'SMA'], channels_count: 3],
                            file('$projectDir/tests/testdata/P001_mov1.ome.tiff')],
                            [[patient_id: 'P001', is_reference: false, channels: ['DAPI', 'PANCK', 'SMA'], channels_count: 3],
                            file('$projectDir/tests/testdata/P001_mov2.ome.tiff')]
                            ]),
                        cell_mask       : Channel.fromList([
                            [[patient_id: 'P001', id: 'P001', is_reference: true],
                            file('$projectDir/tests/testdata/P001_cell_mask.tif')]
                            ]),
                        nuclei_mask     : Channel.fromList([
                            [[patient_id: 'P001', id: 'P001', is_reference: true],
                            file('$projectDir/tests/testdata/P001_nuclei_mask.tif')]
                            ]),
                        contours        : Channel.fromList([
                            ['P001', file('$projectDir/tests/testdata/sample_contours.json')]
                            ]),
                        nucleus_contours: Channel.fromList([
                            ['P001', file('$projectDir/tests/testdata/sample_contours.json')]
                            ]),
                        morphology      : Channel.fromList([
                            [[patient_id: 'P001', id: 'P001', is_reference: true],
                            file('$projectDir/tests/testdata/sample_morphology.csv')]
                            ]),
                    ])
                // No REGISTRATION output in this session (--start postprocessing path).
                input[1] = Channel.empty()
                input[2] = Channel.empty()
                input[3] = ParamUtils.compartmentMode(params)
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.checkpoint_csv }
            )
        }
    }

