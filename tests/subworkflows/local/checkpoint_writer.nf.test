nextflow_workflow {

    name "Test CHECKPOINT_WRITER subworkflow"
    script "subworkflows/local/checkpoint_writer.nf"
    workflow "CHECKPOINT_WRITER"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "checkpoint_writer"

    // WHY THIS FILE IS NOT `options "-stub"`. There is no process here to stub: the
    // whole subworkflow is operators, and what is under assertion is the CSV they
    // produce -- its header, its row content and its ORDER. A stub run would exercise
    // exactly the same code, so the flag would buy nothing and cost the reader a
    // question. It IS tagged `stub` so CI's blocking gate collects it, which is the
    // separate thing that flag does not do.

    test("writes a header and one row per input, sorted, at cleanup_level none") {

        tag "stub"

        when {
            params {
                outdir = "$outputDir"
                cleanup_level = 'none'
            }
            workflow {
                """
                input[0] = 'registered'
                // Deliberately NOT in patient order: sort: true is what makes the
                // manifest reproducible, and collectFile writes in COMPLETION order
                // without it -- two runs of the same commit produced different files.
                input[1] = Channel.of(
                    [ patient_id: 'P002', id: 'P002_s1',
                      registered_image: '/out/P002/registered/P002_s1.ome.tiff',
                      is_reference: false, channels: 'DAPI|CD3', pixel_size: 0.325 ],
                    [ patient_id: 'P001', id: 'P001_s1',
                      registered_image: '/out/P001/registered/P001_s1.ome.tiff',
                      is_reference: true, channels: 'DAPI|CD8', pixel_size: 0.325 ]
                )
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.csv.size() == 1 },
                {
                    def lines = file(workflow.out.csv[0]).readLines()
                    // The header is Checkpoint's, never restated here.
                    assert lines[0] ==
                        'patient_id,id,registered_image,is_reference,channels,pixel_size'
                    assert lines.size() == 3
                    // sort: true, so P001 precedes P002 regardless of arrival order.
                    assert lines[1].startsWith('P001,')
                    assert lines[2].startsWith('P002,')
                    assert lines[1].contains('/out/P001/registered/P001_s1.ome.tiff')
                    assert lines[2].contains('/out/P002/registered/P002_s1.ome.tiff')
                }
            )
        }
    }

    test("writes into <outdir>/csv with the step's own basename") {

        tag "stub"

        when {
            params {
                outdir = "$outputDir"
                cleanup_level = 'none'
            }
            workflow {
                """
                input[0] = 'preprocessed'
                input[1] = Channel.of(
                    [ patient_id: 'P001', id: 'P001_s1',
                      preprocessed_image: '/out/P001/preprocessed/P001_s1.ome.tiff',
                      is_reference: true, channels: 'DAPI', pixel_size: 0.5 ]
                )
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // lib/Layout.groovy owns both the directory and the basename; this
                // asserts the writer ASKS it rather than composing a path.
                { assert file(workflow.out.csv[0]).name == 'preprocessed.csv' },
                { assert file("$outputDir/csv/preprocessed.csv").exists() }
            )
        }
    }

    test("writes NOTHING at a cleaning level") {

        tag "stub"

        when {
            params {
                outdir = "$outputDir"
                cleanup_level = 'final'
            }
            workflow {
                """
                input[0] = 'registered'
                input[1] = Channel.of(
                    [ patient_id: 'P001', id: 'P001_s1',
                      registered_image: '/out/P001/registered/P001_s1.ome.tiff',
                      is_reference: true, channels: 'DAPI', pixel_size: 0.325 ]
                )
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // Not "an empty file" and not "a header-only file": NO file. A manifest
                // whose rows name artifacts a cleaning level never published is worse
                // than no manifest, because --start and add_cycle both OPEN what it
                // names. See Checkpoint.writesAtLevel. Filtering the SOURCE (rather
                // than wrapping the chain in an `if`) is what makes this hold: an empty
                // channel into a seeded collectFile writes no file at all -- verified on
                // NXF_VER=26.04.6 rather than assumed, because a seeded collectFile
                // emitting a header-only manifest would have been exactly the dangling
                // manifest this gate exists to prevent.
                { assert workflow.out.csv.size() == 0 },
                { assert !file("$outputDir/csv/registered.csv").exists() }
            )
        }
    }

    test("rejects a row whose columns disagree with the step's schema") {

        tag "stub"

        when {
            params {
                outdir = "$outputDir"
                cleanup_level = 'none'
            }
            workflow {
                """
                input[0] = 'registered'
                // `pixel_size` omitted. Checkpoint.row must refuse rather than emit an
                // empty trailing field -- an empty field in a checkpoint row is a value
                // a reader takes as real.
                input[1] = Channel.of(
                    [ patient_id: 'P001', id: 'P001_s1',
                      registered_image: '/out/P001/registered/P001_s1.ome.tiff',
                      is_reference: true, channels: 'DAPI' ]
                )
                """
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                { assert workflow.errorReport.contains('missing column') }
            )
        }
    }
}
