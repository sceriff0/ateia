nextflow_workflow {

    name "Test REGISTRATION subworkflow"
    script "subworkflows/local/registration.nf"
    workflow "REGISTRATION"

    tag "subworkflow"
    tag "registration"

    test("Should run VALIS registration - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                skip_registration_qc = true
                padding = false
            }
            workflow {
                """
                input[0] = Channel.fromList([
                    [[patient_id: 'P001', id: 'P001_ref', is_reference: true, channels: ['DAPI', 'PANCK']],
                     file('$projectDir/tests/testdata/P001_ref.ome.tiff')],
                    [[patient_id: 'P001', id: 'P001_mov1', is_reference: false, channels: ['DAPI', 'CD3']],
                     file('$projectDir/tests/testdata/P001_mov1.ome.tiff')]
                ])
                // REGISTRATION now takes only ch_preprocessed (VALIS-only)
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.checkpoint_csv },
                { assert snapshot(workflow.out.checkpoint_csv).match() }
            )
        }
    }

    // Legacy GPU/CPU registration tests moved to legacy/

    test("Should handle multi-patient registration - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                skip_registration_qc = true
                padding = false
            }
            workflow {
                """
                input[0] = Channel.fromList([
                    [[patient_id: 'P001', id: 'P001_ref', is_reference: true, channels: ['DAPI']],
                     file('$projectDir/tests/testdata/P001_ref.ome.tiff')],
                    [[patient_id: 'P001', id: 'P001_mov1', is_reference: false, channels: ['DAPI', 'CD3']],
                     file('$projectDir/tests/testdata/P001_mov1.ome.tiff')],
                    [[patient_id: 'P002', id: 'P002_ref', is_reference: true, channels: ['DAPI']],
                     file('$projectDir/tests/testdata/P002_ref.ome.tiff')]
                ])
                // REGISTRATION now takes only ch_preprocessed (VALIS-only)
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { with(workflow.out.checkpoint_csv) {
                    assert size() == 1
                }}
            )
        }
    }

    // Invalid method test removed — REGISTRATION no longer takes method param.
    // registration_method's allowed values are declared in nextflow_schema.json
    // and enforced at launch by validateParameters(); see
    // tests/param_validation.nf.test.

    test("Should handle padding workflow - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                padding = true
                skip_registration_qc = true
            }
            workflow {
                """
                input[0] = Channel.fromList([
                    [[patient_id: 'P001', id: 'P001_ref', is_reference: true, channels: ['DAPI']],
                     file('$projectDir/tests/testdata/P001_ref.ome.tiff')],
                    [[patient_id: 'P001', id: 'P001_mov1', is_reference: false, channels: ['DAPI', 'CD3']],
                     file('$projectDir/tests/testdata/P001_mov1.ome.tiff')]
                ])
                // REGISTRATION now takes only ch_preprocessed (VALIS-only)
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.checkpoint_csv }
            )
        }
    }

    test("Should skip QC when configured - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                skip_registration_qc = true
                padding = false
            }
            workflow {
                """
                input[0] = Channel.fromList([
                    [[patient_id: 'P001', id: 'P001_ref', is_reference: true, channels: ['DAPI']],
                     file('$projectDir/tests/testdata/P001_ref.ome.tiff')],
                    [[patient_id: 'P001', id: 'P001_mov1', is_reference: false, channels: ['DAPI', 'CD3']],
                     file('$projectDir/tests/testdata/P001_mov1.ome.tiff')]
                ])
                // REGISTRATION now takes only ch_preprocessed (VALIS-only)
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.checkpoint_csv }
            )
        }
    }

    /*
     * NOTHING INFERS A REFERENCE. registration.nf's grouping closure used to promote
     * items[0] -- whichever slide arrived first -- and it did so DOWNSTREAM of the
     * preprocessing checkpoint writer, so a run that auto-promoted wrote
     * csv/preprocessed.csv with is_reference=false on every row and its own
     * `--start registration` then refused to read it. Auto-promotion, and the
     * parameter that enabled it, are gone (commit b63b986); the reference is resolved
     * once at samplesheet-read time in INPUT_CHECK (CsvUtils.resolveReferenceRows) and
     * arrives in meta.is_reference. What survives in registration.nf is a GUARD on that
     * invariant, and these two cases are what pin it.
     *
     * These cases used to set `allow_auto_reference` (true here, false below) to assert
     * that the flag changed nothing. The flag no longer EXISTS -- it is absent from
     * nextflow.config, nextflow_schema.json, lib/, subworkflows/ and workflows/ -- and
     * nextflow.config sets validation.logging.unrecognisedParams = 'error', so a run
     * that set it would ABORT. These cases survived only because nf-test drives the
     * SUBWORKFLOW directly and never reaches workflows/mirage.nf's validateParameters()
     * -- they were green for a reason unrelated to their premise. The premise that
     * remains -- a reference-less
     * patient is refused -- is still true and still worth testing, so it is what they
     * now say.
     *
     * The refusal on a full run, from the samplesheet, is main.nf.test's "Should reject
     * a samplesheet that marks no reference".
     */
    test("Should reject a multi-slide patient that names no reference - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                skip_registration_qc = true
                padding = false
            }
            workflow {
                """
                // No is_reference=true anywhere. INPUT_CHECK would have resolved one
                // before this point on a real run; reaching REGISTRATION without one
                // means the samplesheet or checkpoint never named a reference.
                input[0] = Channel.fromList([
                    [[patient_id: 'P001', id: 'P001_ref', is_reference: false, channels: ['DAPI']],
                     file('$projectDir/tests/testdata/P001_ref.ome.tiff')],
                    [[patient_id: 'P001', id: 'P001_mov1', is_reference: false, channels: ['DAPI', 'CD3']],
                     file('$projectDir/tests/testdata/P001_mov1.ome.tiff')]
                ])
                """
            }
        }

        then {
            assert !workflow.success
            assert workflow.stdout.any { it.contains('No reference image found for patient P001') }
        }
    }

    /*
     * The SINGLE-SLIDE case, which is not a duplicate of the one above: a lone slide has
     * nothing to register against and REGISTER_PATIENT branches it straight through to
     * ch_registered. The guard must still fire, because the grouping closure runs BEFORE
     * that branch -- otherwise a reference-less patient would be silently passed through
     * as if it were registered, which is worse than the multi-slide failure since there
     * is no downstream step left to notice.
     *
     * TAGGED `stub`. It carried no tag at all, so no job on any trigger collected it:
     * CI's blocking gate is `nf-test test --tag stub`, the real leg is `--tag real`, and
     * 243 collected cases were 213 stub + 28 real + 1 security + this orphan.
     */
    test("Should reject a single-slide patient that names no reference - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                skip_registration_qc = true
                padding = false
            }
            workflow {
                """
                input[0] = Channel.fromList([
                    [[patient_id: 'P001', id: 'P001_ref', is_reference: false, channels: ['DAPI']],
                     file('$projectDir/tests/testdata/P001_ref.ome.tiff')]
                ])
                // REGISTRATION now takes only ch_preprocessed (VALIS-only)
                """
            }
        }

        then {
            assert !workflow.success
            assert workflow.stdout.any { it.contains('No reference image found for patient P001') }
        }
    }

    test("Should not run seg-QC segmentation for a single-slide patient - stub") {

        // Single-slide patients have nothing to register and are branched straight
        // through to ch_registered (see the "single" branch in registration.nf).
        // Their reference must NOT be fed into SEG_QC: there is no moving slide to
        // score it against, so a full GPU StarDist segmentation would be computed
        // and thrown away. Guarded alongside a two-slide patient (below) so a fix
        // that disables seg-QC entirely would also fail this test.

        tag "stub"
        options "-stub"

        when {
            params {
                reg_qc = 2
                padding = false
            }
            workflow {
                """
                input[0] = Channel.fromList([
                    [[patient_id: 'P001', id: 'P001_ref', is_reference: true, channels: ['DAPI']],
                     file('$projectDir/tests/testdata/P001_ref.ome.tiff')]
                ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().findAll {
                    it.name.contains('SEG_QC_GEOJSON')
                }.size() == 0 }
            )
        }
    }

    test("Should still run seg-QC segmentation for both slides of a two-slide patient - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                reg_qc = 2
                padding = false
            }
            workflow {
                """
                input[0] = Channel.fromList([
                    [[patient_id: 'P002', id: 'P002_ref', is_reference: true, channels: ['DAPI']],
                     file('$projectDir/tests/testdata/P002_ref.ome.tiff')],
                    [[patient_id: 'P002', id: 'P002_P001_mov1', is_reference: false, channels: ['DAPI', 'CD3']],
                     file('$projectDir/tests/testdata/P001_mov1.ome.tiff')]
                ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.trace.tasks().findAll {
                    it.name.contains('SEG_QC_GEOJSON')
                }.size() == 2 }
            )
        }
    }

    test("Should seg-QC score a multi-slide patient whose reference is not the first slide by id - stub") {

        // A multi-slide patient must be seg-QC scored regardless of WHERE its reference
        // sits in the group. seg_qc.nf's reference/moving branch (seg_qc.nf:52-55) reads
        // meta.is_reference, and such a patient once produced ZERO seg-QC output: the
        // reference branch was empty, so the combine-by-patient join matched nothing.
        //
        // The MECHANISM that used to break it is gone. registration.nf's grouping closure
        // used to pick a reference itself and mutate that item's meta to
        // is_reference: true *inside the grouped list*, so whether a consumer saw the
        // mutation depended on which channel it read from. The reference is now resolved
        // once in INPUT_CHECK (CsvUtils.resolveReferenceRows) and arrives already
        // stamped, so no consumer can disagree about it -- which is why the input below
        // carries is_reference: true on one slide: that is exactly the shape INPUT_CHECK
        // hands REGISTRATION.
        //
        // This case used to set `allow_auto_reference = true`, a parameter deleted in
        // b63b986; it changed nothing here even when it existed, since the input below
        // already names its reference. Removed rather than replaced.
        //
        // The assertion still earns its place: it pins the OUTCOME (this patient gets
        // scored) rather than the mechanism, so it survives the next reshuffle of where
        // SEG_QC draws its stream from.

        tag "stub"
        options "-stub"

        when {
            params {
                reg_qc = 2
                padding = false
            }
            workflow {
                """
                // Two slides, one of them marked -- the shape INPUT_CHECK produces.
                input[0] = Channel.fromList([
                    [[patient_id: 'P003', id: 'P003_P002_ref', is_reference: true, channels: ['DAPI']],
                     file('$projectDir/tests/testdata/P002_ref.ome.tiff')],
                    [[patient_id: 'P003', id: 'P003_P001_mov1', is_reference: false, channels: ['DAPI', 'CD3']],
                     file('$projectDir/tests/testdata/P001_mov1.ome.tiff')]
                ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // Both slides were segmented (the waste-avoidance guard above does not
                // apply here — this patient has two slides, not one).
                { assert workflow.trace.tasks().findAll {
                    it.name.contains('SEG_QC_GEOJSON')
                }.size() == 2 },
                // The reference/moving split in seg_qc.nf actually resolved: one
                // moving slide was scored against the auto-picked reference. Before
                // this task's channel swap this was empty (the bug this test guards).
                { assert workflow.out.seg_qc.size() == 1 }
            )
        }
    }

    test("Should register images using VALIS - real") {

        tag "real"
        tag "slow"

        when {
            params {
                outdir = "$outputDir"
                skip_registration_qc = true
                padding = false
            }
            workflow {
                """
                input[0] = Channel.fromList([
                    [[patient_id: 'P001', id: 'P001_ref', is_reference: true, channels: ['DAPI', 'PANCK', 'SMA']],
                     file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true)],
                    [[patient_id: 'P001', id: 'P001_mov1', is_reference: false, channels: ['DAPI', 'CD3', 'CD8']],
                     file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true)]
                ])
                // REGISTRATION now takes only ch_preprocessed (VALIS-only)
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // Registered outputs exist
                { with(workflow.out.registered) {
                    assert size() == 2
                    // At least one output file exists with real data
                    assert get(0).get(1) != null
                    assert get(1).get(1) != null
                }},
                // patient_id preserved in all outputs
                { with(workflow.out.registered) {
                    def patient_ids = collect { it[0].patient_id }
                    assert patient_ids.every { it == 'P001' }
                }},
                // Checkpoint CSV created
                { with(workflow.out.checkpoint_csv) {
                    assert size() == 1
                    assert file(get(0)).exists()
                }}
            )
        }
    }
}
