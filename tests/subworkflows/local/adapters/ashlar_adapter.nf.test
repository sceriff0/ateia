/*
 * ASHLAR_ADAPTER -- the adapter contract, end to end.
 *
 * Every registration adapter must emit the SAME seven names, filling with Channel.empty()
 * anything its method cannot produce (see the contract in adapters/tiled_adapter.nf's header).
 * register_patient.nf binds one name, `ch_adapter`, and passes all seven straight through, so a
 * missing emit is a compile error but a WRONGLY-SHAPED one is not -- it surfaces much later as
 * an empty QC page or an unwritten checkpoint.
 *
 * Two things here are specific to this backend and are the reason the test exists:
 *
 *  1. the reference is retiled TOO. ashlar's EdgeAligner has to stitch the reference grid
 *     before LayerAligner can align anything onto it, so ASHLAR_RETILE runs once per SLIDE,
 *     not once per moving slide. An adapter that retiled only the movers would still emit a
 *     manifest and still look green.
 *  2. the reference reaches `registered` as a PASSTHROUGH. No ashlar process writes it, so
 *     registered_checkpoint.nf must record where its producer published it rather than a path
 *     under <pid>/registered/ that nothing ever wrote.
 */
nextflow_workflow {

    name "Test ASHLAR_ADAPTER contract"
    script "subworkflows/local/adapters/ashlar_adapter.nf"
    workflow "ASHLAR_ADAPTER"

    tag "subworkflow"
    tag "ashlar_adapter"
    tag "stub"

    test("Should emit the full adapter vocabulary for a two-mover patient - stub") {

        options "-stub"

        when {
            params {
                registration_method = 'ashlar'
            }
            workflow {
                """
                input[0] = Channel.fromList([
                    [
                        'P001',
                        [[patient_id: 'P001', is_reference: true, channels: ['DAPI']],
                         file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true)],
                        [
                            [[patient_id: 'P001', is_reference: true, channels: ['DAPI']],
                             file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true)],
                            [[patient_id: 'P001', is_reference: false, channels: ['DAPI', 'CD3']],
                             file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true)],
                            [[patient_id: 'P001', is_reference: false, channels: ['DAPI', 'CD8']],
                             file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true)]
                        ]
                    ]
                ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },

                // Two movers warped, plus the reference passed through unwarped.
                { assert workflow.out.registered.size() == 3,
                    "expected 2 warped movers + 1 passthrough reference, got " +
                    workflow.out.registered.size() },

                // One transform per MOVING slide, under both keyings.
                { assert workflow.out.transform.size() == 2 },
                { assert workflow.out.transform_by_slide.size() == 2 },
                { assert workflow.out.intrinsic_tre.size() == 2 },

                // The null object the contract requires: ashlar composes nothing
                // destructively, so there is no pre-micro checkpoint to hand over.
                { assert workflow.out.stage_checkpoint.size() == 0,
                    "stage_checkpoint must be the Channel.empty() null object" },

                // THREE size logs, not two -- the reference is retiled as well. This is the
                // assertion that fails if ASHLAR_RETILE is wired to the movers only.
                { assert workflow.out.size_logs.size() == 3,
                    "ASHLAR_RETILE must run on every slide including the reference " +
                    "(EdgeAligner stitches the reference grid first); got " +
                    workflow.out.size_logs.size() + " size logs" },

                { assert workflow.out.versions.size() >= 1 },

                // transform is keyed by patient_id, transform_by_slide by meta.
                { assert workflow.out.transform.every { it[0] == 'P001' } },
                { assert workflow.out.transform_by_slide.every { it[0].patient_id == 'P001' } },
                { assert workflow.out.transform.every { it[1].toString().endsWith('_manifest.json') } },

                // The unwarped reference must be flagged, or the checkpoint writer records a
                // path under <pid>/registered/ that no ashlar process ever wrote to.
                { assert workflow.out.registered.count { it[0].is_passthrough } == 1,
                    "exactly one registered item (the reference) must carry is_passthrough" },
                { assert workflow.out.registered.count { it[0].is_reference } == 1 }
            )
        }
    }
}
