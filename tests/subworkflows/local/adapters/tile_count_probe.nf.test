/*
 * Agreement between countTileRows() and Nextflow's own splitCsv(header: true) -- the invariant
 * that actually matters for the tiled fan-in's groupKey sizing (see tile_count_probe.nf and
 * tiled_adapter_group_size.nf.test for the fuller rationale). tiled_adapter.nf feeds
 * TILED_COARSE.out.tiles's *same* CSV file to both countTileRows (to size the groupKey) and
 * splitCsv(header: true, elem: 1) (to fan out one task per row) -- if the two ever disagree on
 * a real file, the gather either hangs (count too high) or truncates control points (count too
 * low, closing the group before all of that slide's tiles have reported in).
 *
 * Run against fixtures generated by tests/testdata/generate_complete_testdata.py: a normal
 * 12-row plan, one with a trailing blank line, and one with a blank line interspersed among
 * data rows -- the same edge cases countTileRows's own unit tests cover in isolation
 * (tiled_adapter_group_size.nf.test), now checked against the real operator instead of just
 * asserting a hand-verified expected number.
 */
nextflow_workflow {

    name "Test countTileRows agrees with splitCsv(header: true) on the same file"
    script "tests/subworkflows/local/adapters/tile_count_probe.nf"
    workflow "TILE_COUNT_PROBE"

    tag "subworkflow"
    tag "tiled_adapter"

    test("12-row tile plan: countTileRows equals splitCsv's row count") {

        when {
            workflow {
                """
                input[0] = Channel.of(file('$projectDir/tests/testdata/tiles_12_rows.csv', checkIfExists: true))
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.derived == workflow.out.split_count },
                { assert workflow.out.derived[0] == 12 }
            )
        }
    }

    test("12-row tile plan with a trailing blank line: countTileRows equals splitCsv's row count") {

        when {
            workflow {
                """
                input[0] = Channel.of(file('$projectDir/tests/testdata/tiles_12_rows_trailing_blank.csv', checkIfExists: true))
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.derived == workflow.out.split_count },
                { assert workflow.out.derived[0] == 12 }
            )
        }
    }

    test("12-row tile plan with a blank line interspersed: countTileRows equals splitCsv's row count") {

        when {
            workflow {
                """
                input[0] = Channel.of(file('$projectDir/tests/testdata/tiles_12_rows_blank_interspersed.csv', checkIfExists: true))
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.derived == workflow.out.split_count },
                { assert workflow.out.derived[0] == 12 }
            )
        }
    }

    test("header-only tile plan: countTileRows agrees with splitCsv at zero rows") {

        when {
            workflow {
                """
                input[0] = Channel.of(file('$projectDir/tests/testdata/tiles_header_only.csv', checkIfExists: true))
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.derived == workflow.out.split_count },
                { assert workflow.out.derived[0] == 0 }
            )
        }
    }
}
