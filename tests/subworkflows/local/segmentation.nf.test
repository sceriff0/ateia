// RUN LOCALLY, and these tests pass. An earlier header here said "UNVERIFIED
// LOCALLY: nf-test ... hangs under qemu on this host ... but never run", which was
// wrong in a way that mattered: it is nf-test.config's DEFAULT profile (test,docker)
// that hangs, because it resolves and pulls amd64 images under qemu. Drop docker and
// `nf-test test --tag stub --profile test` runs the whole blocking gate in about 16
// minutes. Believing the old note means skipping the only local check that catches an
// nf-test file missing its `stub` tag -- which CI's gate would then never run either.
//
// Covers the two workflows in subworkflows/local/segmentation.nf and the exact
// regression that task's review found: nuclei_mask silently withheld when
// --quantify_compartments is false, which drops every patient from postprocess.nf's
// plain `ch_cell_mask.join(ch_nuclei_mask)`.
//
// Both SEGMENTATION and READ_SEGMENTED_CHECKPOINT gained a second take: input,
// compartment_mode -- Task 4 (arch-B-split)'s seam for --quantify_compartments /
// --quantify_statistics / --embed_masks, resolved once by workflows/mirage.nf
// in production and threaded down the same way here. Every test below sets
// input[1] accordingly. The two "compartments off"/"no compartments" tests pass a
// LITERAL map ([compartments: false, ...]) that DIVERGES from params (left at its
// true default), proving the workflow honours the argument rather than
// re-reading params.quantify_compartments -- an argument that always agreed with
// ParamUtils.compartmentMode(params) could not tell the two apart. The other
// three tests keep ParamUtils.compartmentMode(params) as the baseline positive
// path.

nextflow_workflow {

    name "Test SEGMENTATION subworkflow"
    script "subworkflows/local/segmentation.nf"
    workflow "SEGMENTATION"

    tag "subworkflow"
    tag "segmentation"

    test("Should segment the reference and write one checkpoint row per slide - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                seg_gpu = false
            }
            workflow {
                """
                input[0] = Channel.fromList([
                    [[patient_id: 'P001', id: 'P001', is_reference: true,  channels: ['DAPI', 'PANCK', 'SMA']],
                     file('$projectDir/tests/testdata/P001_ref.ome.tiff')],
                    [[patient_id: 'P001', id: 'P001', is_reference: false, channels: ['DAPI', 'CD3', 'CD8']],
                     file('$projectDir/tests/testdata/P001_mov1.ome.tiff')],
                    [[patient_id: 'P001', id: 'P001', is_reference: false, channels: ['DAPI', 'VIMENTIN', 'CD45']],
                     file('$projectDir/tests/testdata/P001_mov2.ome.tiff')]
                ])
                input[1] = ParamUtils.compartmentMode(params)
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.cell_mask },
                { assert workflow.out.nuclei_mask },
                { assert workflow.out.contours },
                { assert workflow.out.checkpoint_csv },
                // One row per SLIDE (denormalised masks), not one per patient --
                // see segmentation.nf's own comment on ch_checkpoint_csv.
                { with(workflow.out.checkpoint_csv) {
                    def csv = get(0)
                    def lines = file(csv).readLines()
                    assert lines[0] == 'patient_id,registered_image,is_reference,channels,cell_mask,nuclei_mask,contours,nucleus_contours'
                    assert lines.drop(1).findAll { it.trim() }.size() == 3
                }}
            )
        }
    }

    test("Should record nuclei_mask unconditionally when --quantify_compartments is false - stub") {

        // THE regression this task's review found: SEGMENT always emits nuclei_mask
        // regardless of --quantify_compartments, and postprocess.nf's `ch_mask =
        // ch_cell_mask.join(ch_nuclei_mask, by: 0)` is a PLAIN join on that
        // invariant. Withholding nuclei_mask here (as an earlier version of this
        // checkpoint writer did, treating it as gated the same way nucleus_contours
        // is) silently emptied that join for every patient -- --start postprocessing
        // exited 0 with no postprocessed.csv, no quantification/, no geojson/ at all.
        // Only nucleus_contours -- EXTRACT_NUCLEI_PROPERTIES's own output, which does
        // not run at all under this flag -- may legitimately be empty.

        tag "stub"
        options "-stub"

        when {
            params {
                // Deliberately NOT overriding quantify_compartments/
                // quantify_statistics here -- input[1]
                // below is a LITERAL map with compartments: false, so this proves
                // SEGMENTATION honours the compartment_mode ARGUMENT, not a re-read
                // of the (here, conflicting) global param. No module downstream of
                // SEGMENTATION reads params.quantify_compartments directly, so
                // nothing else needs the raw param to agree with input[1].
                outdir = "$outputDir"
                seg_gpu = false
            }
            workflow {
                """
                input[0] = Channel.fromList([
                    [[patient_id: 'P001', id: 'P001', is_reference: true, channels: ['DAPI', 'PANCK', 'SMA']],
                     file('$projectDir/tests/testdata/P001_ref.ome.tiff')]
                ])
                input[1] = [compartments: false, statistics: ['Median'], embedMasks: false]
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { with(workflow.out.checkpoint_csv) {
                    def csv = get(0)
                    def row = file(csv).readLines()[1].split(',')
                    // patient_id, registered_image, is_reference, channels, cell_mask,
                    // nuclei_mask, contours, nucleus_contours
                    assert row[4] : "cell_mask must never be empty"
                    assert row[5] : "nuclei_mask must be populated even with --quantify_compartments false -- SEGMENT always produces it, and postprocess.nf's mask join depends on that"
                    assert row[6] : "contours must never be empty"
                    assert row.size() == 7 || row[7] == '' : "nucleus_contours is the one column allowed to be empty here"
                }}
            )
        }
    }

    test("Should error when no reference image is present - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                seg_gpu = false
            }
            workflow {
                """
                input[0] = Channel.fromList([
                    [[patient_id: 'P001', id: 'P001', is_reference: false, channels: ['DAPI', 'CD3', 'CD8']],
                     file('$projectDir/tests/testdata/P001_mov1.ome.tiff')]
                ])
                input[1] = ParamUtils.compartmentMode(params)
                """
            }
        }

        then {
            assert !workflow.success
        }
    }
}

nextflow_workflow {

    name "Test READ_SEGMENTED_CHECKPOINT subworkflow"
    script "subworkflows/local/segmentation.nf"
    workflow "READ_SEGMENTED_CHECKPOINT"

    tag "subworkflow"
    tag "segmentation"
    tag "read_segmented_checkpoint"

    test("Should read samples and re-derive contours/morphology from checkpoint masks - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                seg_gpu = false
            }
            workflow {
                """
                input[0] = "$projectDir/tests/testdata/valid_checkpoint_segmented.csv"
                input[1] = ParamUtils.compartmentMode(params)
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // Two rows in the fixture (reference + one moving slide) -> two samples.
                { with(workflow.out.samples) { assert size() == 2 } },
                // Mask/contour/morphology channels are per-PATIENT (reference row
                // only), so exactly one each for the single-patient fixture.
                { with(workflow.out.cell_mask)   { assert size() == 1 } },
                { with(workflow.out.nuclei_mask) { assert size() == 1 } },
                { with(workflow.out.contours)    { assert size() == 1 } },
                { with(workflow.out.morphology)  { assert size() == 1 } },
                { assert workflow.out.versions },
                { assert workflow.out.size_logs }
            )
        }
    }

    test("Should keep nuclei_mask populated but nucleus_contours empty when the checkpoint recorded no compartments - stub") {

        // The read-side twin of SEGMENTATION's own regression test above: a
        // checkpoint written under --quantify_compartments false still has a
        // populated nuclei_mask column (only nucleus_contours is blank), and this
        // reader must not filter nuclei_mask out because SOME row happens to have
        // an empty nucleus_contours -- the two columns are independent.
        tag "stub"
        options "-stub"

        when {
            params {
                // Deliberately NOT overriding quantify_compartments/
                // quantify_statistics -- input[1] below is
                // a LITERAL map with compartments: false, proving
                // READ_SEGMENTED_CHECKPOINT honours the compartment_mode ARGUMENT
                // (which gates whether EXTRACT_NUCLEI_PROPERTIES runs at all), not
                // a re-read of the -- here, conflicting -- global param.
                outdir = "$outputDir"
                seg_gpu = false
            }
            workflow {
                """
                input[0] = "$projectDir/tests/testdata/valid_checkpoint_segmented_no_compartments.csv"
                input[1] = [compartments: false, statistics: ['Median'], embedMasks: false]
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { with(workflow.out.cell_mask)   { assert size() == 1 } },
                { with(workflow.out.nuclei_mask) { assert size() == 1 } },
                // quantify_compartments false -> EXTRACT_NUCLEI_PROPERTIES never runs,
                // so nucleus_contours is empty (Channel.empty()), not merely unfiltered.
                { with(workflow.out.nucleus_contours) { assert size() == 0 } }
            )
        }
    }

    test("Should emit the same meta INPUT_CHECK does: patient-prefixed id and both counts - stub") {

        // ONE meta shape, from one reader. This entry point used to build its own:
        // `id: row.patient_id` (so every one of a patient's slides carried the SAME
        // id, at the one entry point where multiple patients share a collect) and no
        // counts at all (so both per-patient groupings downstream took their silent
        // unsized fallback and streaming turned off for the whole run, unreported).
        //
        // The numbers below are exactly what tests/subworkflows/local/input_check.nf.test
        // pins for the same two-slide, one-patient shape: ids 'P001_ref'/'P001_mov1',
        // images_count 2, and channels_count 5 (the reference keeps DAPI|PANCK|SMA, the
        // moving slide drops its nuclear channel and contributes CD3|CD8).

        tag "stub"
        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                seg_gpu = false
            }
            workflow {
                """
                input[0] = "$projectDir/tests/testdata/valid_checkpoint_segmented.csv"
                input[1] = ParamUtils.compartmentMode(params)
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.samples.size() == 2 },
                // Per-IMAGE id, patient-prefixed and unique — not row.patient_id.
                { assert workflow.out.samples.collect { it[0].id }.toSorted() == ['P001_mov1', 'P001_ref'] },
                { assert workflow.out.samples.every { it[0].images_count == 2 } },
                { assert workflow.out.samples.every { it[0].channels_count == 5 } },
                // The key SET, not a spot-check: a reader that quietly stopped
                // deriving one of the counts would pass every assertion above that
                // did not name it.
                { assert workflow.out.samples.every {
                    it[0].keySet().toList().toSorted() ==
                        ['channels', 'channels_count', 'id', 'images_count', 'is_reference', 'patient_id']
                }}
            )
        }
    }

    test("Should reject is_reference 'yes' rather than silently coercing it to false - stub") {

        // This reader carried its own `row.is_reference?.toLowerCase() == 'true'`,
        // one of three structurally identical lenient copies of a rule
        // CsvUtils.parseIsReference already owned strictly. 'yes' therefore became
        // FALSE here: the checkpoint's only reference row stopped being a reference,
        // cell_mask/nuclei_mask came out empty, and the run exited 0 having read a
        // corrupt checkpoint. It must raise, the same way the samplesheet entry
        // point always has.

        tag "stub"
        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                seg_gpu = false
            }
            workflow {
                """
                input[0] = "$projectDir/tests/testdata/invalid_checkpoint_segmented_bad_ref.csv"
                input[1] = ParamUtils.compartmentMode(params)
                """
            }
        }

        then {
            assertAll(
                { assert !workflow.success },
                // WHICH failure. `!workflow.success` on its own passes just as happily
                // on a typo'd fixture path as on the rejection under test, so it is not
                // a test of anything -- name the cause.
                { assert workflow.stdout.any { it.contains("Invalid is_reference value 'yes'") } },
                { assert workflow.stdout.any { it.contains("Must be 'true' or 'false'") } }
            )
        }
    }

    test("Should refuse a checkpoint with no channels column instead of emitting a countless meta - stub") {

        // The count columns size every per-patient groupTuple. A reader that
        // tolerates their absence emits a meta with no channels_count, which makes
        // the grouping fall back to unsized — the run still finishes, still exits 0,
        // and streaming is off for the whole of it with nothing said. An absent count
        // must be an explicit error at the read, not a silent degradation later.

        tag "stub"
        options "-stub"

        when {
            params {
                outdir = "$outputDir"
                seg_gpu = false
            }
            workflow {
                """
                input[0] = "$projectDir/tests/testdata/invalid_checkpoint_segmented_no_channels.csv"
                input[1] = ParamUtils.compartmentMode(params)
                """
            }
        }

        then {
            assertAll(
                { assert !workflow.success },
                // Named cause, not merely a non-zero exit -- see the note above.
                { assert workflow.stdout.any { it.contains("missing column(s) [channels]") } },
                { assert workflow.stdout.any { it.contains("invalid_checkpoint_segmented_no_channels.csv") } }
            )
        }
    }
}
