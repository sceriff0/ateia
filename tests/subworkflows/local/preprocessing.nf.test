nextflow_workflow {

    name "Test PREPROCESSING subworkflow"
    script "subworkflows/local/preprocess.nf"
    workflow "PREPROCESSING"

    tag "subworkflow"
    tag "preprocessing"

    // EVERY meta below carries images_count, and it is not decoration. PREPROCESSING
    // hands it to CHECKPOINT_WRITER as `expected_rows` -- the streaming size hint that
    // lets a finished patient's csv/preprocessed.parts/<pid>.csv be published while
    // other patients are still running -- and lib/PatientGroup.groovy now ABORTS when
    // it is absent instead of degrading to an unsized groupTuple. INPUT_CHECK injects
    // the count into every meta it produces, so a fixture without it is not a leaner
    // fixture, it is a meta this pipeline cannot produce. Until the size was mandatory
    // these fixtures silently exercised the unsized full-run barrier while appearing
    // to test the streaming path, and the checkpoint CSV still came out -- at channel
    // close. The value must equal the number of rows that patient contributes to the
    // checkpoint, i.e. the number of images it has in that test.

    test("Should run full preprocessing workflow - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                preproc_tile_size = 256
            }
            workflow {
                """
                input[0] = Channel.fromList([
                    [[patient_id: 'P001', images_count: 2, is_reference: true, channels: ['DAPI', 'PANCK', 'SMA']],
                     file('$projectDir/tests/testdata/P001_ref.ome.tiff')],
                    [[patient_id: 'P001', images_count: 2, is_reference: false, channels: ['DAPI', 'PANCK', 'SMA']],
                     file('$projectDir/tests/testdata/P001_mov1.ome.tiff')]
                ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.preprocessed },
                { assert workflow.out.checkpoint_csv },
                { assert snapshot(
                    workflow.out.preprocessed.collect { it[0] },  // metadata only
                    workflow.out.checkpoint_csv
                ).match() }
            )
        }
    }

    test("Should handle single patient - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
            }
            workflow {
                """
                input[0] = Channel.fromList([
                    [[patient_id: 'P001', images_count: 1, is_reference: true, channels: ['DAPI']],
                     file('$projectDir/tests/testdata/P001_ref.ome.tiff')]
                ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.preprocessed.size() == 1 },
                { assert workflow.out.preprocessed.collect { it[0].patient_id }.contains('P001') }
            )
        }
    }

    test("Should handle multi-patient preprocessing - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
            }
            workflow {
                """
                input[0] = Channel.fromList([
                    [[patient_id: 'P001', images_count: 2, is_reference: true, channels: ['DAPI', 'PANCK']],
                     file('$projectDir/tests/testdata/P001_ref.ome.tiff')],
                    [[patient_id: 'P001', images_count: 2, is_reference: false, channels: ['DAPI', 'PANCK']],
                     file('$projectDir/tests/testdata/P001_mov1.ome.tiff')],
                    [[patient_id: 'P002', images_count: 1, is_reference: true, channels: ['DAPI', 'PANCK']],
                     file('$projectDir/tests/testdata/P002_ref.ome.tiff')]
                ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.preprocessed.size() == 3 },
                { def patient_ids = workflow.out.preprocessed.collect { it[0].patient_id }
                  assert patient_ids.count { it == 'P001' } == 2
                  assert patient_ids.count { it == 'P002' } == 1 }
            )
        }
    }

    test("Should preserve metadata through workflow") {

        tag "stub"
        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.fromList([
                    [[patient_id: 'P001', images_count: 1, is_reference: true, channels: ['DAPI', 'PANCK'], custom: 'value'],
                     file('$projectDir/tests/testdata/P001_ref.ome.tiff')]
                ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { with(workflow.out.preprocessed) {
                    def meta = get(0)[0]
                    assert meta.patient_id == 'P001'
                    assert meta.is_reference == true
                    assert meta.channels == ['DAPI', 'PANCK']
                }}
            )
        }
    }

    test("Should create valid checkpoint CSV") {

        tag "stub"
        options "-stub"

        when {
            params {
                outdir = "${outputDir}"
            }
            workflow {
                """
                input[0] = Channel.fromList([
                    [[patient_id: 'P001', images_count: 1, is_reference: true, channels: ['DAPI']],
                     file('$projectDir/tests/testdata/P001_ref.ome.tiff')]
                ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.checkpoint_csv },
                { with(workflow.out.checkpoint_csv) {
                    assert file(get(0)).exists()
                    assert file(get(0)).name == 'preprocessed.csv'
                }}
            )
        }
    }

    test("Should preprocess two images with valid outputs - real") {

        tag "real"
        tag "slow"

        when {
            params {
                outdir = "$outputDir"
                preproc_tile_size = 256
            }
            workflow {
                """
                input[0] = Channel.fromList([
                    [[patient_id: 'P001', images_count: 2, is_reference: true, channels: ['DAPI', 'PANCK', 'SMA']],
                     file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true)],
                    [[patient_id: 'P001', images_count: 2, is_reference: false, channels: ['DAPI', 'PANCK', 'SMA']],
                     file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true)]
                ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // Preprocessed outputs exist with real data (> 1000 bytes each)
                { with(workflow.out.preprocessed) {
                    assert size() == 2
                    get(0).get(1).with { assert it.size() > 1000 }
                    get(1).get(1).with { assert it.size() > 1000 }
                }},
                // Metadata preserved
                { with(workflow.out.preprocessed) {
                    def patient_ids = collect { it[0].patient_id }
                    assert patient_ids.every { it == 'P001' }
                }},
                // Checkpoint CSV exists and has correct structure
                { with(workflow.out.checkpoint_csv) {
                    assert size() == 1
                    def csv = get(0)
                    assert file(csv).exists()
                    assert file(csv).name == 'preprocessed.csv'
                    def lines = csv.readLines()
                    // Header + at least 2 data rows
                    assert lines.size() >= 3
                    // Validate header columns
                    def header = lines[0]
                    assert header.contains('patient_id')
                    assert header.contains('preprocessed_image')
                    assert header.contains('is_reference')
                    assert header.contains('channels')
                }}
            )
        }
    }

    test("Should skip BaSiC but still emit a row per slide when skip_preprocessing - stub") {

        // The gate has to preserve two properties that are easy to break together:
        //
        //  1. Every input slide still reaches the checkpoint. PREPROCESS is what
        //     normally produces the rows, so switching it off must not drop them --
        //     a `--start registration` run reads this CSV and would silently see
        //     fewer slides.
        //  2. The recorded path names the directory the file was ACTUALLY published
        //     into. Nothing publishes into <pid>/preprocessed/ on a skipped run, so a
        //     row pointing there names a directory that does not exist -- the defect
        //     Layout.passthroughPath documents for unregistered slides, and the one
        //     tests/checkpoint_manifest.nf.test fails on.
        //
        // Conversion is deliberately NOT skipped: CONVERT_IMAGE is what standardises
        // the OME-TIFF and moves the fiducial to channel 0, which every downstream
        // step assumes.
        tag "stub"
        options "-stub"

        when {
            params {
                skip_preprocessing = true
            }
            workflow {
                """
                input[0] = Channel.fromList([
                    [[patient_id: 'P001', images_count: 2, is_reference: true, channels: ['DAPI', 'PANCK', 'SMA']],
                     file('$projectDir/tests/testdata/P001_ref.ome.tiff')],
                    [[patient_id: 'P001', images_count: 2, is_reference: false, channels: ['DAPI', 'PANCK', 'SMA']],
                     file('$projectDir/tests/testdata/P001_mov1.ome.tiff')]
                ])
                """
            }
        }

        then {
            def rows = file(workflow.out.checkpoint_csv.get(0)).readLines().findAll { it.trim() }
            def header = rows[0].split(',').toList()
            def imgCol = header.findIndexOf { it.trim() == 'preprocessed_image' }
            def paths  = rows.drop(1).collect { it.split(',')[imgCol].trim() }

            assertAll(
                { assert workflow.success },
                // Property 1: one row per input slide, header included.
                { assert rows.size() == 3,
                    "expected a header + 2 slides, got: " + rows.join(' | ') },
                { assert workflow.out.preprocessed.size() == 2 },
                // Property 2: the rows point at converted/, which CONVERT_IMAGE really
                // published into -- never at preprocessed/, which nothing wrote here.
                { assert paths.every { it.contains('/converted/') },
                    "checkpoint rows do not point at converted/: " + paths.join(' | ') },
                { assert paths.every { !it.contains('/preprocessed/') },
                    "checkpoint names <pid>/preprocessed/ on a run that never ran PREPROCESS: " + paths.join(' | ') },
                // The images handed downstream are the CONVERTED ones, so they must not
                // carry PREPROCESS's _corrected suffix.
                { assert workflow.out.preprocessed.every { !it[1].toString().contains('_corrected') },
                    "skipped run emitted a _corrected image: " + workflow.out.preprocessed }
            )
        }
    }
}
