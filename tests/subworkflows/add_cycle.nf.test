nextflow_workflow {

    name "Test ADD_CYCLE subworkflow (stub)"
    script "subworkflows/local/add_cycle.nf"
    workflow "ADD_CYCLE"

    /*
     * ADD_CYCLE now takes ONLY the new-cycle sample channel: it rebuilds the prior
     * run's reusable assets itself, from --prior_outdir's checkpoint CSVs (that
     * reconstruction, including EXTRACT_MASK_SERIES, used to live in the router).
     * tests/testdata/prior_run/ is a minimal stand-in for a completed run, written
     * by tests/testdata/generate_complete_testdata.py.
     */

    test("folds a new cycle: emits combined geojson, merged csv, and pyramid") {
        tag "stub"
        options "-stub"

        when {
            workflow {
                """
                // New cycle: one non-reference slide with DAPI + a new marker.
                input[0] = Channel.of([
                    [ id: 'P001_cycle2', patient_id: 'P001', is_reference: false,
                      channels: ['DAPI','CD8'], images_count: 1, channels_count: 2 ],
                    file('tests/testdata/P001_image.tiff')
                ])
                """
            }
            params {
                outdir = "$outputDir"
                mode = 'add_cycle'
                prior_outdir = "$projectDir/tests/testdata/prior_run"
                reg_qc = 1
                quantify_compartments = false
            }
        }

        then {
            assert workflow.success
            assert workflow.out.geojson
            assert workflow.out.merged_csv
            assert workflow.out.pyramid
        }
    }

    test("reg_qc=2 + expanded quantification: seg_qc emitted, compartment path runs") {
        tag "stub"
        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [ id: 'P001_cycle2', patient_id: 'P001', is_reference: false,
                      channels: ['DAPI','CD8'], images_count: 1, channels_count: 2 ],
                    file('tests/testdata/P001_image.tiff')
                ])
                """
            }
            params {
                outdir = "$outputDir"
                mode = 'add_cycle'
                prior_outdir = "$projectDir/tests/testdata/prior_run"
                reg_qc = 2
                quantify_compartments = true
                expanded_quantification = true
            }
        }

        then {
            assert workflow.success
            assert workflow.out.geojson
            assert workflow.out.pyramid
            assert workflow.out.seg_qc   // reg_qc=2 -> WARP_SEG_QC metrics present
        }
    }

    test("reuses the PRIOR reference: the prior run's checkpoint drives registration") {
        tag "stub"
        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [ id: 'P001_cycle2', patient_id: 'P001', is_reference: false,
                      channels: ['DAPI','CD8'], images_count: 1, channels_count: 2 ],
                    file('tests/testdata/P001_image.tiff')
                ])
                """
            }
            params {
                outdir = "$outputDir"
                mode = 'add_cycle'
                prior_outdir = "$projectDir/tests/testdata/prior_run"
                reg_qc = 1
                quantify_compartments = false
                // ADD_CYCLE registers with VALIS unconditionally: it passes the
                // LITERAL 'valis' to the shared REGISTER_PATIENT, never
                // params.registration_method. workflows/mirage.nf rejects
                // --registration_method tiled in add_cycle mode, but a caller that
                // invokes ADD_CYCLE directly -- this test, for one -- bypasses that
                // guard entirely, so the guarantee has to be pinned HERE too.
                // tests/subworkflows/local/register_patient.nf.test proves
                // REGISTER_PATIENT honours its argument; this proves add_cycle.nf
                // passes the right one. Neither test alone is sufficient.
                registration_method = 'tiled'
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // Set to 'tiled' above and still not tiled: the literal wins.
                { assert workflow.trace.tasks().findAll {
                    it.name.contains('TILED_') }.size() == 0 },
                { assert workflow.trace.tasks().findAll {
                    it.name.contains('REGISTER') }.size() == 1 },
                // The reusable masks come from the prior PYRAMID's embedded mask
                // series, not from postprocessed.csv's cell_mask column: this pins
                // that EXTRACT_MASK_SERIES really runs inside ADD_CYCLE.
                // Exactly one patient in the prior run -> one extraction, one merge.
                { assert workflow.trace.tasks().findAll {
                    it.name.contains('EXTRACT_MASK_SERIES') }.size() == 1 },
                { assert workflow.trace.tasks().findAll {
                    it.name.contains('MERGE_QUANT_CSVS') }.size() == 1 }
            )
        }
    }

}
