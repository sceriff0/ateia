/*
 * Failure-injection fixture for tests/checkpoint_durability.nf.test — "P002's
 * registration fails hard, partway through the patient list".
 *
 * Identical to tests/testdata/slow_p002_registration.config (see that file for why
 * the delay and the witness exist) plus the failure itself: after P001 has finished
 * registering and the witness has recorded what was on disk at that moment, P002's
 * REGISTER exits 1.
 *
 * The delay is what makes the case deterministic rather than a race: without it the
 * two patients' REGISTER tasks finish within milliseconds of each other, and whether
 * P001's checkpoint work was reached before the abort would be luck.
 *
 * conf/base.config's errorStrategy maps a non-signal exit status to 'finish', so the
 * run drains and then aborts — no `errorStrategy` override here, deliberately: the
 * failure this fixture injects has to be the one a real run would see, and pinning a
 * different strategy would be testing a configuration nothing ships.
 */

process {
    withName: 'REGISTER' {
        beforeScript = { task.tag != 'P002' ? 'true' : """
mkdir -p ${params.outdir}/witness
sleep 10
if [ -f "${params.outdir}/csv/registered.parts/P001.csv" ]; then
    echo PRESENT > ${params.outdir}/witness/p001_registered_rows.txt
else
    echo ABSENT > ${params.outdir}/witness/p001_registered_rows.txt
fi
echo "forced P002 registration failure" >&2
exit 1
""" }
    }
}
