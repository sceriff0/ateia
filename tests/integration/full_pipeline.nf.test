nextflow_pipeline {

    name "Full pipeline integration test"
    script "main.nf"

    tag "integration"
    tag "slow"

    test("Should complete preprocessing step with valid outputs") {

        tag "real"

        when {
            params {
                input = "$projectDir/tests/testdata/valid_preprocessing.csv"
                outdir = "$outputDir"
                start = "preprocessing"

                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false

                preproc_tile_size = 64

                // Both `preprocessed_image` and `registered_image` name INTERMEDIATE
                // artifacts, and their publishDir carries `enabled:
                // params.cleanup_level == 'none'` -- a PLAIN boolean, evaluated
                // eagerly where it appears in conf/modules.config, which
                // `includeConfig` pulls in BEFORE `profiles {}` runs. So
                // conf/test.config's own `cleanup_level = 'none'` pin never reaches
                // the gate, and the file is produced in work/ but never copied to
                // <outdir>. Setting it HERE does reach it: nf-test hands a `params
                // {}` block to Nextflow as a -params-file, and that is in the
                // binding before conf/modules.config is parsed. Measured on nightly
                // 33633986188 -- these two cases were family 3, and the sole reason
                // both nightly jobs were red.
                cleanup_level = 'none'
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // Per-patient checkpoint CSVs created
                { assert path("$outputDir/csv/preprocessed.csv").exists() },
                { assert path("$outputDir/csv/preprocessed.csv").exists() },
                // Validate P001 checkpoint has correct structure and content
                {
                    def checkpoint = path("$outputDir/csv/preprocessed.csv")
                    def lines = checkpoint.readLines()
                    assert lines.size() >= 2, "Checkpoint should have header + data"
                    def header = lines[0]
                    assert header.contains('patient_id'), "Missing patient_id column"
                    assert header.contains('preprocessed_image'), "Missing preprocessed_image column"
                    assert header.contains('is_reference'), "Missing is_reference column"
                    assert header.contains('channels'), "Missing channels column"
                },
                // Verify file paths in P001 checkpoint point to real files
                {
                    def checkpoint = path("$outputDir/csv/preprocessed.csv")
                    def lines = checkpoint.readLines()
                    def headerCols = lines[0].split(',')
                    def imgColIdx = headerCols.findIndexOf { it.trim() == 'preprocessed_image' }
                    for (int i = 1; i < lines.size(); i++) {
                        def imgPath = lines[i].split(',')[imgColIdx].trim()
                        assert path(imgPath).exists(), "Preprocessed image should exist: ${imgPath}"
                    }
                }
            )
        }
    }

    test("Should complete registration step with checkpoint outputs") {

        tag "real"

        when {
            params {
                input = "$projectDir/tests/testdata/valid_checkpoint_registration.csv"
                outdir = "$outputDir"
                start = "registration"
                max_cpus = 2
                max_memory = '6.GB'
                skip_registration_qc = true

                // Same eager-publish-gate reason as the preprocessing case above.
                cleanup_level = 'none'
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // Per-patient registration checkpoint created
                { assert path("$outputDir/csv/registered.csv").exists() },
                // Validate checkpoint structure
                {
                    def checkpoint = path("$outputDir/csv/registered.csv")
                    def lines = checkpoint.readLines()
                    assert lines.size() >= 2, "Checkpoint should have header + data"
                    def header = lines[0]
                    assert header.contains('patient_id'), "Missing patient_id column"
                    assert header.contains('registered_image'), "Missing registered_image column"
                    assert header.contains('is_reference'), "Missing is_reference column"
                    assert header.contains('channels'), "Missing channels column"
                },
                // Verify registered image paths point to real files
                {
                    def checkpoint = path("$outputDir/csv/registered.csv")
                    def lines = checkpoint.readLines()
                    def headerCols = lines[0].split(',')
                    def imgColIdx = headerCols.findIndexOf { it.trim() == 'registered_image' }
                    for (int i = 1; i < lines.size(); i++) {
                        def imgPath = lines[i].split(',')[imgColIdx].trim()
                        assert path(imgPath).exists(), "Registered image should exist: ${imgPath}"
                    }
                },
                // Patient ID consistency
                {
                    def checkpoint = path("$outputDir/csv/registered.csv")
                    def content = checkpoint.text
                    assert content.contains('P001'), "P001 should be in checkpoint"
                }
            )
        }
    }

    test("Should complete postprocessing step with full output chain") {

        tag "real"

        when {
            params {
                input = "$projectDir/tests/testdata/valid_checkpoint_segmented.csv"
                outdir = "$outputDir"
                start = "postprocessing"

                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // Verify output directory exists
                { assert path("$outputDir").exists() },
                // Verify postprocessing outputs exist for P001
                // Segmentation masks
                {
                    def segDir = path("$outputDir/P001/segmentation")
                    if (segDir.exists()) {
                        assert segDir.list().size() > 0, "Segmentation dir should have outputs"
                    }
                },
                // Quantification outputs
                {
                    def quantDir = path("$outputDir/P001/quantification")
                    if (quantDir.exists()) {
                        assert quantDir.list().size() > 0, "Quantification dir should have outputs"
                    }
                }
            )
        }
    }

    test("Should isolate multi-patient outputs - preprocessing") {

        tag "real"

        when {
            params {
                input = "$projectDir/tests/testdata/valid_preprocessing.csv"
                outdir = "$outputDir"
                start = "preprocessing"

                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false

                preproc_tile_size = 64
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // Per-patient checkpoint CSVs exist
                { assert path("$outputDir/csv/preprocessed.csv").exists() },
                { assert path("$outputDir/csv/preprocessed.csv").exists() },
                // P001 CSV has at least 1 data row
                {
                    def checkpoint = path("$outputDir/csv/preprocessed.csv")
                    def lines = checkpoint.readLines()
                    assert lines.size() >= 2, "P001 checkpoint should have header + data"
                },
                // P002 CSV has at least 1 data row
                {
                    def checkpoint = path("$outputDir/csv/preprocessed.csv")
                    def lines = checkpoint.readLines()
                    assert lines.size() >= 2, "P002 checkpoint should have header + data"
                },
                // preprocessed.csv is a single GLOBAL multi-patient checkpoint, so
                // it legitimately contains both patients. Verify no cross-contamination
                // by asserting it holds EXACTLY the expected patient ids (both present,
                // nothing leaked). The previous two assertions each demanded the global
                // file contain only one patient — mutually contradictory and unpassable.
                {
                    def checkpoint = path("$outputDir/csv/preprocessed.csv")
                    def lines = checkpoint.readLines()
                    def headerCols = lines[0].split(',')
                    def pidIdx = headerCols.findIndexOf { it.trim() == 'patient_id' }
                    def pids = (1..<lines.size()).collect { lines[it].split(',')[pidIdx].trim() } as Set
                    assert pids == (['P001', 'P002'] as Set),
                        "preprocessed.csv should contain exactly P001 and P002, found: ${pids}"
                }
            )
        }
    }

    test("Should validate all patients have outputs - preprocessing stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                input = "$projectDir/tests/testdata/valid_preprocessing.csv"
                outdir = "$outputDir"
                start = "preprocessing"

                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // Per-patient checkpoint CSVs exist for both patients
                { assert path("$outputDir/csv/preprocessed.csv").exists() },
                { assert path("$outputDir/csv/preprocessed.csv").exists() }
            )
        }
    }
}
