nextflow_pipeline {

    name "Test full MIRAGE pipeline"
    script "main.nf"

    tag "pipeline"
    tag "pipeline_mirage"

    //==========================================================================
    // NF-CORE STANDARD TESTS - Essential pipeline behavior
    //==========================================================================

    test("Should fail with missing required --input param") {
        tag "stub"

        when {
            params {
                outdir = "$outputDir"
                start = "preprocessing"
                // Note: --input is NOT set
            }
        }

        then {
            assert workflow.failed
        }
    }

    test("Should fail with missing required --outdir param") {
        tag "stub"

        when {
            params {
                input = "$projectDir/tests/testdata/test_input.csv"
                start = "preprocessing"
                // outdir is explicitly nulled out here: the "test,docker" profile
                // (nf-test.config) includes conf/test.config, which sets a default
                // outdir = "test_results". Simply omitting `outdir` from this block
                // would inherit that default and never exercise a null outdir, so
                // this test-params override (highest precedence) sets it to null
                // directly to reproduce the missing-flag case.
                outdir = null
            }
        }

        then {
            assertAll(
                { assert workflow.failed },
                // nf-schema reports "Missing required parameter(s): outdir" on
                // stderr, while the Groovy fallback (ParamUtils.validateOutdir)
                // surfaces via stdout/errorReport — search all three so this
                // asserts the operator is told *which* parameter is missing,
                // whichever layer catches it.
                { assert (workflow.stdout + workflow.stderr).any { it.contains("outdir") } ||
                         (workflow.errorReport ?: '').contains("outdir") }
            )
        }
    }

    test("Should fail with empty samplesheet") {
        tag "stub"

        when {
            params {
                input = "$projectDir/tests/testdata/empty_samplesheet.csv"
                outdir = "$outputDir"
                start = "preprocessing"
            }
        }

        then {
            assert workflow.failed
        }
    }

    test("Should handle single-sample samplesheet - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                input = "$projectDir/tests/testdata/single_sample.csv"
                outdir = "$outputDir"
                start = "preprocessing"
                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir").exists() }
            )
        }
    }

    test("Should not drop rows whose patient_id has surrounding whitespace") {
        tag "stub"
        options "-stub"

        when {
            params {
                input  = "$projectDir/tests/testdata/whitespace_patient_id.csv"
                outdir = "$outputDir"
                start  = "preprocessing"
                stop   = "preprocessing"
                seg_gpu = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // both rows must reach preprocessing, not zero and not one
                { assert path("$outputDir/csv/preprocessed.csv").readLines().size() == 3 }  // header + 2
            )
        }
    }

    test("Should complete dry_run with zero process executions") {
        tag "stub"

        when {
            params {
                input = "$projectDir/tests/testdata/test_input.csv"
                outdir = "$outputDir"
                start = "preprocessing"
                dry_run = true
            }
        }

        then {
            assert workflow.success
        }
    }

    //==========================================================================
    // TEST PROFILE TESTS - Quick validation
    //==========================================================================

    test("Should run with test profile") {
        tag "real"

        when {
            params {
                input = "$projectDir/tests/testdata/test_input.csv"
                outdir = "$outputDir"
                start = "preprocessing"
                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false
            }
        }

        then {
            assert workflow.success
            assert path("$outputDir/csv/preprocessed.csv").exists()
        }
    }

    test("Should run with test profile - stub mode") {

        tag "stub"
        options "-stub"

        when {
            params {
                input = "$projectDir/tests/testdata/test_input.csv"
                outdir = "$outputDir"
                start = "preprocessing"
                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false
            }
        }

        then {
            assert workflow.success
            assert path("$outputDir").exists()
        }
    }

    //==========================================================================
    // PREPROCESSING STEP TESTS
    //==========================================================================

    test("Should run preprocessing step - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                input = "$projectDir/tests/testdata/test_input.csv"
                outdir = "$outputDir"
                start = "preprocessing"

                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false

                preproc_tile_size = 256
                preproc_n_iter = 1
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir").exists() }
            )
        }
    }

    test("Should run preprocessing with multi-patient data") {

        tag "stub"
        options "-stub"

        when {
            params {
                input = "$projectDir/tests/testdata/valid_preprocessing.csv"
                outdir = "$outputDir"
                start = "preprocessing"

                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir/csv").exists() }
            )
        }
    }

    //==========================================================================
    // REGISTRATION STEP TESTS
    //==========================================================================

    test("Should run registration from checkpoint") {

        tag "stub"
        options "-stub"

        when {
            params {
                input = "$projectDir/tests/testdata/valid_checkpoint_registration.csv"
                outdir = "$outputDir"
                start = "registration"

                max_cpus = 2
                max_memory = '6.GB'
                skip_registration_qc = true
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir").exists() }
            )
        }
    }

    test("Should run registration with VALIS method - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                input = "$projectDir/tests/testdata/valid_checkpoint_registration.csv"
                outdir = "$outputDir"
                start = "registration"
                max_cpus = 2
                max_memory = '6.GB'
                skip_registration_qc = true
            }
        }

        then {
            assert workflow.success
        }
    }

    // Legacy registration methods (gpu, cpu, valis_pairs, cpu_tiled) moved to legacy/

    test("Should run registration with padding - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                input = "$projectDir/tests/testdata/valid_checkpoint_registration.csv"
                outdir = "$outputDir"
                start = "registration"
                padding = true

                max_cpus = 2
                max_memory = '6.GB'
                skip_registration_qc = true
            }
        }

        then {
            assert workflow.success
        }
    }

    //==========================================================================
    // POSTPROCESSING STEP TESTS
    //==========================================================================

    test("Should run postprocessing from checkpoint - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                input = "$projectDir/tests/testdata/valid_checkpoint_postprocessing.csv"
                outdir = "$outputDir"
                start = "postprocessing"

                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false
            }
        }

        then {
            assert workflow.success
        }
    }

    //==========================================================================
    // VALIDATION TESTS - Input validation
    //==========================================================================

    test("Should fail with invalid start") {
        tag "stub"

        when {
            params {
                input = "$projectDir/tests/testdata/test_input.csv"
                outdir = "$outputDir"
                start = "invalid_step_name"
            }
        }

        then {
            assert workflow.failed
            assert workflow.errorMessage != null
        }
    }

    test("Should fail with invalid registration method") {
        tag "stub"

        when {
            params {
                input = "$projectDir/tests/testdata/valid_checkpoint_registration.csv"
                outdir = "$outputDir"
                start = "registration"
                registration_method = "invalid_method"
            }
        }

        then {
            assert workflow.failed
        }
    }

    test("Should reject missing DAPI channel") {
        tag "stub"

        when {
            params {
                input = "$projectDir/tests/testdata/invalid_no_dapi.csv"
                outdir = "$outputDir"
                start = "preprocessing"
            }
        }

        then {
            assert workflow.failed
        }
    }

    test("Should reject no reference when allow_auto_reference=false") {
        tag "stub"

        when {
            params {
                input = "$projectDir/tests/testdata/invalid_no_ref.csv"
                outdir = "$outputDir"
                start = "preprocessing"
                allow_auto_reference = false
            }
        }

        then {
            assert workflow.failed
        }
    }

    test("Should accept no reference when allow_auto_reference=true") {

        tag "stub"
        options "-stub"

        when {
            params {
                input = "$projectDir/tests/testdata/invalid_no_ref.csv"
                outdir = "$outputDir"
                start = "preprocessing"
                allow_auto_reference = true

                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // The per-patient groupKey sizes come from
                // CsvUtils.countChannelsPerPatient, which drops the nuclear channel for
                // NON-reference rows. Under allow_auto_reference no row is marked
                // reference in the CSV, but registration.nf promotes the patient's first
                // image, so that slide's nuclear channel IS kept and the count must
                // include it (5 markers here, not 4). Counting 4 makes groupTuple emit at
                // size and then emit the surplus as a SECOND group, so the per-patient
                // MERGE_QUANT_CSVS / MERGE_AND_PYRAMID run twice and both writes land on
                // the same published path. `assert workflow.success` alone does not see
                // that, hence the explicit task counts.
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:POSTPROCESSING:QUANTIFY_MARKERS:QUANTIFY') }.size() == 5 },
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:POSTPROCESSING:MERGE_QUANT_CSVS') }.size() == 1 },
                { assert workflow.trace.tasks().findAll {
                    it.name.startsWith('MIRAGE:POSTPROCESSING:ASSEMBLE_EXPORT:MERGE_AND_PYRAMID') }.size() == 1 }
            )
        }
    }

    test("Should reject missing checkpoint columns") {
        tag "stub"

        when {
            params {
                input = "$projectDir/tests/testdata/invalid_checkpoint_missing_col.csv"
                outdir = "$outputDir"
                start = "registration"
            }
        }

        then {
            assert workflow.failed
        }
    }

    //==========================================================================
    // STOP PARAMETER TESTS
    //==========================================================================

    test("Should fail with invalid --stop value") {
        tag "stub"

        when {
            params {
                input = "$projectDir/tests/testdata/test_input.csv"
                outdir = "$outputDir"
                start = "preprocessing"
                stop = "invalid_stop"
            }
        }

        then {
            assert workflow.failed
        }
    }

    test("Should fail when --stop is before --start") {
        tag "stub"

        when {
            params {
                input = "$projectDir/tests/testdata/valid_checkpoint_registration.csv"
                outdir = "$outputDir"
                start = "registration"
                stop = "preprocessing"
            }
        }

        then {
            assert workflow.failed
        }
    }

    test("Should run only preprocessing when stop=preprocessing - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                input = "$projectDir/tests/testdata/test_input.csv"
                outdir = "$outputDir"
                start = "preprocessing"
                stop = "preprocessing"

                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir/csv/preprocessed.csv").exists() },
                // Registration and postprocessing must NOT have run
                { assert !path("$outputDir/csv/registered.csv").exists() },
                { assert !path("$outputDir/csv/postprocessed.csv").exists() }
            )
        }
    }

    test("Should run preprocessing+registration when stop=registration - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                input = "$projectDir/tests/testdata/test_input.csv"
                outdir = "$outputDir"
                start = "preprocessing"
                stop = "registration"

                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir/csv/preprocessed.csv").exists() },
                { assert path("$outputDir/csv/registered.csv").exists() },
                // Postprocessing must NOT have run
                { assert !path("$outputDir/csv/postprocessed.csv").exists() }
            )
        }
    }

    test("Should run only registration when start=registration stop=registration - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                input = "$projectDir/tests/testdata/valid_checkpoint_registration.csv"
                outdir = "$outputDir"
                start = "registration"
                stop = "registration"

                max_cpus = 2
                max_memory = '6.GB'
                skip_registration_qc = true
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir/csv/registered.csv").exists() },
                // Preprocessing and postprocessing must NOT have run
                { assert !path("$outputDir/csv/preprocessed.csv").exists() },
                { assert !path("$outputDir/csv/postprocessed.csv").exists() }
            )
        }
    }

    test("Should complete dry_run with stop parameter") {
        tag "stub"

        when {
            params {
                input = "$projectDir/tests/testdata/test_input.csv"
                outdir = "$outputDir"
                start = "preprocessing"
                stop = "registration"
                dry_run = true
            }
        }

        then {
            assert workflow.success
        }
    }

}
