    test("Should run only registration when start=registration stop=registration - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                input = "$projectDir/tests/testdata/valid_checkpoint_registration.csv"
                outdir = "$outputDir"
                start = "registration"
                stop = "registration"

                max_cpus = 2
                max_memory = '6.GB'
                skip_registration_qc = true
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir/csv/registered.csv").exists() },
                // Preprocessing and postprocessing must NOT have run
                { assert !path("$outputDir/csv/preprocessed.csv").exists() },
                { assert !path("$outputDir/csv/postprocessed.csv").exists() }
            )
        }
