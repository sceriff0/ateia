                { assert !path("$outputDir/csv/registered.csv").exists() },
                { assert !path("$outputDir/csv/postprocessed.csv").exists() }
            )
        }
    }

    test("Should run preprocessing+registration when stop=registration - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                input = "$projectDir/tests/testdata/test_input.csv"
                outdir = "$outputDir"
                start = "preprocessing"
                stop = "registration"

                max_cpus = 2
                max_memory = '6.GB'
                seg_gpu = false
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir/csv/preprocessed.csv").exists() },
                { assert path("$outputDir/csv/registered.csv").exists() },
