    test("every path in every checkpoint CSV exists — tiled fan-out (TILED_STITCH)") {
        tag "stub"
        options "-stub"

        when {
            params {
                // The STARE method is a per-tile fan-out ending in TILED_STITCH —
                // a different producer from VALIS's REGISTER, publishing into the
                // same `registered/` subdirectory. Asserted separately so a change
                // to either producer's output layout fails here.
                input               = "$projectDir/tests/testdata/test_input.csv"
                outdir              = "$outputDir"
                registration_method = 'tiled'
            }
        }

        then {
            assert workflow.success

            // --- the invariant ------------------------------------------------
            // TWO properties, not one.
            //
            //   1. every recorded path EXISTS, and
