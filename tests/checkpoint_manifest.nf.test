    test("every path in every checkpoint CSV exists — --start segmentation (reused registered.csv)") {
        tag "stub"
        options "-stub"

        when {
            params {
                // Precisely the shape a `csv/registered.csv` from a completed
                // registration run has -- reusing the existing single-slide-reference
                // fixture (its name predates the segmentation step; before it,
                // 'postprocessing' was the step keyed on 'registered_image', the same
                // column 'segmentation' now shares). --start segmentation reads this
                // through INPUT_CHECK, so `registered_image`'s value is ALREADY an
                // absolute published path from outside this run -- exactly the shape
                // review found segmentation.nf's writer mis-recording (it applied
                // Layout.publishedPath unconditionally, double-nesting/rewriting the
                // path against the wrong outdir; fixed via Layout.publishedOrAsIs's
                // isUnderTaskDir check). No --stop, so this run continues into
                // postprocessing too, exercising the chained failure review also
                // found ("--start postprocessing against that file fails").
                input  = "$projectDir/tests/testdata/valid_checkpoint_postprocessing.csv"
                outdir = "$outputDir"
                start  = 'segmentation'
            }
        }

        then {
            assert workflow.success

            def csvDir = new File("${outputDir}/csv".toString())
            assert csvDir.isDirectory() : "no csv/ directory was published"

            // Only segmented.csv + postprocessed.csv: entry is 'segmentation', so
            // preprocessed.csv/registered.csv are never written this run.
            def manifests = (csvDir.listFiles() ?: [])
                .findAll { it.name.endsWith('.csv') }
                .sort { it.name }
            assert manifests*.name == ['postprocessed.csv', 'segmented.csv'] :
                "expected postprocessed.csv + segmented.csv, found ${manifests*.name}"

            // segmented.csv's registered_image must be the ORIGINAL fixture path
            // (already published, outside this run entirely) -- not rewritten
            // against this run's outdir. This is the exact property Critical 1
            // broke: publishedPath applied unconditionally reconstructed it as
            // <outputDir>/P001/registered/<name>, which nothing ever publishes.
            def segLines = manifests.find { it.name == 'segmented.csv' }.readLines()
            def segRow = segLines[1].split(',')
            assert segRow[1] == "$projectDir/tests/testdata/P001_ref.ome.tiff".toString() :
                "segmented.csv rewrote registered_image against the wrong outdir: ${segRow[1]}"

            // The per-patient fragments are checkpoints too — same header, same row
            // grammar, published per patient as each one finishes
            // (lib/Layout.groovy's checkpointFragment). The invariant binds them
            // identically, and more urgently: the fragments are the copy a run that
            // lost its driver leaves behind, i.e. the copy most likely to be the one
            // someone actually restarts from.
            def fragments = []
            csvDir.eachFileRecurse { f ->
                if (f.isFile() && f.name.endsWith('.csv') && f.parentFile.name.endsWith('.parts'))
                    fragments << f
            }
            assert !fragments.isEmpty() : "no per-patient checkpoint fragments were published"

            // ONE SCHEMA, NOT TWO. Each aggregate's header is byte-identical to its
            // fragments', and its rows are exactly the union of theirs. A second row
            // grammar for the same checkpoint fails here rather than at someone's
            // restart.
            manifests.each { csv ->
                def step = csv.name - '.csv'
                def mine = fragments.findAll { it.parentFile.name == "${step}.parts".toString() }
                assert !mine.isEmpty() : "csv/${csv.name} has no per-patient fragments"
                assert mine.every { it.readLines()[0] == csv.readLines()[0] } :
                    "a fragment of csv/${csv.name} has a different header"
                assert mine.collectMany { it.readLines().drop(1) }.findAll { it.trim() }.toSorted() ==
                       csv.readLines().drop(1).findAll { it.trim() }.toSorted() :
                    "csv/${csv.name} and its fragments do not carry the same rows"
            }

            def work = new File("${workDir}".toString()).absolutePath
            def problems = []
            def checked  = 0
            (manifests + fragments).each { csv ->
                csv.readLines().drop(1).findAll { it.trim() }.each { line ->
                    line.split(',').each { field ->
                        if (field.startsWith('/')) {
                            checked++
                            if (new File(field).absolutePath.startsWith(work + File.separator))
                                problems << "${csv.name}: inside the work directory (scratch, unpublished) -> ${field}"
                            else if (!new File(field).exists())
                                problems << "${csv.name}: does not exist -> ${field}"
                        }
                    }
                }
            }
            // 5 segmented (registered_image, cell_mask, nuclei_mask, contours,
            // nucleus_contours) + 5 postprocessed (cell_csv, cell_geojson, merged_csv,
            // cell_mask, pyramid), one row each.
            assert checked == 20 :
                "expected 20 recorded paths, examined ${checked} — did the CSV columns change?"
            assert problems.isEmpty() :
                "checkpoint manifest has ${problems.size()} bad path(s):\n  " +
                problems.join("\n  ")
        }
    }

    test("every path in every checkpoint CSV exists — mode=add_cycle") {
        tag "stub"
        options "-stub"

        when {
            params {
                // The add_cycle path never goes through REGISTRATION, and until the
                // checkpoint writer was made mode-independent it wrote NO
                // csv/registered.csv at all — so this invariant had never once
                // observed an add_cycle run. It is the path with the least prior
                // coverage; assert it the moment there is something to assert.
                //
                // The prior run is the minimal tests/testdata/prior_run/ fixture and
                // the new cycle is a single non-reference slide (no reference row by
                // design — the registration reference is the frozen prior one).
                //
                // Defaults everywhere else (reg_qc=2, quantify_compartments=true),
                // like the four cases above — the manifest is what is under test, and
                // pinning unrelated knobs only makes it drift from a real run.
                input        = "$projectDir/tests/testdata/new_cycle.csv"
                outdir       = "$outputDir"
                mode         = 'add_cycle'
                prior_outdir = "$projectDir/tests/testdata/prior_run"
            }
        }

        then {
            assert workflow.success

            def csvDir = new File("${outputDir}/csv".toString())
            assert csvDir.isDirectory() : "no csv/ directory was published"

            def manifests = (csvDir.listFiles() ?: [])
                .findAll { it.name.endsWith('.csv') }
                .sort { it.name }
            // TWO, not three: add_cycle preprocesses and registers the new cycle but
            // has no POSTPROCESSING step (masks and the base quantification table are
            // reused, not re-derived), so it writes no postprocessed.csv. That gap is
            // why an add_cycle --outdir is still not a usable --prior_outdir for a
            // second add_cycle; registered.csv was the half that was missing entirely.
            assert manifests*.name == ['preprocessed.csv', 'registered.csv'] :
                "expected preprocessed.csv + registered.csv, found ${manifests*.name}"

            // --- the manifest the linear path already had, now on this path -------
            // Same column contract as the linear registered.csv, because the same
            // writer produced it — pinned here so a divergence fails rather than
            // quietly producing a manifest add_cycle's own reader cannot consume.
            def regLines = manifests.find { it.name == 'registered.csv' }.readLines()
            assert regLines[0] == 'patient_id,registered_image,is_reference,channels' :
                "registered.csv header drifted: ${regLines[0]}"

            def rows = regLines.drop(1).findAll { it.trim() }.collect { it.split(',') }
            // Two rows: the frozen prior reference (re-emitted by VALIS) and the new
            // cycle. The reference row is not optional — it is the row a follow-on
            // add_cycle filters on to recover its registration target.
            assert rows.size() == 2 : "expected 2 registered rows, got ${rows.size()}"
            assert rows.count { it[2] == 'true' } == 1 :
                "registered.csv must carry exactly one is_reference=true row"
            assert rows.every { it[0] == 'P001' }

            // --- the invariant ------------------------------------------------
            // Identical to the linear cases: every recorded path exists, and none of
            // them lies inside the (cleanable, unpublished) work directory.
            // The per-patient fragments are checkpoints too — same header, same row
            // grammar, published per patient as each one finishes
            // (lib/Layout.groovy's checkpointFragment). The invariant binds them
            // identically, and more urgently: the fragments are the copy a run that
            // lost its driver leaves behind, i.e. the copy most likely to be the one
            // someone actually restarts from.
            def fragments = []
            csvDir.eachFileRecurse { f ->
                if (f.isFile() && f.name.endsWith('.csv') && f.parentFile.name.endsWith('.parts'))
                    fragments << f
            }
            assert !fragments.isEmpty() : "no per-patient checkpoint fragments were published"

            // ONE SCHEMA, NOT TWO. Each aggregate's header is byte-identical to its
            // fragments', and its rows are exactly the union of theirs. A second row
            // grammar for the same checkpoint fails here rather than at someone's
            // restart.
            manifests.each { csv ->
                def step = csv.name - '.csv'
                def mine = fragments.findAll { it.parentFile.name == "${step}.parts".toString() }
                assert !mine.isEmpty() : "csv/${csv.name} has no per-patient fragments"
                assert mine.every { it.readLines()[0] == csv.readLines()[0] } :
                    "a fragment of csv/${csv.name} has a different header"
                assert mine.collectMany { it.readLines().drop(1) }.findAll { it.trim() }.toSorted() ==
                       csv.readLines().drop(1).findAll { it.trim() }.toSorted() :
                    "csv/${csv.name} and its fragments do not carry the same rows"
            }

            def work = new File("${workDir}".toString()).absolutePath
            def problems = []
            def checked  = 0
            (manifests + fragments).each { csv ->
                csv.readLines().drop(1).findAll { it.trim() }.each { line ->
                    line.split(',').each { field ->
                        if (field.startsWith('/')) {
                            checked++
                            if (new File(field).absolutePath.startsWith(work + File.separator))
                                problems << "${csv.name}: inside the work directory (scratch, unpublished) -> ${field}"
                            else if (!new File(field).exists())
                                problems << "${csv.name}: does not exist -> ${field}"
                        }
                    }
                }
            }
            // 1 preprocessed row + 2 registered rows, one path each.
            assert checked == 6 :
                "expected 6 recorded paths, examined ${checked} — did the CSV columns change?"
            assert problems.isEmpty() :
                "checkpoint manifest has ${problems.size()} bad path(s):\n  " +
                problems.join("\n  ")
        }
    }
}
