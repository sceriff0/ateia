nextflow_process {

    name "Test REG_COMPOSE_TILED process"
    script "modules/local/reg_compose_tiled.nf"
    process "REG_COMPOSE_TILED"

    tag "modules"
    tag "modules_local"
    tag "reg_compose_tiled"

    test("REG_COMPOSE_TILED - stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    'P001',
                    'P001_mov1',
                    file('$projectDir/tests/testdata', checkIfExists: true),
                    [ file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true) ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.field },
                { assert process.out.versions }
            )
        }
    }
}
