nextflow_process {

    name "Test APPLY_PROFILES process"
    script "modules/local/apply_profiles.nf"
    process "APPLY_PROFILES"

    tag "modules"
    tag "modules_local"
    tag "apply_profiles"

    test("Should emit a corrected slide - stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        is_reference: true,
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    file('$projectDir/tests/testdata/model_config_min.json', checkIfExists: true),
                    file('$projectDir/tests/testdata/sample_DAPI.tif', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_cell_mask.tif', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.preprocessed },
                { assert process.out.versions },
                { assert process.out.size_log },
                // The same artifact PREPROCESS published, so the `preprocessed`
                // checkpoint row and every downstream consumer are unchanged by the
                // backend swap.
                { assert process.out.preprocessed.get(0).get(1).endsWith('_corrected.ome.tif') },
                { assert process.out.preprocessed.get(0).get(0).patient_id == 'P001' },
                { assert process.out.preprocessed.get(0).get(0).channels == ['DAPI', 'PANCK', 'SMA'] }
            )
        }
    }

    test("Should pass the sidecar and both profiles to the script - rendered command") {

        // Tagged `stub` for CI's gate but NOT run with `options "-stub"` -- `-stub` never
        // evaluates a `script:` block, and what is under assertion here is the rendered
        // invocation. In particular the DARKFIELD must still be handed over even though
        // the shipped BASICPY configuration estimates none: the module writes an all-zero
        // *-dfp.ome.tif and bin/apply_basic_profiles.py reports the correction as
        // flatfield-only on that basis. Dropping the flag would lose that distinction.
        tag "stub"

        when {
            params {
                pixel_size = 0.5
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        is_reference: true,
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    file('${projectDir}/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    file('${projectDir}/tests/testdata/model_config_min.json', checkIfExists: true),
                    file('${projectDir}/tests/testdata/sample_DAPI.tif', checkIfExists: true),
                    file('${projectDir}/tests/testdata/sample_DAPI_intensity.csv', checkIfExists: true)
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('apply_basic_profiles.py')) {
                    rendered << f.text
                }
            }

            assertAll(
                { assert rendered.size() >= 1,
                    "no rendered APPLY_PROFILES .command.sh found under the task work dir" },
                { assert rendered.every { it.contains('--sidecar model_config_min.json') },
                    "rendered command does not bind --sidecar to the sidecar: " + rendered.join(' --- ') },
                // BOUND TO, not merely PRESENT. Asserting only that `--flatfield` and
                // `--darkfield` appear leaves the two paths free to swap -- in this
                // module's script: block or in the .map that feeds it -- with the whole
                // suite still green, because every Python-level test passes the profiles
                // by keyword and never sees the CLI binding. That is exactly the error
                // tests/modules/basicpy.nf.test warns about: divide by the darkfield and
                // subtract the flatfield, silently, on every pixel.
                //
                // The input tuple is (meta, ome_tiff, sidecar, darkfield, flatfield), so
                // sample_DAPI.tif is the DARKfield here and sample_DAPI_intensity.csv the
                // FLATfield. The fixtures are deliberately two DIFFERENT files: with one
                // file passed twice, a swap is unobservable.
                { assert rendered.every { it.contains('--flatfield sample_DAPI_intensity.csv') },
                    "--flatfield is not bound to the flatfield input: " + rendered.join(' --- ') },
                { assert rendered.every { it.contains('--darkfield sample_DAPI.tif') },
                    "--darkfield is not bound to the darkfield input: " + rendered.join(' --- ') },
                { assert rendered.every { it.contains('--pixel-size 0.5') },
                    "rendered command missing --pixel-size: " + rendered.join(' --- ') }
            )
        }
    }
}
