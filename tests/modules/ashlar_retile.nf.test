nextflow_process {

    name "Test ASHLAR_RETILE process"
    script "modules/local/ashlar_retile.nf"
    process "ASHLAR_RETILE"

    tag "modules"
    tag "modules_local"
    tag "ashlar_retile"

    test("Should emit a tile directory, a size log and versions - stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ patient_id: 'P001', channels: ['DAPI', 'CD3'], is_reference: false ],
                    file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.tiles
            assert process.out.versions
            assert process.out.size_log
            with(process.out.tiles) {
                assert size() == 1
                assert get(0).get(1).toString().endsWith('tiles')
            }
        }
    }

    test("Should render the grid geometry from the ashlar params - rendered command") {

        // Tagged `stub` so CI's blocking `nf-test test --tag stub` gate collects it, but
        // deliberately WITHOUT `options "-stub"` -- `-stub` never evaluates a `script:` block,
        // so no stub run can observe a rendered command at all.
        //
        // These two flags ARE the fabricated stage positions. bin/ashlar_retile.py lays its
        // grid on ashlar's own `[row, col] * tile_size * (1 - overlap)` arithmetic, which is
        // the only reason the positions ashlar computes agree with the pixels it is handed.
        // If either flag stops being rendered the script falls back to argparse -- and both
        // are `required=True`, so it would fail; but a WRONG value would not, and would
        // silently place every tile.
        tag "stub"

        when {
            process {
                """
                input[0] = [
                    [ patient_id: 'P001', channels: ['DAPI', 'CD3'], is_reference: false ],
                    file('${projectDir}/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('ashlar_retile.py')) {
                    rendered << f.text
                }
            }
            // Whole-token comparison, not a substring: an assertion written for `1024` is also
            // satisfied by `10240`, and grid granularity is the FAIRNESS knob against STARE's
            // reg_tiled_tile -- a silently different value invalidates the arm comparison
            // rather than breaking the run.
            def flagValue = { txt, flag ->
                def m = (txt =~ (java.util.regex.Pattern.quote(flag) + /\s+(\S+)/))
                m.find() ? m.group(1) : null
            }

            assertAll(
                { assert rendered.size() >= 1,
                    "no rendered ASHLAR_RETILE .command.sh found under the task work dir" },
                { assert rendered.every { flagValue(it, '--tile-size') == '1024' },
                    "--tile-size is not exactly 1024 (params.reg_ashlar_tile default); got: " +
                    rendered.collect { flagValue(it, '--tile-size') }.join(', ') },
                { assert rendered.every { flagValue(it, '--overlap') == '0.1' },
                    "--overlap is not exactly 0.1 (params.reg_ashlar_overlap default); got: " +
                    rendered.collect { flagValue(it, '--overlap') }.join(', ') }
            )
        }
    }

    test("Should track reg_ashlar_tile rather than hardcode it - rendered command") {

        // Proves the flag is live rather than coincidentally equal to the shipped default.
        // reg_ashlar_tile is the knob the arm benchmark sweeps to produce ashlar_tile1024 /
        // ashlar_tile4096, so an ignored param would collapse both arms onto one grid and
        // still publish two differently-named result trees.
        tag "stub"

        when {
            params {
                reg_ashlar_tile = 4096
            }
            process {
                """
                input[0] = [
                    [ patient_id: 'P001', channels: ['DAPI', 'CD3'], is_reference: false ],
                    file('${projectDir}/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('ashlar_retile.py')) {
                    rendered << f.text
                }
            }
            def flagValue = { txt, flag ->
                def m = (txt =~ (java.util.regex.Pattern.quote(flag) + /\s+(\S+)/))
                m.find() ? m.group(1) : null
            }
            assertAll(
                { assert rendered.size() >= 1,
                    "no rendered ASHLAR_RETILE .command.sh found under the task work dir" },
                { assert rendered.every { flagValue(it, '--tile-size') == '4096' },
                    "--tile-size did not follow params.reg_ashlar_tile=4096; got: " +
                    rendered.collect { flagValue(it, '--tile-size') }.join(', ') }
            )
        }
    }
}
