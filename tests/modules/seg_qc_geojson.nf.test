nextflow_process {

    name "Test SEG_QC_GEOJSON process"
    script "modules/local/seg_qc_geojson.nf"
    process "SEG_QC_GEOJSON"

    tag "modules"
    tag "modules_local"
    tag "seg_qc_geojson"

    test("Should trace a cell mask into a GeoJSON named for the slide - stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ patient_id: 'P001', channels: ['DAPI', 'CD3', 'CD8'],
                      is_reference: false, qc_slide: 'P001_mov1' ],
                    file('$projectDir/tests/testdata/P001_cell_mask.tif', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.geojson
            assert process.out.versions
            with(process.out.geojson) {
                assert size() == 1
                assert get(0).get(0).patient_id == 'P001'
                // The stem is meta.qc_slide, NOT the mask's filename. WARP_SEG_QC looks the
                // slide up in the registrar by this name, and the mask cannot supply it: the
                // stardist backend names masks after the input image stem while instantseg
                // and cellsam name them after ext.prefix.
                assert get(0).get(1).toString().endsWith('P001_mov1.geojson')
            }
        }
    }

    test("Should invoke mask_to_geojson.py with --tolerance and NO segmentation flags - rendered command") {

        // Tagged `stub` so CI's blocking `nf-test test --tag stub` gate runs it, but
        // deliberately WITHOUT `options "-stub"` -- `-stub` never evaluates a `script:`
        // block, so no stub run can observe a rendered command at all.
        //
        // This case is the one that pins the change. SEG_QC_GEOJSON used to run StarDist
        // itself (bin/segment_to_geojson.py + starDistCommonFlags()), which made it the one
        // segmenter in the pipeline that ignored params.seg_method: at the shipped default
        // (seg_method='instantseg') the registration QC scored a different segmenter's cells
        // than the run shipped, and at stock defaults it could not run at all
        // (segmentation_model is not a StarDist built-in and segmentation_model_dir is null
        // -> FileNotFoundError, swallowed by the QC errorStrategy's 'ignore' branch). The
        // segmentation moved to SEG_QC_SEGMENT -- `SEGMENT` aliased -- so the NEGATIVE
        // assertions below are the substance: a rendered command carrying any StarDist flag
        // means the old code path came back.
        //
        // No container engine is active under `-profile test`, so this runs
        // bin/mask_to_geojson.py directly against the real fixture mask. It happens to
        // succeed where the StarDist version could not, but the assertions read the
        // rendered .command.sh rather than the outcome either way.
        tag "stub"

        when {
            process {
                """
                input[0] = [
                    [ patient_id: 'P001', channels: ['DAPI', 'CD3', 'CD8'],
                      is_reference: false, qc_slide: 'P001_mov1' ],
                    file('${projectDir}/tests/testdata/P001_cell_mask.tif', checkIfExists: true)
                ]
                """
            }
        }

        then {
            // Nextflow lays tasks out as <workDir>/<2 hex>/<30 hex>/.command.sh.
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('mask_to_geojson.py')) {
                    rendered << f.text
                }
            }

            assertAll(
                { assert rendered.size() >= 1,
                    "no rendered SEG_QC_GEOJSON .command.sh found under the task work dir" },
                // The one tunable left, and it must equal what EXTRACT_CELL_PROPERTIES gets
                // (params.simplify_tolerance) or the two GeoJSONs WARP_SEG_QC compares stop
                // being comparable.
                { assert rendered.every { it.contains('--tolerance 1.0') },
                    "rendered command missing --tolerance: " + rendered.join(' --- ') },
                { assert rendered.every { it.contains('--out P001_mov1.geojson') },
                    "rendered command does not name the GeoJSON after meta.qc_slide: " + rendered.join(' --- ') },
                // The assertions with teeth: every one of these appeared in this process'
                // rendered command before the change and must never appear again.
                { assert rendered.every { !it.contains('segment_to_geojson.py') },
                    "SEG_QC_GEOJSON is segmenting again: " + rendered.join(' --- ') },
                { assert rendered.every { !it.contains('--model-name') && !it.contains('--model-dir') },
                    "rendered command carries a StarDist model flag: " + rendered.join(' --- ') },
                { assert rendered.every { !it.contains('--n-tiles') && !it.contains('--prob-thresh') },
                    "rendered command carries StarDist inference flags: " + rendered.join(' --- ') },
                { assert rendered.every { !it.contains('--expand-distance') },
                    "rendered command carries --expand-distance: the mask is already expanded by " +
                    "SEG_QC_SEGMENT: " + rendered.join(' --- ') },
                { assert rendered.every { !it.contains('--nuclear-markers') && !it.contains('--dapi-channel') },
                    "rendered command still resolves a nuclear channel; that is the segmenter's " +
                    "job now: " + rendered.join(' --- ') },
                { assert rendered.every { !it.contains('--use-gpu') },
                    "rendered command asks for a GPU; contour tracing is pure CPU: " + rendered.join(' --- ') }
            )
        }
    }
}
