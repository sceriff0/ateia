nextflow_process {

    name "Test MERGE_SEG_EVAL process"
    script "modules/local/merge_seg_eval.nf"
    process "MERGE_SEG_EVAL"

    tag "modules"
    tag "modules_local"
    tag "merge_seg_eval"

    test("Should merge per-patient seg-eval JSONs into a CSV - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                // Same ext.when gate as SEG_QUALITY_EVAL: CSE is opt-in and the
                // param ships true, so without this the process never runs.
                skip_seg_quality_eval = false
            }
            process {
                """
                // Generated by tests/testdata/generate_complete_testdata.py, never
                // committed -- tests/testdata/ is gitignored, so a hand-written
                // fixture would be absent in CI. These two were referenced here and
                // produced by nothing after the CSE removal in cea0b47 stranded
                // them, which is why this test could not pass anywhere.
                input[0] = [
                    file('$projectDir/tests/testdata/seg_eval_P001.json', checkIfExists: true),
                    file('$projectDir/tests/testdata/seg_eval_P002.json', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.csv
            assert process.out.versions

            assert snapshot(process.out.versions).match()
        }
    }
}
