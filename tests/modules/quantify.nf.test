nextflow_process {

    name "Test QUANTIFY process"
    script "modules/local/quantify.nf"
    process "QUANTIFY"

    tag "modules"
    tag "modules_local"
    tag "quantify"

    test("Should quantify a whole patient in one task - stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [patient_id: 'P001', channels: ['DAPI', 'PANCK', 'SMA'], id: 'P001', channel_name: 'DAPI'],
                    [[name: 'DAPI', output: 'P001_sample_DAPI_quant.csv']],
                    [file('$projectDir/tests/testdata/sample_DAPI.tif', checkIfExists: true)],
                    file('$projectDir/tests/testdata/P001_cell_mask.npy', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_cell_mask.tif', checkIfExists: true),
                    // 6th slot: the REDSEA geometry. Always present so QUANTIFY has ONE
                    // input arity regardless of --redsea; assets/NO_REDSEA is the
                    // placeholder the module gates on by filename.
                    file('$projectDir/assets/NO_REDSEA', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.individual_csv
            assert process.out.versions

            with(process.out.individual_csv) {
                assert size() == 1
                assert get(0).get(0).patient_id == 'P001'
                assert get(0).get(1).toString().endsWith('_quant.csv')
            }
        }
    }

    test("Should emit one CSV per marker from a single task - stub") {

        // The task-count change itself. Three markers used to be three tasks and
        // three single-file emissions; they are now ONE task emitting a LIST of
        // three CSVs, named exactly as the fan-out named them.
        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [patient_id: 'P001', channels: ['DAPI', 'PANCK', 'SMA'], id: 'P001', channel_name: 'DAPI'],
                    [[name: 'DAPI',  output: 'P001_sample_DAPI_quant.csv'],
                     [name: 'PANCK', output: 'P001_sample_PANCK_quant.csv'],
                     [name: 'SMA',   output: 'P001_sample_SMA_quant.csv']],
                    [file('$projectDir/tests/testdata/sample_DAPI.tif',  checkIfExists: true),
                     file('$projectDir/tests/testdata/sample_PANCK.tif', checkIfExists: true),
                     file('$projectDir/tests/testdata/sample_SMA.tif',   checkIfExists: true)],
                    file('$projectDir/tests/testdata/P001_cell_mask.npy', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_cell_mask.tif', checkIfExists: true),
                    file('$projectDir/assets/NO_REDSEA', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                // ONE emission (one task), carrying THREE CSVs.
                { assert process.out.individual_csv.size() == 1 },
                { assert process.out.individual_csv.get(0).get(1).collect { file(it).name }.toSorted() ==
                         ['P001_sample_DAPI_quant.csv',
                          'P001_sample_PANCK_quant.csv',
                          'P001_sample_SMA_quant.csv'] },
                // One size-log row per PATIENT now, not one per marker.
                { assert process.out.size_log.size() == 1 }
            )
        }
    }

    test("Should produce CSV with expected columns - real") {

        tag "real"
        tag "slow"

        when {
            params {
                // Asked for explicitly. This case's contract is the FULL
                // per-compartment table, and the default is Median-only since
                // quantify_statistics replaced expanded_quantification -- relying
                // on the default here would silently reduce what it checks from
                // 11 columns to 5 while still passing.
                quantify_statistics = ['Median', 'Mean', 'Sum']
            }
            process {
                """
                input[0] = [
                    [patient_id: 'P001', channels: ['DAPI', 'PANCK', 'SMA'], id: 'P001', channel_name: 'DAPI'],
                    [[name: 'DAPI', output: 'P001_sample_DAPI_quant.csv']],
                    [file('$projectDir/tests/testdata/sample_DAPI.tif', checkIfExists: true)],
                    file('$projectDir/tests/testdata/P001_cell_mask.npy', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_cell_mask.tif', checkIfExists: true),
                    file('$projectDir/assets/NO_REDSEA', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.individual_csv },
                // Validate CSV content. quantify_compartments defaults true and
                // the params block above asks for all three compartment statistics,
                // so the contract is: label + bare marker + {Median,Mean,Sum} x
                // {Nucleus,Cytoplasm,Cell} = 2 + 3*3 = 11 columns.
                {
                    def csvFile = process.out.individual_csv.get(0).get(1)
                    def lines = path(csvFile).readLines()
                    assert lines.size() > 1, "CSV should have header + data rows"
                    def header = lines[0].split(',')
                    assert header.size() == 11, "CSV should have exactly 11 columns (label + marker + 3 statistics x 3 compartments), got ${header.size()}: ${header}"
                    assert header[0] == 'label', "First column should be 'label'"
                    assert header[1] == 'DAPI', "Second column should be the bare (whole-cell mean) marker column"
                    assert header.contains('DAPI: Cell: Median'), "Should have whole-cell Median column"
                    assert header.contains('DAPI: Nucleus: Median'), "Should have Nucleus Median column"
                    assert header.contains('DAPI: Cytoplasm: Median'), "Should have Cytoplasm Median column"
                    assert lines.size() - 1 > 0, "CSV should have at least one data row"
                },
                // Metadata preserved
                { assert process.out.individual_csv.get(0).get(0).patient_id == 'P001' }
            )
        }
    }

    test("Should produce non-negative intensity values with correct cell count - regression") {

        tag "real"
        tag "slow"
        tag "regression"

        when {
            process {
                """
                input[0] = [
                    [patient_id: 'P001', channels: ['DAPI', 'PANCK', 'SMA'], id: 'P001', channel_name: 'DAPI'],
                    [[name: 'DAPI', output: 'P001_sample_DAPI_quant.csv']],
                    [file('$projectDir/tests/testdata/sample_DAPI.tif', checkIfExists: true)],
                    file('$projectDir/tests/testdata/P001_cell_mask.npy', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_cell_mask.tif', checkIfExists: true),
                    file('$projectDir/assets/NO_REDSEA', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                // Cell count should match mask (20 cells, some may be filtered by min_area)
                {
                    def csvFile = process.out.individual_csv.get(0).get(1)
                    def lines = path(csvFile).readLines()
                    def cellCount = lines.size() - 1
                    assert cellCount > 0, "Must have at least one cell"
                    assert cellCount <= 20, "Should not exceed 20 cells from synthetic mask"
                },
                // All intensity values should be non-negative (DAPI synthetic range: 8000-15000)
                {
                    def csvFile = process.out.individual_csv.get(0).get(1)
                    def lines = path(csvFile).readLines()
                    def valueIdx = 1  // second column is the intensity
                    lines[1..-1].each { line ->
                        def val = line.split(',')[valueIdx] as double
                        assert val >= 0, "Intensity must be >= 0, got ${val}"
                    }
                },
                // Labels should be positive integers matching mask labels
                {
                    def csvFile = process.out.individual_csv.get(0).get(1)
                    def lines = path(csvFile).readLines()
                    lines[1..-1].each { line ->
                        def label = line.split(',')[0] as int
                        assert label > 0, "Label must be > 0 (background excluded)"
                    }
                }
            )
        }
    }

    test("Should invoke quantify.py ONCE for a patient's whole panel - rendered command") {

        // THE assertion for the batching. Tagged `stub` so CI's blocking gate runs
        // it, deliberately WITHOUT `options "-stub"`: `-stub` never evaluates a
        // `script:` block, so a stub run cannot see how the command is built at all.
        //
        // Three things are pinned, and all three are what "one task per patient"
        // means at the command level:
        //   - exactly ONE quantify.py invocation exists for three markers;
        //   - all three tiffs are passed to it, positionally paired with...
        //   - ...all three DECLARED names and all three output filenames.
        // A regression to the fan-out would render three commands; a regression to
        // one command per marker inside a loop would render one command with one
        // tiff. Both fail here.
        tag "stub"

        when {
            process {
                """
                input[0] = [
                    [patient_id: 'P001', channels: ['DAPI', 'PANCK', 'SMA'], id: 'P001', channel_name: 'DAPI'],
                    [[name: 'DAPI',  output: 'P001_sample_DAPI_quant.csv'],
                     [name: 'PANCK', output: 'P001_sample_PANCK_quant.csv'],
                     [name: 'SMA',   output: 'P001_sample_SMA_quant.csv']],
                    [file('$projectDir/tests/testdata/sample_DAPI.tif',  checkIfExists: true),
                     file('$projectDir/tests/testdata/sample_PANCK.tif', checkIfExists: true),
                     file('$projectDir/tests/testdata/sample_SMA.tif',   checkIfExists: true)],
                    file('$projectDir/tests/testdata/P001_cell_mask.npy', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_cell_mask.tif', checkIfExists: true),
                    file('$projectDir/assets/NO_REDSEA', checkIfExists: true)
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('quantify.py')) { rendered << f.text }
            }
            assertAll(
                { assert rendered.size() == 1,
                    "expected exactly ONE rendered QUANTIFY command for the patient's three " +
                    "markers, found ${rendered.size()}" },
                { assert rendered[0].contains(
                        '--channel_tiff sample_DAPI.tif sample_PANCK.tif sample_SMA.tif'),
                    "rendered command: " + rendered[0] },
                { assert rendered[0].contains("--channel-name 'DAPI' 'PANCK' 'SMA'"),
                    "rendered command: " + rendered[0] },
                { assert rendered[0].contains(
                        '--output_file P001_sample_DAPI_quant.csv P001_sample_PANCK_quant.csv ' +
                        'P001_sample_SMA_quant.csv'),
                    "rendered command: " + rendered[0] },
                // The mask is staged and read ONCE, not once per marker.
                { assert rendered[0].count('--mask_file') == 1,
                    "rendered command: " + rendered[0] }
            )
        }
    }

    test("Should refuse a short result set and log one size row per staged file - rendered command") {

        // Both halves of the batching's silent-shortfall surface, in the ONE place
        // -stub cannot see. Tagged `stub` for CI's blocking gate, deliberately
        // WITHOUT `options "-stub"`.
        //
        //  - The output declaration had to widen from an exact filename to the glob
        //    `*_quant.csv`, and a glob is satisfied by FEWER files than expected. A
        //    partial write would then be a SUCCEEDING task with a short result set,
        //    which postprocess.nf's keyed join carries into merged_quant.csv without
        //    an error. The count check in `script:` is what turns that into exit 1.
        //  - The size log emits one row per staged file, restoring the per-marker
        //    provenance the fan-out's one-row-per-task format carried. A single
        //    `channels/`-style row would lose which marker cost what.
        tag "stub"

        when {
            process {
                """
                input[0] = [
                    [patient_id: 'P001', channels: ['DAPI', 'PANCK', 'SMA'], id: 'P001', channel_name: 'DAPI'],
                    [[name: 'DAPI',  output: 'P001_sample_DAPI_quant.csv'],
                     [name: 'PANCK', output: 'P001_sample_PANCK_quant.csv'],
                     [name: 'SMA',   output: 'P001_sample_SMA_quant.csv']],
                    [file('$projectDir/tests/testdata/sample_DAPI.tif',  checkIfExists: true),
                     file('$projectDir/tests/testdata/sample_PANCK.tif', checkIfExists: true),
                     file('$projectDir/tests/testdata/sample_SMA.tif',   checkIfExists: true)],
                    file('$projectDir/tests/testdata/P001_cell_mask.npy', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_cell_mask.tif', checkIfExists: true),
                    file('$projectDir/assets/NO_REDSEA', checkIfExists: true)
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('quantify.py')) { rendered << f.text }
            }
            assertAll(
                { assert rendered.size() == 1, "expected ONE rendered QUANTIFY command" },
                // The count is the MARKER COUNT, not a literal that can drift.
                { assert rendered[0].contains('n_expected=3'),
                    "rendered command: " + rendered[0] },
                { assert rendered[0].contains('exit 1'),
                    "a short result set does not fail the task: " + rendered[0] },
                // One size row per staged file, not one per task.
                { assert rendered[0].contains('for staged in sample_DAPI.tif sample_PANCK.tif sample_SMA.tif'),
                    "size log lost its per-marker provenance: " + rendered[0] },
                { assert !rendered[0].contains('channels/+'),
                    "the collapsed single-row size log is still being written: " + rendered[0] }
            )
        }
    }

    test("Should NOT pass --redsea-geometry when handed the NO_REDSEA placeholder - rendered command") {

        // Tagged `stub` so CI's blocking `nf-test test --tag stub` gate runs it, but
        // deliberately WITHOUT `options "-stub"`: `-stub` never evaluates a `script:`
        // block, and the REDSEA gate lives entirely in `script:`. A stub run cannot
        // observe this at all -- it would pass whatever the gate did.
        //
        // This is the assertion with teeth. The gate is `redsea_npz.name == 'NO_REDSEA'`,
        // so a rename of assets/NO_REDSEA, or a change to how the placeholder is staged,
        // silently starts passing a text file to --redsea-geometry and every marker of
        // every REDSEA-disabled run fails inside numpy. That failure is then eligible for
        // conf/modules.config's errorStrategy 'ignore' branch.
        tag "stub"

        when {
            process {
                """
                input[0] = [
                    [patient_id: 'P001', channels: ['DAPI', 'PANCK', 'SMA'], id: 'P001', channel_name: 'DAPI'],
                    [[name: 'DAPI', output: 'P001_sample_DAPI_quant.csv']],
                    [file('$projectDir/tests/testdata/sample_DAPI.tif', checkIfExists: true)],
                    file('$projectDir/tests/testdata/P001_cell_mask.npy', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_cell_mask.tif', checkIfExists: true),
                    file('$projectDir/assets/NO_REDSEA', checkIfExists: true)
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('quantify.py')) {
                    rendered << f.text
                }
            }
            assertAll(
                { assert rendered.size() >= 1,
                    "no rendered QUANTIFY .command.sh found under the task work dir" },
                { assert rendered.every { !it.contains('--redsea-geometry') },
                    "REDSEA disabled, but the placeholder was passed as a geometry: " + rendered.join(' --- ') }
            )
        }
    }

    test("Should pass --redsea-geometry when handed a real geometry file - rendered command") {

        // The other half of the gate. Both halves are needed: an assertion that only
        // checks the disabled case is satisfied by a gate that is hard-wired off.
        tag "stub"

        when {
            process {
                """
                input[0] = [
                    [patient_id: 'P001', channels: ['DAPI', 'PANCK', 'SMA'], id: 'P001', channel_name: 'CD3'],
                    [[name: 'CD3', output: 'P001_sample_DAPI_quant.csv']],
                    [file('$projectDir/tests/testdata/sample_DAPI.tif', checkIfExists: true)],
                    file('$projectDir/tests/testdata/P001_cell_mask.npy', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_cell_mask.tif', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_redsea.npz', checkIfExists: true)
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('quantify.py')) {
                    rendered << f.text
                }
            }
            assertAll(
                { assert rendered.size() >= 1,
                    "no rendered QUANTIFY .command.sh found under the task work dir" },
                { assert rendered.every { it.contains('--redsea-geometry P001_redsea.npz') },
                    "a real geometry was staged but not passed through: " + rendered.join(' --- ') }
            )
        }
    }

    test("Should render the DECLARED marker name, shell-quoted - rendered command") {

        // Tagged `stub` for CI's blocking gate, deliberately WITHOUT `options "-stub"`
        // -- a stub run never evaluates a `script:` block.
        //
        // `--channel-name` fills the <marker> slot of the "<marker>: <Compartment>:
        // <Statistic>" key that qupath-extension-flowpath parses case-sensitively, so
        // what it renders IS the published contract. Two things are pinned:
        //
        //  - the value is the DECLARED name verbatim (`HLA.DR`), not the sanitised
        //    stem the tiff on disk carries (`HLA_DR`);
        //  - it is POSIX-quoted. Until identity started riding in meta, the value had
        //    already been through a filename allowlist, so nothing unquotable could
        //    reach a shell here. Declared samplesheet text has no such guarantee.
        tag "stub"

        when {
            process {
                """
                input[0] = [
                    [patient_id: 'P001', channels: ['DAPI', 'HLA.DR'], id: 'P001', channel_name: 'HLA.DR'],
                    [[name: 'HLA.DR', output: 'P001_HLA_DR_quant.csv']],
                    [file('$projectDir/tests/testdata/HLA_DR.tiff', checkIfExists: true)],
                    file('$projectDir/tests/testdata/P001_cell_mask.npy', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_cell_mask.tif', checkIfExists: true),
                    file('$projectDir/assets/NO_REDSEA', checkIfExists: true)
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('quantify.py')) { rendered << f.text }
            }
            assertAll(
                { assert rendered.size() >= 1, "no rendered QUANTIFY .command.sh found" },
                { assert rendered.every { it.contains("--channel-name 'HLA.DR'") },
                    "rendered command: " + rendered.join(' --- ') },
                { assert rendered.every { !it.contains("--channel-name 'HLA_DR'") },
                    "the sanitised stem is still being published as the marker name: " +
                    rendered.join(' --- ') },
                // ...while the STEM still names the file, so nothing on disk grows a
                // character the filesystem has to think about.
                { assert rendered.every { it.contains('--output_file P001_HLA_DR_quant.csv') },
                    "rendered command: " + rendered.join(' --- ') }
            )
        }
    }

    test("Should shell-quote a marker name that cannot be wrapped in bare quotes - rendered command") {

        // The half the previous case cannot see. `--channel-name '${channel_name}'`
        // -- hand-written quotes around an interpolation -- is correct for every name
        // that does not itself contain a single quote, and a marker's name reaching
        // here had always been through a filename allowlist, so one never could.
        // Identity now rides in meta as arbitrary samplesheet text. An apostrophe
        // closes the hand-written quote and hands bash the remainder as code.
        tag "stub"

        when {
            process {
                """
                input[0] = [
                    [patient_id: 'P001', channels: ["O'Brien"], id: 'P001', channel_name: "O'Brien"],
                    [[name: "O'Brien", output: 'P001_O_Brien_quant.csv']],
                    [file('$projectDir/tests/testdata/sample_DAPI.tif', checkIfExists: true)],
                    file('$projectDir/tests/testdata/P001_cell_mask.npy', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_cell_mask.tif', checkIfExists: true),
                    file('$projectDir/assets/NO_REDSEA', checkIfExists: true)
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('quantify.py')) { rendered << f.text }
            }
            assertAll(
                { assert rendered.size() >= 1, "no rendered QUANTIFY .command.sh found" },
                // close-escape-reopen: 'O'\''Brien' is the only POSIX spelling.
                { assert rendered.every { it.contains("--channel-name 'O'\\''Brien'") },
                    "rendered command: " + rendered.join(' --- ') }
            )
        }
    }

    test("Should render the DEFAULT statistic list and nothing more - rendered command") {

        // Tagged `stub` for CI's blocking gate but WITHOUT `options "-stub"`: the
        // statistic list is built in conf/modules.config's ext.args closure and
        // rendered into `script:`, and `-stub` evaluates neither.
        //
        // The default is now ["Median"], NOT the old expanded_quantification=true
        // (Median+Mean+Sum). That is a deliberate narrowing -- Median is the only
        // statistic emitted out of the box -- and it is exactly the kind of change
        // that would otherwise be discovered by a user finding columns missing.
        tag "stub"

        when {
            process {
                """
                input[0] = [
                    [patient_id: 'P001', channels: ['DAPI', 'PANCK', 'SMA'], id: 'P001', channel_name: 'DAPI'],
                    [[name: 'DAPI', output: 'P001_sample_DAPI_quant.csv']],
                    [file('$projectDir/tests/testdata/sample_DAPI.tif', checkIfExists: true)],
                    file('$projectDir/tests/testdata/P001_cell_mask.npy', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_cell_mask.tif', checkIfExists: true),
                    file('$projectDir/assets/NO_REDSEA', checkIfExists: true)
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('quantify.py')) { rendered << f.text }
            }
            assertAll(
                { assert rendered.size() >= 1, "no rendered QUANTIFY .command.sh found" },
                { assert rendered.every { it.contains("--statistics 'Median'") },
                    "default statistic list is not Median-only: " + rendered.join(' --- ') },
                // The old boolean is gone; a surviving --expanded means a stale ext.args.
                { assert rendered.every { !it.contains('--expanded') },
                    "the removed --expanded flag is still being rendered: " + rendered.join(' --- ') }
            )
        }
    }

    test("Should render every requested statistic, REDSEA included - rendered command") {

        // The other half: a gate that only ever renders the default is
        // indistinguishable from one hard-wired to it.
        tag "stub"

        when {
            params {
                quantify_statistics = ['Sum', 'Median', 'REDSEA']
                redsea_markers      = ['CD3']
            }
            process {
                """
                input[0] = [
                    [patient_id: 'P001', channels: ['DAPI', 'PANCK', 'SMA'], id: 'P001', channel_name: 'CD3'],
                    [[name: 'CD3', output: 'P001_sample_DAPI_quant.csv']],
                    [file('$projectDir/tests/testdata/sample_DAPI.tif', checkIfExists: true)],
                    file('$projectDir/tests/testdata/P001_cell_mask.npy', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_cell_mask.tif', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_redsea.npz', checkIfExists: true)
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('quantify.py')) { rendered << f.text }
            }
            assertAll(
                { assert rendered.size() >= 1, "no rendered QUANTIFY .command.sh found" },
                { assert rendered.every { it.contains('Sum') && it.contains('Median') && it.contains('REDSEA') },
                    "not every requested statistic reached the command: " + rendered.join(' --- ') },
                { assert rendered.every { it.contains("--redsea-markers 'CD3'") },
                    "REDSEA marker list did not reach the command: " + rendered.join(' --- ') }
            )
        }
    }
}
