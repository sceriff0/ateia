nextflow_process {

    name "Test QUANTIFY process"
    script "modules/local/quantify.nf"
    process "QUANTIFY"

    tag "modules"
    tag "modules_local"
    tag "quantify"

    test("Should quantify single channel - stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [patient_id: 'P001', channels: ['DAPI', 'PANCK', 'SMA']],
                    file('$projectDir/tests/testdata/sample_DAPI.tif', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_cell_mask.npy', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_cell_mask.npy', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.individual_csv
            assert process.out.versions

            with(process.out.individual_csv) {
                assert size() == 1
                assert get(0).get(0).patient_id == 'P001'
                assert get(0).get(1).toString().endsWith('_quant.csv')
            }
        }
    }

    test("Should produce CSV with expected columns - real") {

        tag "real"
        tag "slow"

        when {
            process {
                """
                input[0] = [
                    [patient_id: 'P001', channels: ['DAPI', 'PANCK', 'SMA']],
                    file('$projectDir/tests/testdata/sample_DAPI.tif', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_cell_mask.npy', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_cell_mask.npy', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.individual_csv },
                // Validate CSV content - intensity only (label + marker columns)
                {
                    def csvFile = process.out.individual_csv.get(0).get(1)
                    def lines = path(csvFile).readLines()
                    assert lines.size() > 1, "CSV should have header + data rows"
                    def header = lines[0].split(',')
                    assert header.size() == 2, "CSV should have exactly 2 columns (label + marker), got ${header.size()}: ${header}"
                    assert header[0] == 'label', "First column should be 'label'"
                    assert lines.size() - 1 > 0, "CSV should have at least one data row"
                },
                // Metadata preserved
                { assert process.out.individual_csv.get(0).get(0).patient_id == 'P001' }
            )
        }
    }
    test("Should produce non-negative intensity values with correct cell count - regression") {

        tag "real"
        tag "slow"
        tag "regression"

        when {
            process {
                """
                input[0] = [
                    [patient_id: 'P001', channels: ['DAPI', 'PANCK', 'SMA']],
                    file('$projectDir/tests/testdata/sample_DAPI.tif', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_cell_mask.npy', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_cell_mask.npy', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                // Cell count should match mask (20 cells, some may be filtered by min_area)
                {
                    def csvFile = process.out.individual_csv.get(0).get(1)
                    def lines = path(csvFile).readLines()
                    def cellCount = lines.size() - 1
                    assert cellCount > 0, "Must have at least one cell"
                    assert cellCount <= 20, "Should not exceed 20 cells from synthetic mask"
                },
                // All intensity values should be non-negative (DAPI synthetic range: 8000-15000)
                {
                    def csvFile = process.out.individual_csv.get(0).get(1)
                    def lines = path(csvFile).readLines()
                    def header = lines[0].split(',')
                    def valueIdx = 1  // second column is the intensity
                    lines[1..-1].each { line ->
                        def val = line.split(',')[valueIdx] as double
                        assert val >= 0, "Intensity must be >= 0, got ${val}"
                    }
                },
                // Labels should be positive integers matching mask labels
                {
                    def csvFile = process.out.individual_csv.get(0).get(1)
                    def lines = path(csvFile).readLines()
                    lines[1..-1].each { line ->
                        def label = line.split(',')[0] as int
                        assert label > 0, "Label must be > 0 (background excluded)"
                    }
                }
            )
        }
    }
}
