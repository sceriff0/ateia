nextflow_process {

    name "Test ESTIMATE_FEATURE_DISTANCES process"
    script "modules/local/estimate_feature_distances.nf"
    process "ESTIMATE_FEATURE_DISTANCES"

    tag "modules"
    tag "modules_local"
    tag "estimate_feature_distances"

    test("Should estimate feature distances - stub") {

        options "-stub"

        when {
            params {
                container = [registration: 'docker://bolt3x/attend_image_analysis:debug_diffeo']
                feature_detector = 'superpoint'
                feature_max_dim = 2048
                feature_n_features = 5000
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        is_reference: false,
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true)  // Using as registered
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.distance_metrics },
                { assert process.out.distance_plots },
                { assert process.out.versions }
            )
        }
    }

    test("Should output metrics JSON and histogram PNG - stub") {

        options "-stub"

        when {
            params {
                container = [registration: 'docker://bolt3x/attend_image_analysis:debug_diffeo']
                feature_detector = 'superpoint'
                feature_max_dim = 2048
                feature_n_features = 5000
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        is_reference: false,
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { with(process.out.distance_metrics) {
                    assert size() == 1
                    assert get(0).get(1).toString().endsWith('_feature_distances.json')
                }},
                { with(process.out.distance_plots) {
                    assert size() == 1
                    assert get(0).get(1).toString().endsWith('_distance_histogram.png')
                }}
            )
        }
    }

    test("Should preserve metadata - stub") {

        options "-stub"

        when {
            params {
                container = [registration: 'docker://bolt3x/attend_image_analysis:debug_diffeo']
                feature_detector = 'superpoint'
                feature_max_dim = 2048
                feature_n_features = 5000
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P002',
                        is_reference: false,
                        channels: ['DAPI', 'PANCK'],
                        custom_field: 'test'
                    ],
                    file('$projectDir/tests/testdata/P002_ref.ome.tiff', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { with(process.out.distance_metrics) {
                    assert get(0).get(0).patient_id == 'P002'
                    assert get(0).get(0).custom_field == 'test'
                }}
            )
        }
    }

    test("Should emit versions.yml - stub") {

        options "-stub"

        when {
            params {
                container = [registration: 'docker://bolt3x/attend_image_analysis:debug_diffeo']
                feature_detector = 'superpoint'
                feature_max_dim = 2048
                feature_n_features = 5000
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        is_reference: false,
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.versions },
                { assert snapshot(process.out.versions).match() }
            )
        }
    }

    test("Should skip when ext.when is false") {

        options "-stub"

        when {
            params {
                container = [registration: 'docker://bolt3x/attend_image_analysis:debug_diffeo']
                feature_detector = 'superpoint'
                feature_max_dim = 2048
                feature_n_features = 5000
                outdir = "$outputDir"
            }
            process {
                """
                // Set ext.when to false
                task.ext.when = false

                input[0] = [
                    [
                        patient_id: 'P001',
                        is_reference: false,
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            // Process should be skipped but not fail
            assert process.success
        }
    }

    test("Should estimate feature distances on real images") {

        tag "real"
        tag "slow"

        when {
            params {
                container = [registration: 'docker://bolt3x/attend_image_analysis:debug_diffeo']
                feature_detector = 'superpoint'
                feature_max_dim = 2048
                feature_n_features = 5000
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        is_reference: false,
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.distance_metrics },
                { assert process.out.versions },
                { with(process.out.distance_metrics) {
                    assert size() == 1
                    assert get(0).get(1).toString().endsWith('_feature_distances.json')
                    def jsonText = get(0).get(1).toFile().text
                    def json = new groovy.json.JsonSlurper().parseText(jsonText)
                    assert json != null
                }}
            )
        }
    }

    test("Should produce valid distance metrics with non-negative values - regression") {

        tag "real"
        tag "slow"
        tag "regression"

        when {
            params {
                feature_detector = 'superpoint'
                feature_max_dim = 2048
                feature_n_features = 5000
                outdir = "$outputDir"
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        is_reference: false,
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                // Metrics JSON should have expected structure
                {
                    def jsonText = process.out.distance_metrics.get(0).get(1).toFile().text
                    def json = new groovy.json.JsonSlurper().parseText(jsonText)
                    assert json != null
                    // Should contain distance statistics
                    if (json.mean_distance != null) {
                        assert json.mean_distance >= 0, "Mean distance must be >= 0"
                    }
                    if (json.median_distance != null) {
                        assert json.median_distance >= 0, "Median distance must be >= 0"
                    }
                    if (json.n_matches != null) {
                        assert json.n_matches >= 0, "Match count must be >= 0"
                    }
                },
                // Histogram PNG should be non-trivial
                {
                    def plotFile = process.out.distance_plots.get(0).get(1)
                    assert plotFile.toFile().size() > 500, "Distance histogram should be > 500 bytes"
                }
            )
        }
    }
}
