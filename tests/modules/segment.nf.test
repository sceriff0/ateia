nextflow_process {

    name "Test SEGMENT process"
    script "modules/local/segment.nf"
    process "SEGMENT"

    tag "modules"
    tag "modules_local"
    tag "segment"

    // The three backend tests below assert the SAME four-channel output contract
    // (nuclei_mask / cell_mask / versions / size_log). That identity is what lets
    // postprocess.nf consume SEGMENT without knowing which segmenter ran, and it is the
    // property the shared backend table (lib/SegBackends.groovy) has to preserve --
    // everything the backends do differently happens behind it.
    test("Should segment cells from merged image - stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    SegBackends.ctxParams(params)
                ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.nuclei_mask
            assert process.out.cell_mask
            assert process.out.versions
            assert process.out.size_log

            with(process.out.nuclei_mask) {
                assert size() == 1
                assert get(0).get(0).patient_id == 'P001'
                assert get(0).get(1).toString().endsWith('_nuclei_mask.tif')
            }

            with(process.out.cell_mask) {
                assert size() == 1
                assert get(0).get(0).patient_id == 'P001'
                assert get(0).get(1).toString().endsWith('_cell_mask.tif')
            }

            // The `test` profile pins seg_method='stardist' (conf/test.config), so this
            // case covers the StarDist branch of the dispatch without saying so in its
            // own params block. Named explicitly so a profile change is a test diff.
            assert process.out.versions.get(0).toString().endsWith('versions.yml')
            // THE STUB versions.yml NOW NAMES THE BACKEND'S REAL TOOLS. It used to say
            // `seg_method: stardist` -- a key no real run ever emits -- because the two
            // heredocs were hand-written independently and `-stub` never evaluates the
            // script: block that would have contradicted it. Both blocks now render
            // through ProcessEnvelope from SegBackends' one `versionTools` list, so this
            // stub run is direct evidence about what a REAL run reports.
            with(path(process.out.versions.get(0)).text) {
                assert contains('deepcell: stub')
                assert contains('tensorflow: stub')
                assert contains('python: stub')
                // The old hand-written key, and the OTHER backends' tools: a stub that
                // names either is reporting a stack this task never loaded.
                assert !contains('seg_method')
                assert !contains('torch')
                assert !contains('instanseg')
                assert !contains('cellSAM')
            }
            assert process.out.size_log.get(0).toString().endsWith('.SEGMENT.size.csv')
        }
    }

    test("Should fail if DAPI not in channel 0 - real") {

        // Real (not stub): the stardist channel-0 hard-check runs in the
        // process script, which a stub block does not execute.
        tag "real"
        tag "slow"

        when {
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        channels: ['PANCK', 'DAPI', 'SMA']  // DAPI NOT FIRST
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    SegBackends.ctxParams(params)
                ]
                """
            }
        }

        then {
            // Validation runs in script block and should fail
            assert process.failed
            assert process.exitStatus == 1
        }
    }

    test("Should produce valid cell masks with cells - real") {

        tag "real"
        tag "slow"

        when {
            params {
                segmentation_model     = "2D_versatile_fluo"
                segmentation_model_dir = null
                seg_gpu                = false
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    SegBackends.ctxParams(params)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.nuclei_mask },
                { assert process.out.cell_mask },
                // Validate files are not empty (have actual size > 100 bytes)
                { assert process.out.nuclei_mask.get(0).get(1).size() > 100 },
                { assert process.out.cell_mask.get(0).get(1).size() > 100 },
                // Metadata preserved
                { assert process.out.nuclei_mask.get(0).get(0).patient_id == 'P001' },
                { assert process.out.cell_mask.get(0).get(0).patient_id == 'P001' },
                // Correct file naming
                { assert process.out.nuclei_mask.get(0).get(1).toString().endsWith('_nuclei_mask.tif') },
                { assert process.out.cell_mask.get(0).get(1).toString().endsWith('_cell_mask.tif') }
            )
        }
    }

    test("Should segment cells with InstanSeg backend - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                seg_method = 'instantseg'
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    SegBackends.ctxParams(params)
                ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.nuclei_mask
            assert process.out.cell_mask
            assert process.out.versions
            assert process.out.size_log

            with(process.out.nuclei_mask) {
                assert size() == 1
                assert get(0).get(0).patient_id == 'P001'
                assert get(0).get(1).toString().endsWith('_nuclei_mask.tif')
            }

            with(process.out.cell_mask) {
                assert size() == 1
                assert get(0).get(0).patient_id == 'P001'
                assert get(0).get(1).toString().endsWith('_cell_mask.tif')
            }

            // Same four outputs, same names, different backend -- and the stub's
            // versions.yml follows the backend, which is exactly what the single
            // `versionTools` list buys. Under the old hand-written stub heredoc every
            // backend reported the same two keys (`python` + `seg_method`).
            with(path(process.out.versions.get(0)).text) {
                assert contains('instanseg: stub')
                assert contains('torch: stub')
                assert !contains('seg_method')
                assert !contains('deepcell')
                assert !contains('cellSAM')
            }
            assert process.out.size_log.get(0).toString().endsWith('.SEGMENT.size.csv')
        }
    }

    test("Should NOT enforce DAPI-channel-0 check when seg_method='instantseg' - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                seg_method = 'instantseg'
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        channels: ['PANCK', 'DAPI', 'SMA']  // DAPI NOT FIRST - InstanSeg is channel-invariant
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    SegBackends.ctxParams(params)
                ]
                """
            }
        }

        then {
            // InstanSeg path does not enforce DAPI-channel-0; should succeed.
            assert process.success
        }
    }

    test("Should segment cells with CellSAM backend - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                seg_method = 'cellsam'
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    SegBackends.ctxParams(params)
                ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.nuclei_mask
            assert process.out.cell_mask
            assert process.out.versions
            assert process.out.size_log

            with(process.out.nuclei_mask) {
                assert size() == 1
                assert get(0).get(0).patient_id == 'P001'
                assert get(0).get(1).toString().endsWith('_nuclei_mask.tif')
            }

            with(process.out.cell_mask) {
                assert size() == 1
                assert get(0).get(0).patient_id == 'P001'
                assert get(0).get(1).toString().endsWith('_cell_mask.tif')
            }

            // Same four outputs, same names, third backend.
            with(path(process.out.versions.get(0)).text) {
                assert contains('cellSAM: stub')
                assert contains('torch: stub')
                assert !contains('seg_method')
                assert !contains('deepcell')
                assert !contains('instanseg: stub')
            }
            assert process.out.size_log.get(0).toString().endsWith('.SEGMENT.size.csv')
        }
    }

    test("Should NOT enforce DAPI-channel-0 check when seg_method='cellsam' - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                seg_method = 'cellsam'
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        channels: ['PANCK', 'DAPI', 'SMA']  // DAPI NOT FIRST - CellSAM path skips the channel-0 check
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    SegBackends.ctxParams(params)
                ]
                """
            }
        }

        then {
            // CellSAM path does not enforce DAPI-channel-0; should succeed.
            assert process.success
        }
    }

    test("Should reject an unknown seg_method rather than silently run StarDist - stub") {

        // Stub is sufficient here, unusually: the throw comes from SegBackends.of() in
        // the `container` DIRECTIVE, which Nextflow evaluates for every task whichever
        // block runs. The stub block itself never touches SegBackends, so what this case
        // pins is the directive, not the script.
        tag "stub"
        options "-stub"

        when {
            params {
                // A plausible typo. The old nested `container` ternary treated anything
                // that was not 'cellsam' or 'instantseg' as StarDist, so this ran a
                // different segmenter than asked for -- either dying later on StarDist's
                // channel-0 check with an error naming the wrong problem, or succeeding
                // with the wrong algorithm. seg_method has no schema enum, so
                // SegBackends.of() is the only place the typo can be caught.
                seg_method = 'instaseg'
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    SegBackends.ctxParams(params)
                ]
                """
            }
        }

        then {
            assert process.failed
        }
    }

    test("Should enforce the CONFIGURED nuclear marker, not the literal DAPI - real") {

        // Real (not stub): like its sibling above, the channel-0 hard check lives in the
        // script block, which a stub does not execute. It exits before Python runs, so
        // this costs a container start and nothing else.
        tag "real"
        tag "slow"

        when {
            params {
                // The inversion that proves the literal 'DAPI' is gone. Channel 0 IS
                // DAPI, which the old hardcoded check accepted unconditionally -- but
                // DAPI is not one of the CONFIGURED markers here, so StarDist would be
                // pointed at the wrong channel and must refuse.
                //
                // This is the site that turned Task 3's relaxed launch validation into a
                // later, less legible failure in the other direction too: a
                // CELLTOX-configured sheet passed validation, CONVERT_IMAGE correctly
                // moved CELLTOX to channel 0, and then SEGMENT rejected it for not
                // being DAPI.
                nuclear_markers = ['CELLTOX']
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    SegBackends.ctxParams(params)
                ]
                """
            }
        }

        then {
            assert process.failed
            assert process.exitStatus == 1
        }
    }

    test("Should detect cells in synthetic image with DAPI signal - regression") {

        tag "real"
        tag "slow"
        tag "regression"

        when {
            params {
                seg_model = "2D_versatile_fluo"
                seg_gpu = false
                seg_n_tiles_y = 1
                seg_n_tiles_x = 1
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    SegBackends.ctxParams(params)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                // Cell mask should have non-trivial size (actual segmentation, not empty)
                {
                    def maskSize = process.out.cell_mask.get(0).get(1).size()
                    assert maskSize > 1000, "Cell mask should be > 1KB (got ${maskSize} bytes), indicating actual segmentation"
                },
                // Nuclei mask should also be non-trivial
                {
                    def maskSize = process.out.nuclei_mask.get(0).get(1).size()
                    assert maskSize > 1000, "Nuclei mask should be > 1KB (got ${maskSize} bytes)"
                },
                // Size log should have been generated
                { assert process.out.size_log }
            )
        }
    }

    test("Should render the backend's versions.yml probes, not a seg_method row - rendered command") {

        // Tagged `stub` so CI's blocking `nf-test test --tag stub` gate runs it, but
        // deliberately WITHOUT `options "-stub"`. That is the entire point of this case:
        // `-stub` never evaluates a `script:` block, so the stub cases above -- however
        // thorough -- say nothing about the versions.yml a REAL run writes. The heredoc
        // this task replaced lived only in `script:`, which means every assertion that
        // could see it had to be a rendered-command assertion. Same shape and same reason
        // as tests/modules/generate_qc_report.nf.test's `-rendered command` case.
        //
        // SEGMENT is not runnable without its container, and that is fine: the assertions
        // read the rendered .command.sh, which Nextflow writes before it executes
        // anything, so this case holds whether the task succeeds or dies importing
        // deepcell. It asserts nothing about process outcome for exactly that reason.
        tag "stub"

        when {
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    SegBackends.ctxParams(params)
                ]
                """
            }
        }

        then {
            // Nextflow lays tasks out as <workDir>/<2 hex>/<30 hex>/.command.sh.
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('.SEGMENT.size.csv')) {
                    rendered << f.text
                }
            }

            assertAll(
                { assert rendered.size() >= 1,
                    "no rendered SEGMENT .command.sh found under the task work dir" },

                // The `test` profile pins seg_method='stardist', so the rendered command
                // must carry StarDist's two probes -- the rows ProcessEnvelope built from
                // SegBackends' versionTools list, byte-for-byte what the hand-written
                // heredoc used to contain.
                { assert rendered.every {
                    it.contains('deepcell: $(python -c "import deepcell; print(deepcell.__version__)" 2>/dev/null || echo "unknown")') },
                    "rendered command: " + rendered.join(' --- ') },
                { assert rendered.every {
                    it.contains('tensorflow: $(python -c "import tensorflow; print(tensorflow.__version__)" 2>/dev/null || echo "unknown")') },
                    "rendered command: " + rendered.join(' --- ') },

                // The shared `python:` row ProcessEnvelope prepends, with a BARE `$(`.
                // `<<-END_VERSIONS` is an unquoted heredoc, so bash command-substitutes a
                // bare `$(...)` and prints an escaped `\$(...)` as literal text -- the
                // over-escaping bug that once wrote shell commands into every published
                // versions.yml, invisibly, because -stub never runs script:.
                { assert rendered.every { it.contains('python: $(python --version 2>&1 | sed \'s/Python //\')') },
                    "rendered command: " + rendered.join(' --- ') },
                { assert rendered.every { !it.contains('\\$(python') },
                    "versions probe is escaped, so bash prints it instead of running it: " + rendered.join(' --- ') },

                // And the heredoc is still a heredoc: one open, one terminator.
                { assert rendered.every { it.contains('cat <<-END_VERSIONS > versions.yml') },
                    "rendered command: " + rendered.join(' --- ') },

                // The negative with teeth. `seg_method` is not a tool and no real run ever
                // reported it -- it existed ONLY in the stub heredoc. Its appearance in a
                // rendered command means the two blocks are being maintained separately
                // again. Likewise the other backends' tools: exactly one backend runs.
                { assert rendered.every { !it.contains('seg_method:') },
                    "rendered command carries the stub-only seg_method row: " + rendered.join(' --- ') },
                { assert rendered.every { !it.contains('import torch') },
                    "StarDist run reports a torch version it never loaded: " + rendered.join(' --- ') }
            )
        }
    }
}
