nextflow_process {
    name "Test REG_WARP_TILE process"
    script "modules/local/reg_warp_tile.nf"
    process "REG_WARP_TILE"
    tag "modules"; tag "modules_local"; tag "reg_warp_tile"

    test("REG_WARP_TILE - stub, moving slide (with field)") {
        options "-stub"
        when { process { """
            input[0] = [ 'P001', 'P001_mov1',
                file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true),
                file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true),
                file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                0 ]
        """ } }
        then { assertAll(
            { assert process.success },
            { assert process.out.tile },
            { assert process.out.versions } ) }
    }

    test("REG_WARP_TILE - stub, reference slide (empty field => --rigid-only)") {
        // The reference passes field == [], which `path(field)` with no arity renders as an empty
        // string -- that is how --rigid-only is selected now that REG_WARP_REF is gone. If this
        // ever regresses, the reference would be warped WITH a non-rigid field it must not have.
        options "-stub"
        when { process { """
            input[0] = [ 'P001', 'P001_ref',
                file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                [],
                file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                0 ]
        """ } }
        then { assertAll(
            { assert process.success },
            { assert process.out.tile },
            { assert process.out.versions } ) }
    }
}
