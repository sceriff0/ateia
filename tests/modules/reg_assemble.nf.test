nextflow_process {
    name "Test REG_ASSEMBLE process"
    script "modules/local/reg_assemble.nf"
    process "REG_ASSEMBLE"
    tag "modules"; tag "modules_local"; tag "reg_assemble"

    test("REG_ASSEMBLE - stub") {
        tag "stub"
        options "-stub"
        when { process { """
            input[0] = [ 'P001', 'P001_mov1',
                file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true),
                file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true),
                file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                [ file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true) ] ]
        """ } }
        then { assertAll(
            { assert process.success },
            { assert process.out.registered },
            { assert process.out.versions },
            { assert process.out.size_log } ) }
    }
}
