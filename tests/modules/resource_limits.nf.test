nextflow_process {

    name "Test process.resourceLimits clamps requests under -profile test"
    script "modules/local/convert_image.nf"
    process "CONVERT_IMAGE"

    tag "modules"
    tag "modules_local"
    tag "resource_limits"

    // Characterisation test: CONVERT_IMAGE requests a hard 24.GB floor (see
    // conf/modules.config withName:'CONVERT_IMAGE' -- (file_gb < 4 ? 0.GB :
    // ...) + 24.GB * task.attempt). Under -profile test, params.max_memory is
    // '6.GB' (conf/test.config), so the effective submitted memory must be
    // clamped down to 6.GB by process.resourceLimits -- proving max_memory
    // (and max_cpus/max_time) are still enforced under the test ceiling. This
    // must pass both before and after the nextflow.config resourceLimits
    // hoist (Task 9a) -- it guards against silently loosening CI's resource
    // ceiling.
    test("Should clamp CONVERT_IMAGE's memory request to the test ceiling (6.GB) - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                pixel_size = 0.325
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        is_reference: true,
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            // nf-test's process.trace wrapper (WorkflowTask) only exposes
            // success/name, not the resolved resource columns, so read the
            // CSV trace nf-test itself records for this test alongside its
            // other meta/ artifacts.
            def traceFile = new File(new File(outputDir).parentFile, 'meta/trace.csv')
            def lines = traceFile.readLines()
            def header = lines[0].split('\t')
            def memoryCol = header.findIndexOf { it == 'memory' }
            def row = lines.find { it.startsWith('1\tCONVERT_IMAGE') }.split('\t')

            assertAll(
                { assert process.success },
                { assert traceFile.exists() },
                { assert memoryCol >= 0 },
                { assert row[memoryCol] == '6 GB' }
            )
        }
    }
}
