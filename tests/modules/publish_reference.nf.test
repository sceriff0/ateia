nextflow_process {

    name "Test PUBLISH_REFERENCE process"
    script "modules/local/publish_reference.nf"
    process "PUBLISH_REFERENCE"

    tag "modules"
    tag "modules_local"
    tag "publish_reference"

    test("Should publish reference image unchanged - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        is_reference: true
                    ],
                    file('${projectDir}/tests/testdata/P001_ref.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.published },
                { assert process.out.versions }
            )
        }
    }

    test("Should preserve metadata - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        is_reference: true,
                        custom_field: 'preserved'
                    ],
                    file('${projectDir}/tests/testdata/P001_ref.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { with(process.out.published) {
                    assert get(0).get(0).patient_id == 'P001'
                    assert get(0).get(0).is_reference == true
                    assert get(0).get(0).custom_field == 'preserved'
                }}
            )
        }
    }

    test("Should emit versions.yml - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        is_reference: true
                    ],
                    file('${projectDir}/tests/testdata/P001_ref.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.versions },
                { assert snapshot(process.out.versions).match() }
            )
        }
    }

    test("Should skip when ext.when is false") {

        options "-stub"

        when {
            process {
                """
                task.ext.when = false

                input[0] = [
                    [
                        patient_id: 'P001',
                        is_reference: true
                    ],
                    file('${projectDir}/tests/testdata/P001_ref.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            // Process should be skipped but not fail
            assert process.success
        }
    }
}
