// Test-only fixture config for tests/modules/segment_deepcell_token.nf.test.
//
// Points SEGMENT's container at a local placeholder file instead of the real
// CellSAM image on Docker Hub. Without this, Nextflow's Singularity engine
// tries to `singularity pull docker://...` before it ever writes
// `.command.run` -- and that pull needs the `singularity`/`apptainer` binary,
// which is not available in this dev environment or in CI (neither installs
// it; see .github/workflows/ci.yml). Pointing at an already-"local" file
// skips the pull, so Nextflow proceeds far enough to render `.command.run`,
// which is all this regression test needs to inspect.
process {
    withName: 'SEGMENT' {
        container = "${projectDir}/tests/testdata/dummy_singularity.sif"
    }
}
