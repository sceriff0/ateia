nextflow_process {

    name "Test TILED_COARSE frontend selection"
    script "modules/local/tiled_coarse.nf"
    process "TILED_COARSE"

    tag "modules"
    tag "modules_local"
    tag "tiled_coarse"

    test("Should render --frontend from params.reg_tiled_frontend - rendered command") {

        // Tagged `stub` so CI's blocking `nf-test test --tag stub` gate collects it, but
        // deliberately WITHOUT `options "-stub"` -- `-stub` never evaluates a `script:`
        // block, so no stub run can observe a rendered command at all, and this flag is
        // carried entirely through conf/modules.config's TILED_COARSE `ext.args` closure
        // (never a bare `params` reference inside script:, per CLAUDE.md). Same shape as
        // tests/modules/generate_qc_report.nf.test's "rendered command" case.
        tag "stub"

        when {
            params {
                reg_tiled_frontend = 'sift'
            }
            process {
                """
                input[0] = [
                    [ patient_id: 'P001', channels: ['DAPI', 'CD3'], is_reference: false ],
                    file('${projectDir}/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    file('${projectDir}/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('tiled_coarse.py')) {
                    rendered << f.text
                }
            }

            assertAll(
                { assert rendered.size() >= 1,
                    "no rendered TILED_COARSE .command.sh found under the task work dir" },
                { assert rendered.every { it.contains('--frontend sift') },
                    "rendered command missing --frontend sift: " + rendered.join(' --- ') }
            )
        }
    }

    test("Should default --frontend to orb - rendered command") {

        tag "stub"

        when {
            process {
                """
                input[0] = [
                    [ patient_id: 'P001', channels: ['DAPI', 'CD3'], is_reference: false ],
                    file('${projectDir}/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    file('${projectDir}/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('tiled_coarse.py')) {
                    rendered << f.text
                }
            }

            assertAll(
                { assert rendered.size() >= 1,
                    "no rendered TILED_COARSE .command.sh found under the task work dir" },
                { assert rendered.every { it.contains('--frontend orb') },
                    "rendered command missing the default --frontend orb: " + rendered.join(' --- ') }
            )
        }
    }
}
