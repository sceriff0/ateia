nextflow_process {

    name "Test GENERATE_PREPROCESS_QC process"
    script "modules/local/generate_preprocess_qc.nf"
    process "GENERATE_PREPROCESS_QC"

    tag "modules"
    tag "modules_local"
    tag "generate_preprocess_qc"

    test("Should generate preprocessing QC images - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                preprocess_qc_scale_factor = 0.25
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        is_reference: true,
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.qc },
                { assert process.out.versions }
            )
        }
    }

    test("Should create PNG for each channel - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                preprocess_qc_scale_factor = 0.25
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        is_reference: true,
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { with(process.out.qc) {
                    assert size() == 1
                    // Should create PNGs
                    assert get(0).get(1).any { it.toString().endsWith('.png') }
                }}
            )
        }
    }

    test("Should preserve metadata - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                preprocess_qc_scale_factor = 0.25
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P002',
                        is_reference: false,
                        channels: ['DAPI', 'PANCK'],
                        custom_field: 'preserved'
                    ],
                    file('$projectDir/tests/testdata/P002_ref.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { with(process.out.qc) {
                    assert get(0).get(0).patient_id == 'P002'
                    assert get(0).get(0).channels == ['DAPI', 'PANCK']
                    assert get(0).get(0).custom_field == 'preserved'
                }}
            )
        }
    }

    test("Should emit versions.yml - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                preprocess_qc_scale_factor = 0.25
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        is_reference: true,
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.versions },
                { assert snapshot(process.out.versions).match() }
            )
        }
    }

    test("Should render every tool in the versions heredoc - rendered command") {

        // Tagged `stub` so CI's blocking `nf-test test --tag stub` gate runs it, but
        // deliberately WITHOUT `options "-stub"`. `-stub` never evaluates a `script:`
        // block, so no stub run can see whether lib/ProcessEnvelope.groovy's
        // `versions()` call actually renders the tool probes into the heredoc — a stub
        // diff would report "identical" even if the escaping were wrong and the
        // heredoc empty. Same shape as
        // tests/modules/generate_qc_report.nf.test's rendered-command case.
        tag "stub"

        when {
            params {
                preprocess_qc_scale_factor = 0.25
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        is_reference: true,
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            // Nextflow lays tasks out as <workDir>/<2 hex>/<30 hex>/.command.sh.
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('generate_preprocess_qc.py')) {
                    rendered << f.text
                }
            }

            assertAll(
                { assert rendered.size() >= 1,
                    "no rendered GENERATE_PREPROCESS_QC .command.sh found under the task work dir" },
                { assert rendered.every { it.contains('python: $(python --version') },
                    "rendered command: " + rendered.join(' --- ') },
                { assert rendered.every { it.contains('numpy: $(python -c "import numpy; print(numpy.__version__)"') },
                    "rendered command: " + rendered.join(' --- ') },
                { assert rendered.every { it.contains('tifffile: $(python -c "import tifffile; print(tifffile.__version__)"') },
                    "rendered command: " + rendered.join(' --- ') },
                { assert rendered.every { it.contains('scikit-image: $(python -c "import skimage; print(skimage.__version__)"') },
                    "rendered command: " + rendered.join(' --- ') }
            )
        }
    }

    test("Should generate preprocessing QC images - real") {

        tag "real"
        tag "slow"

        when {
            params {
                preprocess_qc_scale_factor = 0.25
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        is_reference: true,
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.qc },
                { with(process.out.qc) {
                    assert size() == 1
                    assert get(0).get(0).patient_id == 'P001'
                    assert get(0).get(1).every { it.toString().endsWith('.png') }
                    assert get(0).get(1).every { it.toFile().size() > 100 }
                }}
            )
        }
    }
}
