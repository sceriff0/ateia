nextflow_process {

    name "Test GENERATE_QC_REPORT process"
    script "modules/local/generate_qc_report.nf"
    process "GENERATE_QC_REPORT"

    tag "modules"
    tag "modules_local"
    tag "generate_qc_report"

    test("Should generate HTML report - stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    file('${projectDir}/tests/testdata/P001_ref.ome.tiff', checkIfExists: true)
                ]
                input[1] = [
                    file('${projectDir}/tests/testdata/P001_ref.ome.tiff', checkIfExists: true)
                ]
                input[2] = [
                    file('${projectDir}/tests/testdata/sample_valis_summary.csv', checkIfExists: true)
                ]
                input[3] = [
                    file('${projectDir}/tests/testdata/P001_ref.ome.tiff', checkIfExists: true)
                ]
                input[4] = [
                    file('${projectDir}/tests/testdata/sample_morphology.csv', checkIfExists: true)
                ]
                input[5] = file('${projectDir}/tests/testdata/sample_versions.yml', checkIfExists: true)
                // Stub run: only file staging is exercised, so any tracked JSON serves
                // as the run-summary / seg-QC placeholder.
                input[6] = file('${projectDir}/tests/testdata/seg_eval_P001.json', checkIfExists: true)
                input[7] = [
                    file('${projectDir}/tests/testdata/seg_eval_P002.json', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.report },
                { with(process.out.report) {
                    assert size() == 1
                    assert get(0).toString() ==~ /.*mirage_qc_report_\d{8}_\d{6}\.html/
                }},
                { assert process.out.versions }
            )
        }
    }

}
