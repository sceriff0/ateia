nextflow_process {

    name "Test BASICPY process (vendored nf-core module)"
    script "modules/nf-core/basicpy/main.nf"
    process "BASICPY"

    tag "modules"
    tag "modules_nfcore"
    tag "basicpy"

    test("Should emit a darkfield and a flatfield profile named from meta.id - stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ patient_id: 'P001', id: 'P001_ref_tiles' ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.profiles },
                // The naming is load-bearing, not cosmetic. subworkflows/local/preprocess.nf
                // joins the profiles back to the tile stack's sidecar on
                // "<patient_id>/<meta.id>", and meta.id is set to the tile stack's
                // simpleName precisely so the two sides agree. The module derives its
                // output names from `ext.prefix ?: "${meta.id}"`, so if that stops holding
                // the join silently produces nothing and APPLY_PROFILES never runs.
                { assert process.out.profiles.get(0).get(1).endsWith('P001_ref_tiles-dfp.ome.tif') },
                { assert process.out.profiles.get(0).get(2).endsWith('P001_ref_tiles-ffp.ome.tif') },
                // Darkfield first, flatfield second -- upstream's tuple order, which
                // APPLY_PROFILES' input tuple has to match. Getting these the wrong way
                // round would divide by the darkfield and subtract the flatfield.
                { assert process.out.profiles.get(0).get(1).contains('-dfp.') },
                { assert process.out.profiles.get(0).get(2).contains('-ffp.') }
            )
        }
    }

    test("Should invoke /opt/main.py with no arguments at all - rendered command") {

        // Tagged `stub` for CI's gate but deliberately NOT run with `options "-stub"`:
        // `-stub` never evaluates a `script:` block, and the whole point here is the
        // rendered invocation.
        //
        // WHAT IS UNDER ASSERTION: that nothing is appended after the four flags the
        // module itself renders. Running at nf-core's upstream defaults is a decision --
        // mirage's previous in-process call was
        // `BaSiC(get_darkfield=True, smoothness_flatfield=1)` and is deliberately NOT
        // reproduced -- and an empty `ext.args` looks exactly like an oversight to the
        // next reader. `--no_autotune` is the flag to watch: its name is INVERTED
        // (`action="store_false"`, `default=True`, gated by `if not args.no_autotune`),
        // so adding it to "turn autotune off" turns it ON.
        //
        // tests/test_basicpy_defaults_are_deliberate.py checks the same decision
        // statically, in conf/modules.config. This checks it in the string the container
        // is actually handed, which is the only place an `ext.args` from a site profile
        // or a `-c` override would show up.
        //
        // No container engine is active under `-profile test`, so /opt/main.py does not
        // exist and the task fails; the assertions read the rendered .command.sh rather
        // than the process outcome.
        tag "stub"

        when {
            process {
                """
                input[0] = [
                    [ patient_id: 'P001', id: 'P001_ref_tiles' ],
                    file('${projectDir}/tests/testdata/P001_ref.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('/opt/main.py')) {
                    rendered << f.text
                }
            }

            assertAll(
                { assert rendered.size() >= 1,
                    "no rendered BASICPY .command.sh found under the task work dir" },
                // NB: the `+` continuations below stay at END of line. Leading `+` is
                // parsed by Groovy as a unary plus on a String and fails at assertion
                // time with `No signature of method: java.lang.String.positive()`.
                { assert rendered.every { !it.contains('--darkfield') },
                    "BASICPY was handed --darkfield; the shipped configuration estimates " +
                    "no darkfield on purpose: " + rendered.join(' --- ') },
                { assert rendered.every { !it.contains('--no_autotune') },
                    "BASICPY was handed --no_autotune, which ENABLES autotune (the flag's " +
                    "name is inverted): " + rendered.join(' --- ') },
                { assert rendered.every { !it.contains('--smoothness_flatfield') },
                    "BASICPY was handed --smoothness_flatfield; upstream defaults are " +
                    "deliberate: " + rendered.join(' --- ') },
                { assert rendered.every { it.contains('--output-flatfield P001_ref_tiles') },
                    "rendered command does not name its outputs from meta.id: " + rendered.join(' --- ') }
            )
        }
    }
}
