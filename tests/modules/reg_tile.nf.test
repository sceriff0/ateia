nextflow_process {

    name "Test REG_TILE process"
    script "modules/local/reg_tile.nf"
    process "REG_TILE"

    tag "modules"
    tag "modules_local"
    tag "reg_tile"

    test("REG_TILE - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    'P001',
                    'P001_mov1',
                    file('$projectDir/tests/testdata', checkIfExists: true),
                    0
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.tiles },
                { assert process.out.versions }
            )
        }
    }
}
