nextflow_process {

    name "Test SEG_QUALITY_EVAL process"
    script "modules/local/seg_quality_eval.nf"
    process "SEG_QUALITY_EVAL"

    tag "modules"
    tag "modules_local"
    tag "seg_quality_eval"

    test("Should emit metrics json - stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [patient_id: 'P001', channels: ['DAPI', 'PANCK', 'SMA'], is_reference: true],
                    file('$projectDir/tests/testdata/P001_cell_mask.npy', checkIfExists: true),
                    file('$projectDir/tests/testdata/P002_cell_mask.npy', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.metrics
            assert process.out.versions

            with(process.out.metrics) {
                assert size() == 1
                assert get(0).get(0).patient_id == 'P001'
                assert get(0).get(1).toString().endsWith('_seg_eval.json')
            }

            assert snapshot(process.out.versions).match()
        }
    }

}
