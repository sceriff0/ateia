nextflow_process {

    name "Test SPLIT_CHANNELS process"
    script "modules/local/split_channels.nf"
    process "SPLIT_CHANNELS"

    tag "modules"
    tag "modules_local"
    tag "split_channels"

    test("Should split multichannel image - stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        channels: ['DAPI', 'PANCK', 'SMA'],
                        is_reference: true
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    true  // is_reference flag
                ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.channels
            assert process.out.versions

            with(process.out.channels) {
                assert size() == 1
                def meta = get(0).get(0)
                def files = get(0).get(1)

                assert meta.patient_id == 'P001'
                assert meta.channels == ['DAPI', 'PANCK', 'SMA']

                // In stub mode, should create 3 files (one per channel)
                def fileList = (files instanceof List) ? files : [files]
                assert fileList.size() == 3

                // Verify channel names in output files (paths come back as strings)
                def fileNames = fileList.collect { file(it).name }.sort()
                assert fileNames == ['DAPI.tiff', 'PANCK.tiff', 'SMA.tiff']
            }
        }
    }

    test("Should handle single-channel image - stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P002',
                        channels: ['DAPI'],
                        is_reference: true
                    ],
                    file('$projectDir/tests/testdata/sample_DAPI.tif', checkIfExists: true),
                    true  // is_reference flag
                ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.channels

            with(process.out.channels) {
                assert size() == 1
                def meta = get(0).get(0)
                def files = get(0).get(1)

                assert meta.patient_id == 'P002'
                assert meta.channels == ['DAPI']

                // Single channel produces one file (path may be a bare string)
                def fileList = (files instanceof List) ? files : [files]
                assert fileList.size() == 1
                assert file(fileList[0]).name == 'DAPI.tiff'
            }
        }
    }

    test("Should emit placeholder tiff when meta.channels is empty - stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P003',
                        channels: [],
                        is_reference: false
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    false  // is_reference flag
                ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.channels
            assert process.out.versions

            with(process.out.channels) {
                assert size() == 1
                def files = get(0).get(1)
                def fileList = (files instanceof List) ? files : [files]

                // At least one placeholder .tiff must be emitted so the
                // mandatory `*.tiff` output binds even with no channels.
                assert fileList.size() >= 1
                assert fileList.every { file(it).name.endsWith('.tiff') }
            }
        }
    }

    test("Should split 3-channel image into DAPI, PANCK, SMA - real") {

        tag "real"
        tag "slow"

        when {
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        channels: ['DAPI', 'PANCK', 'SMA'],
                        is_reference: true
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    true  // is_reference flag
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.channels },
                { assert process.out.versions },
                // Meta preservation
                { assert process.out.channels.get(0).get(0).patient_id == 'P001' },
                { assert process.out.channels.get(0).get(0).channels == ['DAPI', 'PANCK', 'SMA'] },
                // Should produce 3 output files
                {
                    def files = process.out.channels.get(0).get(1)
                    assert files instanceof List
                    assert files.size() == 3
                },
                // Each file should be non-trivial (> 100 bytes)
                {
                    def files = process.out.channels.get(0).get(1)
                    files.each { f -> assert f.size() > 100 }
                },
                // File names should include channel names
                {
                    def fileNames = process.out.channels.get(0).get(1)*.name.sort()
                    assert fileNames.any { it.contains('DAPI') }
                    assert fileNames.any { it.contains('PANCK') }
                    assert fileNames.any { it.contains('SMA') }
                }
            )
        }
    }

    test("Should skip DAPI for non-reference images - real") {

        tag "real"
        tag "slow"
        tag "regression"

        when {
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        channels: ['DAPI', 'PANCK', 'SMA'],
                        is_reference: false
                    ],
                    file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true),
                    false  // NOT reference
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.channels },
                // Non-reference should produce 2 files (PANCK + SMA), NOT DAPI
                {
                    def files = process.out.channels.get(0).get(1)
                    assert files instanceof List
                    assert files.size() == 2, "Non-reference should have 2 channels (no DAPI), got ${files.size()}"
                },
                // Verify DAPI is NOT in output
                {
                    def fileNames = process.out.channels.get(0).get(1)*.name
                    assert !fileNames.any { it.toUpperCase().contains('DAPI') },
                        "DAPI should NOT be in non-reference output, got: ${fileNames}"
                },
                // Each channel file should have non-trivial content
                {
                    def files = process.out.channels.get(0).get(1)
                    files.each { f ->
                        assert f.size() > 100, "Channel file ${f.name} should be > 100 bytes"
                    }
                }
            )
        }
    }

    test("Stub names a sanitised channel by its FILE STEM, not its declared name - stub") {

        // RED before the fix: the stub applied NO sanitiser at all, so it touched
        // `HLA.DR.tiff` while the real split wrote `HLA_DR.tiff`. Two paths, two
        // filenames for one channel -- and `-stub` is the only mode CI's blocking
        // gate ever runs, so the divergence was invisible there.
        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        channels: ['DAPI', 'HLA.DR'],
                        is_reference: true
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    true
                ]
                """
            }
        }

        then {
            assert process.success
            with(process.out.channels) {
                def files = get(0).get(1)
                def fileList = (files instanceof List) ? files : [files]
                assert fileList.collect { file(it).name }.sort() == ['DAPI.tiff', 'HLA_DR.tiff']
            }
        }
    }

    test("Should pass declared channel names QUOTED, plus their file stems - rendered command") {

        // Tagged `stub` so CI's blocking gate collects it, deliberately WITHOUT
        // `options "-stub"`: a stub run never evaluates a `script:` block, so no
        // stub assertion can see a rendered command.
        //
        // Two defects pinned here, both invisible to every other case in this file:
        //
        //  1. `--channels ${meta.channels.join(' ')}` was UNQUOTED, so a marker named
        //     'CD3 alpha' reached argparse as the two channels 'CD3' and 'alpha' --
        //     silently shifting every subsequent channel's NAME onto the wrong pixels.
        //  2. The stems are now computed ONCE, in Groovy, and handed to the Python
        //     split. That is what makes the `script:` and `stub:` paths agree by
        //     construction rather than by two sanitisers happening to match.
        tag "stub"

        when {
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        channels: ['DAPI', 'HLA.DR', 'CD3 alpha']
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    true
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('split_multichannel.py')) {
                    rendered << f.text
                }
            }

            assertAll(
                { assert rendered.size() >= 1,
                    "no rendered SPLIT_CHANNELS .command.sh found under the task work dir" },
                { assert rendered.every { it.contains("--channels 'DAPI' 'HLA.DR' 'CD3 alpha'") },
                    "rendered command: " + rendered.join(' --- ') },
                { assert rendered.every { it.contains("--file-stems 'DAPI' 'HLA_DR' 'CD3_alpha'") },
                    "rendered command: " + rendered.join(' --- ') }
            )
        }
    }

    test("Should render --pixel-size from params - rendered command") {

        // Tagged `stub` so CI's blocking `nf-test test --tag stub` gate collects it, but
        // deliberately WITHOUT `options "-stub"`: `-stub` never evaluates a `script:`
        // block, so no stub run can observe a rendered command. Same shape and same
        // reasoning as tests/modules/generate_qc_report.nf.test's rendered-command case.
        //
        // What it pins: the per-channel TIFFs SPLIT_CHANNELS writes used to carry no
        // scale at all -- a bare imwrite, no resolution tags -- so MERGE_AND_PYRAMID had
        // nothing to read and params.pixel_size was taken on faith downstream with no way
        // to notice a disagreement. Dropping this flag would silently restore that, and
        // every stub assertion in this file would stay green through it.
        tag "stub"

        when {
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true),
                    true
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('split_multichannel.py')) {
                    rendered << f.text
                }
            }

            assertAll(
                { assert rendered.size() >= 1,
                    "no rendered SPLIT_CHANNELS .command.sh found under the task work dir" },
                // The value, not just the flag: `--pixel-size` rendered with an empty or
                // wrong value is the failure mode a presence-only check would miss, and
                // params.pixel_size is 0.325 in nextflow.config.
                { assert rendered.every { it.contains('--pixel-size 0.325') },
                    "rendered command: " + rendered.join(' --- ') }
            )
        }
    }
}
