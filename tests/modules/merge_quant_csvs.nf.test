nextflow_process {

    name "Test MERGE_QUANT_CSVS process"
    script "modules/local/merge_quant_csvs.nf"
    process "MERGE_QUANT_CSVS"

    tag "modules"
    tag "modules_local"
    tag "quantify"
    tag "merge_quant"

    test("Should merge multiple channel CSVs - stub") {

        tag "stub"
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [patient_id: 'P001', channels: ['DAPI', 'PANCK', 'SMA'], is_reference: true],
                    [
                        file('$projectDir/tests/testdata/sample_DAPI_intensity.csv', checkIfExists: true),
                        file('$projectDir/tests/testdata/sample_PANCK_intensity.csv', checkIfExists: true),
                        file('$projectDir/tests/testdata/sample_SMA_intensity.csv', checkIfExists: true)
                    ],
                    file('$projectDir/tests/testdata/sample_morphology.csv', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.merged_csv
            assert process.out.versions

            with(process.out.merged_csv) {
                assert size() == 1
                assert get(0).get(0).patient_id == 'P001'
                assert get(0).get(1).toString().endsWith('merged_quant.csv')
            }
        }
    }

    test("Should merge CSVs with all channel columns - real") {

        tag "real"

        when {
            process {
                """
                input[0] = [
                    [patient_id: 'P001', channels: ['DAPI', 'PANCK', 'SMA'], is_reference: true],
                    [
                        file('$projectDir/tests/testdata/sample_DAPI_intensity.csv', checkIfExists: true),
                        file('$projectDir/tests/testdata/sample_PANCK_intensity.csv', checkIfExists: true),
                        file('$projectDir/tests/testdata/sample_SMA_intensity.csv', checkIfExists: true)
                    ],
                    file('$projectDir/tests/testdata/sample_morphology.csv', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.merged_csv },
                // Validate merged CSV has exactly 20 data rows (matching morphology input)
                {
                    def csvFile = process.out.merged_csv.get(0).get(1)
                    def lines = path(csvFile).readLines()
                    assert lines.size() == 21, "Merged CSV should have 1 header + 20 data rows, got ${lines.size()}"
                },
                // Validate header contains morphology + intensity columns
                {
                    def csvFile = process.out.merged_csv.get(0).get(1)
                    def header = path(csvFile).readLines()[0].toLowerCase()
                    assert header.contains('fov'), "Merged CSV should have 'fov' column"
                    assert header.contains('cell_size'), "Merged CSV should have 'cell_size' column"
                    assert header.contains('label'), "Merged CSV should have 'label' column"
                    assert header.contains('dapi'), "Merged CSV should have 'DAPI' column"
                    assert header.contains('panck'), "Merged CSV should have 'PANCK' column"
                    assert header.contains('sma'), "Merged CSV should have 'SMA' column"
                },
                // Validate no empty values in first data row
                {
                    def csvFile = process.out.merged_csv.get(0).get(1)
                    def firstDataRow = path(csvFile).readLines()[1]
                    def values = firstDataRow.split(',')
                    values.each { val ->
                        assert val != null && val.trim() != '', "First data row should have no empty values, got: ${firstDataRow}"
                    }
                },
                // Metadata preserved
                { assert process.out.merged_csv.get(0).get(0).patient_id == 'P001' },
                { assert process.out.merged_csv.get(0).get(0).is_reference == true }
            )
        }
    }

    test("Should render the configured nuclear markers, not a hardcoded DAPI - rendered command") {

        // Tagged `stub` so CI's blocking `nf-test test --tag stub` gate runs it, but
        // deliberately WITHOUT `options "-stub"` -- same shape as
        // tests/modules/preprocess.nf.test's and seg_qc_geojson.nf.test's rendered-command
        // cases. `-stub` never evaluates a `script:` block, so no stub run can observe
        // what merge_quant_csvs.py is invoked with, and that invocation is what changed.
        //
        // Two behaviours in the merge depend on knowing which column is the fiducial:
        // it is protected from being overwritten on an add_cycle run, and it leads the
        // marker block. Both were pinned to the literal string "DAPI", so a CELLTOX
        // panel silently lost the protection and the ordering. A non-default marker
        // list is used here precisely so a regression to the literal cannot pass.
        tag "stub"

        when {
            params {
                nuclear_markers = ['CELLTOX']
            }
            process {
                """
                input[0] = [
                    [patient_id: 'P001', channels: ['CELLTOX', 'PANCK', 'SMA'], is_reference: true],
                    [
                        file('${projectDir}/tests/testdata/sample_DAPI_intensity.csv', checkIfExists: true),
                        file('${projectDir}/tests/testdata/sample_PANCK_intensity.csv', checkIfExists: true)
                    ],
                    file('${projectDir}/tests/testdata/sample_morphology.csv', checkIfExists: true)
                ]
                """
            }
        }

        then {
            // Nextflow lays tasks out as <workDir>/<2 hex>/<30 hex>/.command.sh.
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('merge_quant_csvs.py')) {
                    rendered << f.text
                }
            }

            assertAll(
                { assert rendered.size() >= 1,
                    "no rendered MERGE_QUANT_CSVS .command.sh found under the task work dir" },
                { assert rendered.every { it.contains('--nuclear-markers CELLTOX') },
                    "rendered command does not carry the configured marker: " + rendered.join(' --- ') },
                // The literal must not survive: params.nuclear_markers says CELLTOX only,
                // so a rendered 'DAPI' would mean the marker list was not consulted.
                { assert rendered.every { !(it =~ /--nuclear-markers[^\n]*DAPI/) },
                    "rendered command carries DAPI despite nuclear_markers=['CELLTOX']: " + rendered.join(' --- ') }
            )
        }
    }
}
