nextflow_process {
    name "Test REG_NONRIGID process"
    script "modules/local/reg_nonrigid.nf"
    process "REG_NONRIGID"
    tag "modules"; tag "modules_local"; tag "reg_nonrigid"
    test("REG_NONRIGID - stub") {
        options "-stub"
        when { process { """
            input[0] = [ 'P001', 'P001_mov1', file('$projectDir/tests/testdata', checkIfExists: true) ]
        """ } }
        then { assertAll(
            { assert process.success },
            { assert process.out.field },
            { assert process.out.versions } ) }
    }
}
