nextflow_process {

    name "Test GENERATE_REGISTRATION_QC process"
    script "modules/local/generate_registration_qc.nf"
    process "GENERATE_REGISTRATION_QC"

    tag "modules"
    tag "modules_local"
    tag "generate_registration_qc"

    test("Should generate QC images - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                qc_scale_factor = 0.25
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        is_reference: false,
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_mov2.ome.tiff', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.qc },
                { assert process.out.qc_fullres },
                { assert process.out.versions }
            )
        }
    }

    test("Should create both preview and fullres outputs - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                qc_scale_factor = 0.25
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        is_reference: false,
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_mov2.ome.tiff', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { with(process.out.qc) {
                    assert size() == 1
                    // Should create PNG or TIF preview
                    assert get(0).get(1).toString().contains('_QC_RGB')
                }},
                { with(process.out.qc_fullres) {
                    assert size() == 1
                    // Should create fullres TIF
                    assert get(0).get(1).toString().contains('_QC_RGB_fullres.tif')
                }}
            )
        }
    }

    test("Should preserve metadata - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                qc_scale_factor = 0.25
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P002',
                        is_reference: false,
                        channels: ['DAPI', 'PANCK'],
                        custom_field: 'test'
                    ],
                    file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_mov2.ome.tiff', checkIfExists: true),
                    file('$projectDir/tests/testdata/P002_ref.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { with(process.out.qc) {
                    assert get(0).get(0).patient_id == 'P002'
                    assert get(0).get(0).custom_field == 'test'
                }}
            )
        }
    }

    test("Should emit versions.yml - stub") {

        tag "stub"
        options "-stub"

        when {
            params {
                qc_scale_factor = 0.25
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        is_reference: false,
                        channels: ['DAPI', 'PANCK', 'SMA']
                    ],
                    file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_mov2.ome.tiff', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.versions },
                { assert snapshot(process.out.versions).match() }
            )
        }
    }

    test("Should generate QC images from real data") {

        tag "real"
        tag "slow"

        when {
            params {
                qc_scale_factor = 0.25
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        is_reference: false,
                        channels: ['DAPI', 'PANCK', 'SMA'],
                        pixel_size: 0.325
                    ],
                    file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_mov2.ome.tiff', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.qc },
                { assert process.out.qc_fullres },
                { assert process.out.versions },
                // `qc` is `path("qc/*_QC_RGB.{png,tif}")`, so slot 1 is a LIST of two
                // files, not one path -- flatten before wrapping. (`qc_fullres` matches a
                // single file and comes back as a bare String; `[x].flatten()` covers
                // both without the assertion having to know which.)
                { with(process.out.qc) {
                    assert size() == 1
                    def rendered = [get(0).get(1)].flatten().collect { file(it) }
                    assert rendered*.name.toSorted().collect { it.tokenize('.').last() } == ['png', 'tif']
                    assert rendered.every { it.size() > 100 }
                }},
                { with(process.out.qc_fullres) {
                    assert size() == 1
                    def rendered = [get(0).get(1)].flatten().collect { file(it) }
                    assert rendered.size() == 1
                    assert rendered.every { it.size() > 100 }
                }}
            )
        }
    }

    test("Should pass the configured nuclear markers to the QC script - rendered command") {

        // The teeth for the DAPI-hardcode fix in bin/utils/qc.py. That script used to pick
        // the overlay channel with `"DAPI" in ch.upper()`, and this process never passed
        // it params.nuclear_markers at all -- so the resolver could not be used even in
        // principle. It worked only because the literal test fell back to channel 0, which
        // CONVERT_IMAGE reserves for the nuclear channel; a CELLTOX panel got a warning on
        // every slide and would have picked the wrong channel had that invariant changed.
        //
        // Asserting the CELLTOX-first override (not just the shipped default) is what makes
        // this a real check: it proves the flag is built from params.nuclear_markers rather
        // than hardcoded to the default list.
        //
        // `stub` tag but NO `options "-stub"`: -stub never evaluates a script: block, so no
        // stub run can observe a rendered command. Same shape as
        // tests/modules/tiled_coarse.nf.test's rendered-command cases.
        tag "stub"

        when {
            params {
                qc_scale_factor = 0.25
                nuclear_markers = ['CELLTOX', 'DAPI']
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        is_reference: false,
                        channels: ['DAPI', 'PANCK', 'SMA'],
                        pixel_size: 0.325
                    ],
                    file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_mov2.ome.tiff', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('generate_registration_qc.py')) {
                    rendered << f.text
                }
            }

            assertAll(
                { assert rendered.size() >= 1,
                    "no rendered GENERATE_REGISTRATION_QC .command.sh found under the task work dir" },
                { assert rendered.every { it.contains('--nuclear-markers CELLTOX DAPI') },
                    "rendered command did not carry params.nuclear_markers: " + rendered.join(' --- ') },
                { assert rendered.every { it.contains('--pixel-size-um 0.325') },
                    "rendered command did not carry meta.pixel_size: " + rendered.join(' --- ') }
            )
        }
    }

    test("Should pass the native pre-registration image to the QC script - rendered command") {

        // The teeth for the before/after change. -stub NEVER evaluates a script:
        // block, so no stub run can observe that --native reaches the command line
        // -- the process could take the third input, ignore it, and every stub test
        // in this file would still pass. Same shape as the nuclear-markers case
        // above: `stub` tag so CI's blocking gate collects it, but NO
        // options "-stub", because stub mode would substitute away the very
        // command under assertion.
        //
        // P001_mov2 stands in for the native counterpart of P001_mov1. It has to be
        // a DIFFERENT file: `path(native_image, stageAs: 'native/*')` and
        // `path(registered)` would otherwise stage two entries under one basename.
        //
        // pixel_size is required here too: this is a real (non-stub) run, and the
        // module unconditionally renders `--pixel-size-um ${meta.pixel_size}`.
        tag "stub"

        when {
            params {
                qc_scale_factor = 0.25
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        is_reference: false,
                        channels: ['DAPI', 'PANCK', 'SMA'],
                        pixel_size: 0.325
                    ],
                    file('$projectDir/tests/testdata/P001_mov1.ome.tiff', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_mov2.ome.tiff', checkIfExists: true),
                    file('$projectDir/tests/testdata/P001_ref.ome.tiff', checkIfExists: true)
                ]
                """
            }
        }

        then {
            def rendered = []
            new File("$workDir").eachFileRecurse { f ->
                if (f.name == '.command.sh' && f.text.contains('generate_registration_qc.py')) {
                    rendered << f.text
                }
            }

            assertAll(
                { assert rendered.size() >= 1,
                    "no rendered GENERATE_REGISTRATION_QC .command.sh found under the task work dir" },
                { assert rendered.every { it.contains('--native native/P001_mov2.ome.tiff') },
                    "rendered command did not carry the native image: " + rendered.join(' --- ') },
                { assert rendered.every { it.contains('--registered P001_mov1.ome.tiff') },
                    "rendered command lost the registered image: " + rendered.join(' --- ') },
                { assert rendered.every { it.contains('--pixel-size-um 0.325') },
                    "rendered command did not carry meta.pixel_size: " + rendered.join(' --- ') }
            )
        }
    }
}
