nextflow_process {

    name "Test PIXIE_PIXEL_CLUSTER process"
    script "modules/local/pixie_pixel_cluster.nf"
    process "PIXIE_PIXEL_CLUSTER"

    tag "modules"
    tag "modules_local"
    tag "pixie_pixel_cluster"

    test("Should run pixel clustering - stub") {

        options "-stub"

        when {
            params {
                pixie_blur_factor    = 2
                pixie_subset_proportion = 0.1
                pixie_num_passes     = 1
                pixie_max_k          = 20
                pixie_cap            = 3
                pixie_seed           = 42
                pixie_batch_size     = 1
                pixie_target_fovs    = 10
                pixie_multiprocess   = false
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001'
                    ],
                    [
                        file('${projectDir}/tests/testdata/sample_DAPI.tif', checkIfExists: true),
                        file('${projectDir}/tests/testdata/sample_PANCK.tif', checkIfExists: true)
                    ],
                    file('${projectDir}/tests/testdata/P001_cell_mask.npy', checkIfExists: true)
                ]
                input[1] = ['DAPI', 'PANCK']
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.pixel_data },
                { assert process.out.som_weights },
                { assert process.out.cluster_profiles },
                { assert process.out.norm_vals },
                { assert process.out.cell_params },
                { assert process.out.versions }
            )
        }
    }

    test("Should preserve metadata - stub") {

        options "-stub"

        when {
            params {
                pixie_blur_factor    = 2
                pixie_subset_proportion = 0.1
                pixie_num_passes     = 1
                pixie_max_k          = 20
                pixie_cap            = 3
                pixie_seed           = 42
                pixie_batch_size     = 1
                pixie_target_fovs    = 10
                pixie_multiprocess   = false
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001',
                        custom_field: 'preserved'
                    ],
                    [
                        file('${projectDir}/tests/testdata/sample_DAPI.tif', checkIfExists: true),
                        file('${projectDir}/tests/testdata/sample_PANCK.tif', checkIfExists: true)
                    ],
                    file('${projectDir}/tests/testdata/P001_cell_mask.npy', checkIfExists: true)
                ]
                input[1] = ['DAPI', 'PANCK']
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { with(process.out.pixel_data) {
                    assert get(0).get(0).patient_id == 'P001'
                    assert get(0).get(0).custom_field == 'preserved'
                }}
            )
        }
    }

    test("Should emit versions.yml - stub") {

        options "-stub"

        when {
            params {
                pixie_blur_factor    = 2
                pixie_subset_proportion = 0.1
                pixie_num_passes     = 1
                pixie_max_k          = 20
                pixie_cap            = 3
                pixie_seed           = 42
                pixie_batch_size     = 1
                pixie_target_fovs    = 10
                pixie_multiprocess   = false
            }
            process {
                """
                input[0] = [
                    [
                        patient_id: 'P001'
                    ],
                    [
                        file('${projectDir}/tests/testdata/sample_DAPI.tif', checkIfExists: true),
                        file('${projectDir}/tests/testdata/sample_PANCK.tif', checkIfExists: true)
                    ],
                    file('${projectDir}/tests/testdata/P001_cell_mask.npy', checkIfExists: true)
                ]
                input[1] = ['DAPI', 'PANCK']
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.versions },
                { assert snapshot(process.out.versions).match() }
            )
        }
    }

    test("Should skip when ext.when is false") {

        options "-stub"

        when {
            params {
                pixie_blur_factor    = 2
                pixie_subset_proportion = 0.1
                pixie_num_passes     = 1
                pixie_max_k          = 20
                pixie_cap            = 3
                pixie_seed           = 42
                pixie_batch_size     = 1
                pixie_target_fovs    = 10
                pixie_multiprocess   = false
            }
            process {
                """
                task.ext.when = false

                input[0] = [
                    [
                        patient_id: 'P001'
                    ],
                    [
                        file('${projectDir}/tests/testdata/sample_DAPI.tif', checkIfExists: true),
                        file('${projectDir}/tests/testdata/sample_PANCK.tif', checkIfExists: true)
                    ],
                    file('${projectDir}/tests/testdata/P001_cell_mask.npy', checkIfExists: true)
                ]
                input[1] = ['DAPI', 'PANCK']
                """
            }
        }

        then {
            // Process should be skipped but not fail
            assert process.success
        }
    }
}
