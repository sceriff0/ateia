# Vendored libraries
valis_lib/*
pixie-main/*

# Python
*.pyc
**/__pycache__/
*.egg-info/
.eggs/
build/
dist/

# Coverage
.coverage
coverage.xml
htmlcov/

# Nextflow runtime
.nextflow/
.nextflow.log*
work/
results/
test_results*/
null/

# Testing
.nf-test/
.nf-test.log
# Validation run-logs are generated by tests/run_validation_tests.sh
tests/output/
# nf-test writes a scratch <hash>.nf per test into the repo ROOT (77 after one
# suite run) -- untracked noise that makes `git status` unreadable in a worktree
# where `git add -A` is already unsafe.
.nf-test-*.nf
.pytest_cache/

# Traces
traces/
.trace/

# Site-specific configs (secrets — never push to GitHub)
conf/ieo.config
conf/*_site.config

# Generated docs
site/

# Application
mirage_app/*

# Notebooks (analysis, not pipeline)
notebooks/*

# Benchmarking scratch (analysis venv + local eval outputs)
.venv-bench/
benchmarks/
illum_bench/

# macOS
*.DS_Store

# Internal AI/debug docs (not user-facing)
CLAUDE.md
DATAFLOW_ANALYSIS.md
MANUSCRIPT.md
.citadel
.planning
.claude

# Legacy (deprecated modules/docs)
legacy/

# IDE
.idea/
.vscode/

