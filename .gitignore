null/

# Testing
.nf-test/
.nf-test.log
# Validation run-logs are generated by tests/run_validation_tests.sh
tests/output/
# nf-test writes a scratch <hash>.nf per test into the repo ROOT (77 after one
# suite run) -- untracked noise that makes `git status` unreadable in a worktree
# where `git add -A` is already unsafe.
.nf-test-*.nf
.pytest_cache/

# Traces
traces/
.trace/

# Site-specific configs (secrets — never push to GitHub)
conf/ieo.config
conf/*_site.config

# Generated docs
site/

