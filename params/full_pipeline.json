{
    "_comment_io": "=== Input/Output ===",
    "input": "/path/to/samplesheet.csv",
    "outdir": "/path/to/results",
    "step": "preprocessing",

    "_comment_workflow": "=== Workflow Control ===",
    "dry_run": false,
    "debug_channels": false,
    "allow_auto_reference": false,

    "_comment_preproc": "=== Preprocessing ===",
    "preproc_tile_size": 1950,
    "preproc_skip_dapi": true,
    "preproc_autotune": false,
    "preproc_n_iter": 100,
    "preproc_pool_workers": 3,
    "preproc_overlap": 0,
    "preproc_no_darkfield": false,
    "preprocess_qc_scale_factor": 0.25,
    "pixel_size": 0.325,

    "_comment_reg_common": "=== Registration (Common) ===",
    "registration_method": "valis",
    "padding": false,
    "pad_mode": "constant",
    "skip_registration_qc": false,
    "qc_scale_factor": 0.25,
    "enable_feature_error": false,
    "feature_detector": "superpoint",
    "feature_max_dim": 1024,
    "feature_n_features": 5000,

    "_comment_reg_valis": "=== Registration (VALIS — default method) ===",
    "reg_reference_markers": ["DAPI", "FITC"],
    "memory_mode": "high",
    "reg_micro_reg_fraction": 0.125,
    "reg_max_image_dim": 4000,
    "skip_micro_registration": true,
    "reg_parallel_warping": false,
    "reg_n_workers": 8,
    "reg_use_tiled_registration": true,
    "reg_tile_size": 2048,

    "_comment_reg_gpu": "=== Registration (GPU Pairwise) ===",
    "gpu_reg_affine_crop_size": 10000,
    "gpu_reg_diffeo_crop_size": 2000,
    "gpu_reg_overlap_percent": 40.0,
    "gpu_reg_n_features": 5000,
    "gpu_reg_n_workers": 8,
    "gpu_reg_opt_tol": 1e-6,
    "gpu_reg_inv_tol": 1e-6,

    "_comment_reg_cpu": "=== Registration (CPU Pairwise/Tiled) ===",
    "cpu_reg_affine_crop_size": 10000,
    "cpu_reg_diffeo_crop_size": 2000,
    "cpu_reg_overlap_percent": 40.0,
    "cpu_reg_n_features": 5000,
    "cpu_reg_opt_tol": 1e-6,
    "cpu_reg_inv_tol": 1e-6,

    "_comment_seg": "=== Segmentation ===",
    "seg_gpu": true,
    "seg_pmin": 1.0,
    "seg_pmax": 99.8,
    "seg_n_tiles_y": 16,
    "seg_n_tiles_x": 16,
    "seg_expand_distance": 10,
    "segmentation_model_dir": null,
    "segmentation_model": "stardist_full_e200_lr00001_aug1_seed10_es50p0.001_rlr0.5p50",

    "_comment_quant": "=== Quantification ===",
    "quant_min_area": 10,

    "_comment_pheno": "=== Phenotyping ===",
    "phenotype_config": null,
    "pheno_quality_percentile": 1,
    "pheno_noise_percentile": 5,

    "_comment_pixie": "=== Pixie Clustering (Optional) ===",
    "pixie_enabled": false,
    "pixie_channels": ["CD45", "CD3", "CD4", "CD8", "FOXP3", "GZMB", "CD14", "CD163", "SMA", "PANCK", "VIMENTIN"],
    "pixie_blur_factor": 2,
    "pixie_subset_proportion": 0.05,
    "pixie_num_passes": 1,
    "pixie_max_k": 20,
    "pixie_cap": 3,
    "pixie_seed": 4,
    "pixie_pixel_cluster_col": "pixel_meta_cluster_rename",
    "pixie_target_fovs": 100,
    "pixie_multiprocess": false,
    "pixie_batch_size": 1,

    "_comment_output": "=== Image Output / Pyramid ===",
    "tilex": 512,
    "tiley": 512,
    "pyramid_resolutions": 8,
    "pyramid_scale": 2,
    "compression": "zstd",
    "publish_dir_mode": "copy",

    "_comment_resources": "=== Resource Limits ===",
    "max_memory": "700.GB",
    "max_cpus": 128,
    "max_time": "240.h",

    "_comment_trace": "=== Tracing ===",
    "enable_trace": true,
    "trace_dir": ".trace"
}
